APP_HOST=localhost
APP_PORT=3000

DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=ror_blog_development
DB_HOST=db
DB_PORT=5432
# Host-side runs (bin/dev, bin/rails): when set, it overrides DB_* for primary
# + solid_* DBs unless the overrides below are set. Use 127.0.0.1/localhost here.
# NOTE: Docker Compose never reads this value (see PROD_DATABASE_URL below); the
# compose stacks build their own URL against the `db` network alias instead.
# DATABASE_URL=postgres://user:password@127.0.0.1:5432/ror_blog_production
# CACHE_DATABASE_URL=
# QUEUE_DATABASE_URL=
# CABLE_DATABASE_URL=
# Docker Compose production ONLY: overrides the in-network URL for an external /
# managed Postgres. Leave it unset to use the compose db service. Constraints:
#   * the hostname must not contain "_" (Ruby's RFC2396 URI parser rejects it),
#   * the value must never be blank (Rails 8: "Database URL cannot be empty"),
#   * percent-encode special characters in the password (e.g. "@" -> %40).
# PROD_DATABASE_URL=postgres://user:password@db.example.com:5432/ror_blog_production
# PROD_REDIS_URL=redis://redis.example.com:6379/0
# PROD_ELASTICSEARCH_URL=https://search.example.com:9200

REDIS_URL=redis://redis:6379/0
ELASTICSEARCH_URL=http://elasticsearch:9200

# Production hardening
# APP_HOST=app.example.com          # required in production (no localhost default)
# ADDITIONAL_HOSTS=www.app.example.com
# Ngrok tip: APP_HOST must stay a concrete host
#   APP_HOST=2c4c-118-70-127-173.ngrok-free.app
# and allow all rotated ngrok prefixes with (pick ONE):
#   ADDITIONAL_HOSTS=/.*\.ngrok-free\.app/
#   ADDITIONAL_HOSTS=.ngrok-free.app
# FORCE_SSL=true
# APP_PROTOCOL=https
# RAILS_LOG_LEVEL=info
# RAILS_MAX_THREADS=5
# WEB_CONCURRENCY=1
# SOLID_QUEUE_IN_PUMA=false         # Active Job and scheduling use Sidekiq
# RAILS_MASTER_KEY=                # or provide config/master.key (never commit it)
# SECRET_KEY_BASE=                 # alternative to RAILS_MASTER_KEY

SMTP_ADDRESS=
SMTP_PORT=587
SMTP_DOMAIN=localhost
SMTP_USERNAME=
SMTP_PASSWORD=

# Generate values with: bin/rails db:encryption:init
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=

# Optional moderation overrides. When set, these ENV vars take precedence over
# the ModerationSetting row (admin UI); leave unset to manage via the admin UI.
AI_MODERATION_PROVIDER=mistral
AI_MODERATION_MODEL=mistral-small-latest
AI_MODERATION_TIMEOUT_SECONDS=30
AI_MODERATION_MAX_RETRIES=3
AI_MODERATION_ENABLED=true
# Provider API keys (deployment-wide default). A key saved in the admin UI
# (ModerationSetting#api_key, encrypted) is preferred over these, so keys can be
# rotated from the UI without redeploying. docker-compose.yml passes them to both
# the app and sidekiq containers.
# MISTRAL_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=

# AI Embedding Model Configuration (for RAG)
# Vector dimension for embeddings (default: 1536)
AI_EMBEDDING_DIM=1536

# Per-provider embedding models (optional overrides)
AI_EMBEDDING_MODEL_OPENAI=text-embedding-3-small
AI_EMBEDDING_MODEL_GEMINI=gemini-embedding-001
AI_EMBEDDING_MODEL_MISTRAL=mistral-embed-2312

# Embedding retry/backoff controls for provider rate limits
AI_EMBEDDING_RATE_LIMIT_RETRIES=6
AI_EMBEDDING_RATE_LIMIT_BASE_WAIT=2

# Assistant admission limits (accepted requests, including failed generations)
AI_CHAT_USER_HOURLY_LIMIT=20
AI_CHAT_USER_PENDING_LIMIT=2
AI_CHAT_DAILY_LIMIT=500
# Full reindexing is an explicit maintenance operation.
REINDEX_ON_BOOT=false
