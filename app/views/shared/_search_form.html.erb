<div class="mb-6">
  <%= form_tag posts_path, method: :get, class: 'w-full', data: { controller: 'search', 'search-url-value': posts_path, 'search-delay-value': 300 } do %>
    <div class="flex items-center w-full max-w-3xl mx-auto">
      <%= text_field_tag :q, params[:q], placeholder: 'Search posts by title, body, tags...', class: 'w-full h-10 px-4 rounded-full border shadow-sm text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500', data: { action: 'input->search#changed' } %>
    </div>
  <% end %>
</div>
