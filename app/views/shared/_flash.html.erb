<% if flash.any? %>
  <div data-controller="flash" data-flash-timeout-value="3000">
    <% flash.each do |key, msg| %>
      <% next if msg.blank? %>
      <% s = case key.to_sym
        when :notice then { wrap: "bg-emerald-50 border-emerald-200", text: "text-emerald-800", ring: "bg-emerald-100 text-emerald-600", d: "M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" }
        when :alert  then { wrap: "bg-amber-50 border-amber-200",   text: "text-amber-800",   ring: "bg-amber-100 text-amber-600",   d: "M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.008v.008H12v-.008Z" }
        else           { wrap: "bg-sky-50 border-sky-200",          text: "text-sky-800",     ring: "bg-sky-100 text-sky-600",       d: "m11.25 11.25.041-.02a.75.75 0 0 1 1.063.852l-.708 2.836a.75.75 0 0 0 1.063.853l.041-.021M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9-3.75h.008v.008H12V8.25Z" }
      end %>
      <%= render partial: 'shared/flash_message', locals: { key: key, msg: msg } %>
    <% end %>
  </div>
<% end %>
