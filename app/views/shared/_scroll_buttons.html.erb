<div data-controller="scroll-buttons" class="fixed right-4 bottom-6 z-50 flex flex-col gap-2 transition-opacity duration-200 opacity-0 pointer-events-none">
  <%# Ask AI FAB — visible on all pages. If @post is present, POST to its chat endpoint; otherwise link to the blog index for context. %>
  <% if user_signed_in? %>
    <% if defined?(@post) && @post %>
      <% fab_url = chat_post_path(@post) %>
      <div data-controller="ai-fab" data-ai-fab-url-value="<%= fab_url %>" class="flex items-center justify-center">
    <% else %>
      <div data-controller="ai-fab" class="flex items-center justify-center">
    <% end %>
      <button type="button" data-action="click->ai-fab#ask" aria-label="Ask AI" class="relative inline-flex items-center justify-center h-10 w-10 rounded-full bg-[#9e0000] text-white shadow-sm hover:bg-[#820000] focus:outline-none focus:ring-2 focus:ring-[#9e0000]/30">
        <span class="absolute inline-flex h-full w-full rounded-full bg-[#9e0000] opacity-30 animate-ping"></span>
        <svg xmlns="http://www.w3.org/2000/svg" class="relative h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M2 5a2 2 0 012-2h12a2 2 0 012 2v7a2 2 0 01-2 2h-4l-4 3v-3H4a2 2 0 01-2-2V5z"/></svg>
      </button>
    </div>
  <% else %>
    <div class="flex items-center justify-center">
      <%= link_to new_user_session_path, class: "inline-flex items-center gap-2 h-10 w-10 rounded-full border border-slate-200 bg-white text-slate-700 shadow-sm hover:bg-slate-50 justify-center" do %>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-slate-700" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M2 5a2 2 0 012-2h12a2 2 0 012 2v7a2 2 0 01-2 2h-4l-4 3v-3H4a2 2 0 01-2-2V5z"/></svg>
      <% end %>
    </div>
  <% end %>
  <button data-scroll-buttons-target="topBtn" data-action="click->scroll-buttons#scrollToTop" aria-label="Scroll to top" class="h-10 w-10 rounded-full bg-white border border-slate-200 shadow-md flex items-center justify-center hover:bg-slate-50">
    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-slate-700" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7"/></svg>
  </button>

  <button data-scroll-buttons-target="bottomBtn" data-action="click->scroll-buttons#scrollToBottom" aria-label="Scroll to bottom" class="h-10 w-10 rounded-full bg-white border border-slate-200 shadow-md flex items-center justify-center hover:bg-slate-50">
    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-slate-700" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
  </button>
</div>
