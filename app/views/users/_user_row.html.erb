<tr id="user_<%= user.id %>" class="<%= i.to_i.even? ? "bg-white" : "bg-slate-50/40" %> transition hover:bg-red-50/40">
  <td class="min-w-[240px] px-4 py-4">
    <div class="flex items-center gap-3">
      <div class="flex h-9 w-9 items-center justify-center rounded-full bg-slate-200 text-xs font-semibold uppercase text-slate-700">
        <%= (user.name.presence || user.email).to_s.first(2) %>
      </div>
      <div class="min-w-0 w-56">
        <p class="text-sm font-semibold text-slate-900 break-words" title="<%= h(user.name.to_s) %>"><%= h(user.name.to_s) %></p>
        <p class="text-xs text-slate-500">ID: <%= user.id %></p>
      </div>
    </div>
  </td>
  <td class="min-w-[280px] px-4 py-4 text-sm text-slate-600">
    <div class="min-w-0 w-80 break-words whitespace-normal" title="<%= h(user.email.to_s) %>"><%= h(user.email.to_s) %></div>
  </td>
  <td class="min-w-[110px] px-4 py-4 text-sm">
    <span class="inline-flex whitespace-nowrap rounded-full px-2.5 py-1 text-xs font-semibold <%= user.admin? ? "bg-amber-100 text-amber-700" : "bg-blue-100 text-blue-700" %>">
      <%= user.role %>
    </span>
  </td>
  <td class="min-w-[150px] px-4 py-4 text-sm text-slate-700">
    <% if user.banned? %>
      <span class="inline-flex whitespace-nowrap rounded-full bg-red-100 px-2.5 py-1 text-xs font-semibold text-red-700"><%= t("users.admin.index.status.banned") %></span>
    <% elsif user.suspended? %>
      <div>
          <% display_zone = user.suspended_time_zone.presence || Time.zone.name %>
          <% display_time = user.suspended_until.in_time_zone(display_zone) rescue user.suspended_until %>
          <div class="inline-flex flex-col items-start gap-1 max-w-xs">
            <div class="rounded-md bg-orange-100 px-3 py-1 text-sm font-semibold text-orange-700 whitespace-normal break-words">
              <%= t("users.admin.index.status.suspended_until", time: l(display_time, format: :short)) %>
            </div>
            <% if user.suspended_time_zone.present? %>
              <div class="text-xs text-slate-500 break-words"><%= user.suspended_time_zone %></div>
            <% end %>
          </div>
        </div>
    <% else %>
      <span class="inline-flex whitespace-nowrap rounded-full bg-emerald-100 px-2.5 py-1 text-xs font-semibold text-emerald-700"><%= t("users.admin.index.status.active") %></span>
    <% end %>
  </td>
  <td class="min-w-[220px] px-4 py-4 text-right">
    <% unless user.admin? %>
      <div class="grid grid-cols-2 gap-2">
        <% if user.banned? %>
          <%= button_to unban_user_path(user), method: :post, class: ui_action_button_classes(tone: :approve, full_width: true, size: :xs), form: { class: "w-full" } do %>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 shrink-0 text-emerald-500 transition group-hover:text-emerald-700" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-7.25 7.25a1 1 0 01-1.414 0l-3.25-3.25a1 1 0 111.414-1.414l2.543 2.543 6.543-6.543a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
            <span><%= t("users.admin.actions.unban") %></span>
          <% end %>
        <% else %>
          <button
            type="button"
            class="<%= ui_action_button_classes(tone: :reject, full_width: true, size: :xs) %>"
            data-action="click->suspend-form#openBan"
            data-suspend-form-url-param="<%= ban_user_path(user) %>"
            data-suspend-form-user-param="<%= user.name.presence || user.email %>">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 shrink-0 text-rose-500 transition group-hover:text-rose-700" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" /></svg>
            <span><%= t("users.admin.actions.ban") %></span>
          </button>
        <% end %>

        <% if user.suspended? %>
          <%= button_to unsuspend_user_path(user), method: :post, class: ui_action_button_classes(tone: :unsuspend, full_width: true, size: :xs), form: { class: "w-full" } do %>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 shrink-0 text-sky-500 transition group-hover:text-sky-700" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M10 2a1 1 0 011 1v1.07A7.001 7.001 0 0117 11a7 7 0 11-14 0 7.001 7.001 0 016-6.93V3a1 1 0 011-1zm-3 9a3 3 0 106 0 3 3 0 00-6 0z" /></svg>
            <span><%= t("users.admin.actions.unsuspend") %></span>
          <% end %>
        <% else %>
          <button
            type="button"
            class="<%= ui_action_button_classes(tone: :warning, full_width: true, size: :xs) %>"
            data-action="click->suspend-form#openSuspend"
            data-suspend-form-url-param="<%= suspend_user_path(user) %>"
            data-suspend-form-user-param="<%= user.name.presence || user.email %>">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 shrink-0 text-amber-500 transition group-hover:text-amber-700" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M10 2a1 1 0 01.894.553l6 12A1 1 0 0116 16H4a1 1 0 01-.894-1.447l6-12A1 1 0 0110 2zm0 4a1 1 0 00-1 1v3a1 1 0 102 0V7a1 1 0 00-1-1zm0 7a1.25 1.25 0 100-2.5A1.25 1.25 0 0010 13z" clip-rule="evenodd" /></svg>
            <span><%= t("users.admin.actions.suspend") %></span>
          </button>
        <% end %>
      </div>
    <% else %>
      <span class="inline-flex rounded-full border border-slate-200 bg-slate-100 px-2.5 py-1 text-xs font-medium text-slate-500"><%= t("users.admin.index.actions_unavailable") %></span>
    <% end %>
  </td>
</tr>
