<% active_count = @users.count { |u| !u.banned? && !u.suspended? } %>
<% suspended_count = @users.count(&:suspended?) %>
<% banned_count = @users.count(&:banned?) %>

<section class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8" data-controller="suspend-form" data-action="keydown.esc@window->suspend-form#close">
  <div class="rounded-3xl border border-slate-200/70 bg-gradient-to-br from-white via-slate-50 to-slate-100 p-6 shadow-sm sm:p-8">
    <div class="flex flex-wrap items-start justify-between gap-4">
      <div>
        <h1 class="text-3xl font-bold tracking-tight text-slate-900"><%= t("users.admin.index.title") %></h1>
        <p class="mt-2 max-w-2xl text-sm text-slate-600"><%= t("users.admin.index.subtitle") %></p>
      </div>
      <span class="inline-flex items-center rounded-full border border-slate-200 bg-white px-3 py-1 text-xs font-semibold text-slate-700 shadow-sm">
        <%= t("users.admin.index.total", count: @users.size) %>
      </span>
    </div>

    <div class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-4">
      <div class="rounded-xl border border-slate-200 bg-white p-3 shadow-sm">
        <p class="text-xs font-medium uppercase tracking-wide text-slate-500"><%= t("users.admin.index.total", count: @users.size) %></p>
        <p class="mt-1 text-2xl font-semibold text-slate-900"><%= @users.size %></p>
      </div>
      <div class="rounded-xl border border-emerald-200 bg-emerald-50 p-3 shadow-sm">
        <p class="text-xs font-medium uppercase tracking-wide text-emerald-700"><%= t("users.admin.index.status.active") %></p>
        <p class="mt-1 text-2xl font-semibold text-emerald-800"><%= active_count %></p>
      </div>
      <div class="rounded-xl border border-orange-200 bg-orange-50 p-3 shadow-sm">
        <p class="text-xs font-medium uppercase tracking-wide text-orange-700"><%= t("users.admin.actions.suspend") %></p>
        <p class="mt-1 text-2xl font-semibold text-orange-800"><%= suspended_count %></p>
      </div>
      <div class="rounded-xl border border-red-200 bg-red-50 p-3 shadow-sm">
        <p class="text-xs font-medium uppercase tracking-wide text-red-700"><%= t("users.admin.index.status.banned") %></p>
        <p class="mt-1 text-2xl font-semibold text-red-800"><%= banned_count %></p>
      </div>
    </div>
  </div>

  <div class="mt-6 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
    <div class="max-h-[70vh] overflow-auto">
      <table class="w-full divide-y divide-slate-200">
        <thead class="sticky top-0 z-10 bg-slate-50/95 backdrop-blur">
          <tr>
            <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500"><%= t("users.admin.index.columns.name") %></th>
            <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500"><%= t("users.admin.index.columns.email") %></th>
            <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500"><%= t("users.admin.index.columns.role") %></th>
            <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500"><%= t("users.admin.index.columns.status") %></th>
            <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wide text-slate-500"><%= t("users.admin.index.columns.actions") %></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 bg-white">
          <% @users.each_with_index do |user, i| %>
            <tr class="<%= i.even? ? "bg-white" : "bg-slate-50/40" %> transition hover:bg-indigo-50/40">
              <td class="px-4 py-4">
                <div class="flex items-center gap-3">
                  <div class="flex h-9 w-9 items-center justify-center rounded-full bg-slate-200 text-xs font-semibold uppercase text-slate-700">
                    <%= (user.name.presence || user.email).to_s.first(2) %>
                  </div>
                  <div>
                    <p class="text-sm font-semibold text-slate-900"><%= user.name %></p>
                    <p class="text-xs text-slate-500">ID: <%= user.id %></p>
                  </div>
                </div>
              </td>
              <td class="px-4 py-4 text-sm text-slate-600"><%= user.email %></td>
              <td class="px-4 py-4 text-sm">
                <span class="rounded-full px-2.5 py-1 text-xs font-semibold <%= user.admin? ? "bg-amber-100 text-amber-700" : "bg-blue-100 text-blue-700" %>">
                  <%= user.role %>
                </span>
              </td>
              <td class="px-4 py-4 text-sm text-slate-700">
                <% if user.banned? %>
                  <span class="rounded-full bg-red-100 px-2.5 py-1 text-xs font-semibold text-red-700"><%= t("users.admin.index.status.banned") %></span>
                <% elsif user.suspended? %>
                  <span class="rounded-full bg-orange-100 px-2.5 py-1 text-xs font-semibold text-orange-700"><%= t("users.admin.index.status.suspended_until", time: l(user.suspended_until, format: :short)) %></span>
                <% else %>
                  <span class="rounded-full bg-emerald-100 px-2.5 py-1 text-xs font-semibold text-emerald-700"><%= t("users.admin.index.status.active") %></span>
                <% end %>
              </td>
              <td class="px-4 py-4 text-right">
                <% unless user.admin? %>
                  <div class="flex flex-wrap justify-end gap-2">
                    <% if user.banned? %>
                      <%= button_to t("users.admin.actions.unban"), unban_user_path(user), method: :post, class: "rounded-lg border border-emerald-200 bg-emerald-50 px-3 py-1.5 text-xs font-semibold text-emerald-700 hover:bg-emerald-100" %>
                    <% else %>
                      <button
                        type="button"
                        class="rounded-lg border border-red-200 bg-red-50 px-3 py-1.5 text-xs font-semibold text-red-700 hover:bg-red-100"
                        data-action="click->suspend-form#openBan"
                        data-suspend-form-url-param="<%= ban_user_path(user) %>"
                        data-suspend-form-user-param="<%= user.name.presence || user.email %>">
                        <%= t("users.admin.actions.ban") %>
                      </button>
                    <% end %>

                    <% if user.suspended? %>
                      <%= button_to t("users.admin.actions.unsuspend"), unsuspend_user_path(user), method: :post, class: "rounded-lg border border-sky-200 bg-sky-50 px-3 py-1.5 text-xs font-semibold text-sky-700 hover:bg-sky-100" %>
                    <% else %>
                      <button
                        type="button"
                        class="rounded-lg border border-amber-200 bg-amber-50 px-3 py-1.5 text-xs font-semibold text-amber-700 hover:bg-amber-100"
                        data-action="click->suspend-form#openSuspend"
                        data-suspend-form-url-param="<%= suspend_user_path(user) %>"
                        data-suspend-form-user-param="<%= user.name.presence || user.email %>">
                        <%= t("users.admin.actions.suspend") %>
                      </button>
                    <% end %>
                  </div>
                <% else %>
                  <span class="inline-flex rounded-full border border-slate-200 bg-slate-100 px-2.5 py-1 text-xs font-medium text-slate-500"><%= t("users.admin.index.actions_unavailable") %></span>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <div class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-900/50 p-4" data-suspend-form-target="suspendModal" data-action="click->suspend-form#backdropCloseSuspend">
    <div class="w-full max-w-md rounded-2xl border border-slate-200 bg-white p-6 shadow-2xl" role="dialog" aria-modal="true" aria-labelledby="suspend-modal-title">
      <div class="mb-4 flex items-start justify-between gap-3">
        <div>
          <h2 id="suspend-modal-title" class="text-lg font-semibold text-slate-900"><%= t("users.admin.modal.title") %></h2>
          <p class="mt-1 text-sm text-slate-500" data-suspend-form-target="suspendUserLabel"></p>
        </div>
        <button type="button" class="rounded-md p-1.5 text-slate-500 hover:bg-slate-100 hover:text-slate-700" data-action="click->suspend-form#close" aria-label="<%= t("users.admin.modal.close") %>">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" />
          </svg>
        </button>
      </div>

      <%= form_with url: "#", method: :post, local: true, html: { data: { suspend_form_target: "suspendForm" }, class: "space-y-4" } do |form| %>
        <div>
          <%= form.label :suspended_until, t("users.admin.modal.until"), class: "mb-1.5 block text-sm font-medium text-slate-700" %>
          <%= form.datetime_local_field :suspended_until, min: Time.current.strftime("%Y-%m-%dT%H:%M"), class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-sm text-slate-700", data: { suspend_form_target: "suspendInput" } %>
        </div>
        <div class="flex items-center justify-end gap-2">
          <button type="button" class="rounded-lg border border-slate-300 px-3 py-2 text-sm font-medium text-slate-600 hover:bg-slate-50" data-action="click->suspend-form#close"><%= t("users.admin.modal.cancel") %></button>
          <%= form.submit t("users.admin.actions.confirm_suspend"), class: "rounded-lg bg-slate-900 px-3 py-2 text-sm font-semibold text-white hover:bg-slate-800" %>
        </div>
      <% end %>
    </div>
  </div>

  <div class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-900/50 p-4" data-suspend-form-target="banModal" data-action="click->suspend-form#backdropCloseBan">
    <div class="w-full max-w-md rounded-2xl border border-red-100 bg-white p-6 shadow-2xl" role="dialog" aria-modal="true" aria-labelledby="ban-modal-title">
      <div class="mb-4 flex items-start justify-between gap-3">
        <div>
          <h2 id="ban-modal-title" class="text-lg font-semibold text-slate-900"><%= t("users.admin.modal.ban_title") %></h2>
          <p class="mt-1 text-sm text-slate-500" data-suspend-form-target="banUserLabel"></p>
        </div>
        <button type="button" class="rounded-md p-1.5 text-slate-500 hover:bg-slate-100 hover:text-slate-700" data-action="click->suspend-form#close" aria-label="<%= t("users.admin.modal.close") %>">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" />
          </svg>
        </button>
      </div>

      <p class="rounded-lg border border-red-100 bg-red-50 px-3 py-2 text-sm text-red-700"><%= t("users.admin.modal.ban_message") %></p>

      <%= form_with url: "#", method: :post, local: true, html: { data: { suspend_form_target: "banForm" }, class: "mt-4 flex items-center justify-end gap-2" } do |form| %>
        <button type="button" class="rounded-lg border border-slate-300 px-3 py-2 text-sm font-medium text-slate-600 hover:bg-slate-50" data-action="click->suspend-form#close"><%= t("users.admin.modal.cancel") %></button>
        <%= form.submit t("users.admin.modal.confirm_ban"), class: "rounded-lg bg-red-600 px-3 py-2 text-sm font-semibold text-white hover:bg-red-700" %>
      <% end %>
    </div>
  </div>
</section>
