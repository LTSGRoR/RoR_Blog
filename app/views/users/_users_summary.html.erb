<div id="users_summary" class="overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-sm">
  <div class="h-1.5 bg-gradient-to-r from-[#9e0000] via-[#cc0000] to-[#820000]"></div>
  <div class="bg-[radial-gradient(circle_at_top_left,rgba(255,0,0,0.08),transparent_34%),linear-gradient(180deg,#fff8f8_0%,#f8fafc_68%,#f8fafc_100%)] p-6 sm:p-8">
    <div class="flex flex-wrap items-start justify-between gap-4">
      <div>
        <h1 class="text-3xl font-bold tracking-tight text-slate-900"><%= t("users.admin.index.title") %></h1>
        <p class="mt-2 max-w-2xl text-sm text-slate-600"><%= t("users.admin.index.subtitle") %></p>
      </div>
    </div>

    <div class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-4">
      <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm ring-1 ring-slate-100">
        <p class="text-xs font-medium uppercase tracking-[0.18em] text-slate-500"><%= t("users.admin.index.total") %></p>
        <p class="mt-2 text-2xl font-semibold text-slate-900"><%= total_count %></p>
      </div>
      <div class="rounded-2xl border border-emerald-200 bg-emerald-50 p-4 shadow-sm ring-1 ring-emerald-100">
        <p class="text-xs font-medium uppercase tracking-[0.18em] text-emerald-700"><%= t("users.admin.index.status.active") %></p>
        <p class="mt-2 text-2xl font-semibold text-emerald-800"><%= active_count %></p>
      </div>
      <div class="rounded-2xl border border-orange-200 bg-orange-50 p-4 shadow-sm ring-1 ring-orange-100">
        <p class="text-xs font-medium uppercase tracking-[0.18em] text-orange-700"><%= t("users.admin.actions.suspend") %></p>
        <p class="mt-2 text-2xl font-semibold text-orange-800"><%= suspended_count %></p>
      </div>
      <div class="rounded-2xl border border-red-200 bg-red-50 p-4 shadow-sm ring-1 ring-red-100">
        <p class="text-xs font-medium uppercase tracking-[0.18em] text-red-700"><%= t("users.admin.index.status.banned") %></p>
        <p class="mt-2 text-2xl font-semibold text-red-800"><%= banned_count %></p>
      </div>
    </div>
  </div>
</div>
