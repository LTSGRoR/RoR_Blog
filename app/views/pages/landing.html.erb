<% content_for :title, t("pages.landing.title") %>

<main id="top">
  <section class="hero-pattern overflow-hidden border-b border-[#e2e8f0] py-20">
    <div class="re-shell grid items-center gap-10 lg:grid-cols-2">
      <div class="space-y-6">
        <div class="inline-flex items-center gap-2 rounded-full bg-red-100 px-3 py-1 text-xs font-medium text-[#9e0000] re-label">
          <span><%= t("pages.landing.hero.badge") %></span>
        </div>
        <h1 class="re-heading text-5xl font-extrabold leading-tight text-slate-900 sm:text-6xl"><%= t("pages.landing.hero.title") %></h1>
        <p class="max-w-xl text-xl leading-8 text-[#545f73]"><%= t("pages.landing.hero.body") %></p>
        <div class="flex flex-wrap gap-3 pt-2">
          <%= btn_link_to t("pages.landing.hero.cta_primary"), root_path(anchor: "services"), variant: :primary, class: "px-6" %>
          <%= btn_link_to t("pages.landing.hero.cta_blog"), blog_path, variant: :secondary, class: "px-6" %>
        </div>
      </div>
      <div class="relative">
        <div class="aspect-[4/3] overflow-hidden rounded-xl border border-[#e2e8f0] shadow-xl">
          <img src="https://images.unsplash.com/photo-1515879218367-8466d910aaa4?auto=format&fit=crop&w=1200&q=80" alt="<%= t("pages.landing.hero.image_alt") %>" class="h-full w-full object-cover" />
        </div>
        <div class="glass-card absolute -bottom-6 -left-6 hidden max-w-xs rounded-xl border border-[#e2e8f0] p-5 shadow-xl md:block">
          <p class="re-label text-xs font-semibold tracking-wide text-[#9e0000]"><%= t("pages.landing.hero.glass_label") %></p>
          <p class="mt-2 text-sm text-slate-700"><%= t("pages.landing.hero.glass_body") %></p>
        </div>
      </div>
    </div>
  </section>

  <section id="services" class="bg-[#f7f9fb] py-20">
    <div class="re-shell">
      <div class="mb-10">
        <h2 class="re-heading text-4xl font-bold text-slate-900"><%= t("pages.landing.services.title") %></h2>
        <p class="mt-2 text-lg text-[#545f73]"><%= t("pages.landing.services.subtitle") %></p>
      </div>

      <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
        <article class="md:col-span-2 re-card group flex flex-col gap-6 p-6 md:flex-row">
          <div class="flex-1 space-y-4">
            <h3 class="re-heading text-2xl font-semibold"><%= t("pages.landing.services.architecture.title") %></h3>
            <p class="text-[#545f73]"><%= t("pages.landing.services.architecture.body") %></p>
            <ul class="space-y-2 text-sm text-slate-700">
              <li><%= t("pages.landing.services.architecture.item_1") %></li>
              <li><%= t("pages.landing.services.architecture.item_2") %></li>
            </ul>
          </div>
          <div class="min-h-[220px] flex-1 overflow-hidden rounded-lg border border-[#e2e8f0]">
            <img src="https://images.unsplash.com/photo-1558494949-ef010cbdcc31?auto=format&fit=crop&w=1200&q=80" alt="<%= t("pages.landing.services.architecture.image_alt") %>" class="h-full w-full object-cover transition duration-500 group-hover:scale-105" />
          </div>
        </article>

        <article class="re-card flex flex-col justify-between p-6">
          <div class="space-y-3">
            <h3 class="re-heading text-2xl font-semibold"><%= t("pages.landing.services.security.title") %></h3>
            <p class="text-[#545f73]"><%= t("pages.landing.services.security.body") %></p>
          </div>
          <%= link_to t("pages.landing.services.learn_more"), root_path(anchor: "services"), class: "mt-4 re-label text-sm font-semibold text-[#9e0000] hover:text-[#820000]" %>
        </article>

        <article class="re-card flex flex-col justify-between p-6">
          <div class="space-y-3">
            <h3 class="re-heading text-2xl font-semibold"><%= t("pages.landing.services.performance.title") %></h3>
            <p class="text-[#545f73]"><%= t("pages.landing.services.performance.body") %></p>
          </div>
          <%= link_to t("pages.landing.services.learn_more"), root_path(anchor: "services"), class: "mt-4 re-label text-sm font-semibold text-[#9e0000] hover:text-[#820000]" %>
        </article>

        <article class="md:col-span-2 re-card group flex flex-col gap-6 p-6 md:flex-row-reverse">
          <div class="flex-1 space-y-4">
            <h3 class="re-heading text-2xl font-semibold"><%= t("pages.landing.services.consulting.title") %></h3>
            <p class="text-[#545f73]"><%= t("pages.landing.services.consulting.body") %></p>
            <div class="flex flex-wrap gap-2">
              <span class="re-chip">Ruby 3.3</span>
              <span class="re-chip">Rails 8</span>
              <span class="re-chip">Turbo</span>
            </div>
          </div>
          <div class="min-h-[220px] flex-1 overflow-hidden rounded-lg border border-[#e2e8f0]">
            <img src="https://images.unsplash.com/photo-1552664730-d307ca884978?auto=format&fit=crop&w=1200&q=80" alt="<%= t("pages.landing.services.consulting.image_alt") %>" class="h-full w-full object-cover transition duration-500 group-hover:scale-105" />
          </div>
        </article>
      </div>
    </div>
  </section>

  <section id="insights" class="py-20">
    <div class="re-shell">
      <div class="mb-10 flex flex-wrap items-end justify-between gap-3">
        <div>
          <h2 class="re-heading text-4xl font-bold text-slate-900"><%= t("pages.landing.insights.title") %></h2>
          <p class="mt-2 text-lg text-[#545f73]"><%= t("pages.landing.insights.subtitle") %></p>
        </div>
        <%= link_to t("pages.landing.insights.view_all"), blog_path, class: "re-label text-sm font-semibold text-[#9e0000] hover:text-[#820000]" %>
      </div>

      <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
        <% if @featured_posts.any? %>
          <% @featured_posts.each do |post| %>
            <article class="group flex gap-4">
              <div class="h-44 w-44 shrink-0 overflow-hidden rounded-lg border border-[#e2e8f0]">
                <% if post.user&.avatar&.attached? %>
                  <%= image_tag post.user.avatar.variant(resize_to_fill: [176, 176]), class: "h-full w-full object-cover transition duration-500 group-hover:scale-105", alt: post.user.name.presence || post.user.email %>
                <% else %>
                  <img src="https://images.unsplash.com/photo-1461749280684-dccba630e2f6?auto=format&fit=crop&w=500&q=80" alt="Featured engineering article" class="h-full w-full object-cover transition duration-500 group-hover:scale-105" />
                <% end %>
              </div>
              <div class="space-y-2">
                <div class="flex flex-wrap gap-2">
                  <% post.tags.limit(2).each do |tag| %>
                    <span class="re-chip">#<%= tag.name %></span>
                  <% end %>
                </div>
                <h3 class="re-heading text-2xl font-semibold leading-tight text-slate-900 transition group-hover:text-[#9e0000]"><%= link_to post.title, post_path(post) %></h3>
                <p class="text-[#545f73]"><%= truncate(post.body.to_plain_text, length: 130) %></p>
                <p class="re-label text-xs text-slate-500"><%= post.user&.name.presence || post.user&.email %> • <%= localized_time_tag(post.created_at) %></p>
              </div>
            </article>
          <% end %>
        <% else %>
          <article class="re-card p-6">
            <h3 class="re-heading text-2xl font-semibold"><%= t("pages.landing.insights.fallback_1.title") %></h3>
            <p class="mt-3 text-[#545f73]"><%= t("pages.landing.insights.fallback_1.body") %></p>
          </article>
          <article class="re-card p-6">
            <h3 class="re-heading text-2xl font-semibold"><%= t("pages.landing.insights.fallback_2.title") %></h3>
            <p class="mt-3 text-[#545f73]"><%= t("pages.landing.insights.fallback_2.body") %></p>
          </article>
        <% end %>
      </div>
    </div>
  </section>

  <section id="team" class="bg-[#f1f5f9] py-20">
    <div class="re-shell text-center">
      <h2 class="re-heading text-4xl font-bold text-slate-900"><%= t("pages.landing.team.title") %></h2>
      <p class="mx-auto mt-2 max-w-2xl text-lg text-[#545f73]"><%= t("pages.landing.team.body") %></p>
      <div class="mt-10 flex flex-wrap justify-center gap-8">
        <% if @team_members.any? %>
          <% @team_members.each do |member| %>
            <div class="text-center">
              <div class="mx-auto mb-3 h-28 w-28 overflow-hidden rounded-full border-4 border-white shadow-lg">
                <% if member.avatar.attached? %>
                  <%= image_tag member.avatar.variant(resize_to_fill: [112, 112]), class: "h-full w-full object-cover", alt: (member.name.presence || member.email) %>
                <% else %>
                  <img src="https://images.unsplash.com/photo-1560250097-0b93528c311a?auto=format&fit=crop&w=300&q=80" alt="<%= t("pages.landing.team.member_alt") %>" class="h-full w-full object-cover" />
                <% end %>
              </div>
              <h4 class="re-heading text-xl font-semibold"><%= member.name.presence || member.email %></h4>
              <p class="re-label text-xs text-slate-500"><%= member.role.titleize %></p>
            </div>
          <% end %>
        <% else %>
          <div class="text-center">
            <div class="mx-auto mb-3 h-28 w-28 overflow-hidden rounded-full border-4 border-white shadow-lg">
              <img src="https://images.unsplash.com/photo-1560250097-0b93528c311a?auto=format&fit=crop&w=300&q=80" alt="<%= t("pages.landing.team.fallback_alt") %>" class="h-full w-full object-cover" />
            </div>
            <h4 class="re-heading text-xl font-semibold"><%= t("pages.landing.team.fallback_name") %></h4>
            <p class="re-label text-xs text-slate-500"><%= t("pages.landing.team.fallback_role") %></p>
          </div>
        <% end %>
      </div>
      <div class="mt-8">
        <%= btn_link_to t("pages.landing.team.cta"), team_path, variant: :secondary %>
      </div>
    </div>
  </section>

  <section id="cta" class="bg-[#191c1e] py-20 text-white">
    <div class="re-shell flex flex-col items-center justify-between gap-8 md:flex-row">
      <div class="max-w-2xl text-center md:text-left">
        <h2 class="re-heading text-5xl font-bold"><%= t("pages.landing.cta.title") %></h2>
        <p class="mt-3 text-lg text-slate-300"><%= t("pages.landing.cta.body") %></p>
      </div>
      <%= btn_link_to t("pages.landing.cta.button"), team_path, variant: :primary, class: "px-8" %>
    </div>
  </section>

  <footer id="footer" class="border-t border-[#e2e8f0] bg-white py-10">
    <div class="re-shell flex flex-col items-start justify-between gap-8 md:flex-row md:items-center">
      <div>
        <p class="re-heading text-2xl font-bold text-slate-900"><%= t("brand.name") %></p>
        <p class="mt-1 text-[#545f73]"><%= t("pages.landing.footer.tagline") %></p>
      </div>
      <nav class="flex flex-wrap gap-4 re-label text-xs text-slate-500">
        <%= link_to t("pages.landing.footer.nav.architecture"), root_path(anchor: "services"), class: "hover:text-[#9e0000]" %>
        <%= link_to t("pages.landing.footer.nav.security"), root_path(anchor: "services"), class: "hover:text-[#9e0000]" %>
        <%= link_to t("pages.landing.footer.nav.careers"), team_path, class: "hover:text-[#9e0000]" %>
        <%= link_to t("pages.landing.footer.nav.privacy"), root_path(anchor: "footer"), class: "hover:text-[#9e0000]" %>
        <%= link_to t("pages.landing.footer.nav.rss"), blog_path, class: "hover:text-[#9e0000]" %>
      </nav>
    </div>

    <div class="re-shell mt-8 flex flex-col items-center justify-between gap-4 border-t border-[#e2e8f0] pt-6 text-sm text-slate-500 md:flex-row">
      <p><%= t("pages.landing.footer.copyright") %></p>
      <div class="flex gap-2">
        <%= link_to "O", root_path(anchor: "top"), class: "inline-flex h-9 w-9 items-center justify-center rounded-full border border-[#e2e8f0] text-slate-500 hover:text-[#9e0000]" %>
        <%= link_to ">_", blog_path, class: "inline-flex h-9 w-9 items-center justify-center rounded-full border border-[#e2e8f0] text-slate-500 hover:text-[#9e0000]" %>
      </div>
    </div>
  </footer>
</main>
