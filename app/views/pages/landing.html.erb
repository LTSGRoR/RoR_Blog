<% content_for :title, "Rails Engineering | Excellence in Ruby on Rails" %>

<main>
  <section class="hero-pattern overflow-hidden border-b border-[#e2e8f0] py-20">
    <div class="re-shell grid items-center gap-10 lg:grid-cols-2">
      <div class="space-y-6">
        <div class="inline-flex items-center gap-2 rounded-full bg-red-100 px-3 py-1 text-xs font-medium text-[#9e0000] re-label">
          <span>RAILS 8 READY</span>
        </div>
        <h1 class="re-heading text-5xl font-extrabold leading-tight text-slate-900 sm:text-6xl">Engineering Excellence with Ruby on Rails</h1>
        <p class="max-w-xl text-xl leading-8 text-[#545f73]">We build robust, scalable, and secure web applications using the most productive framework in the world. Our department is dedicated to technical rigor and community contribution.</p>
        <div class="flex flex-wrap gap-3 pt-2">
          <%= btn_link_to "Start Your Project", "#", variant: :primary, class: "px-6" %>
          <%= btn_link_to "Read the Blog", blog_path, variant: :secondary, class: "px-6" %>
        </div>
      </div>
      <div class="relative">
        <div class="aspect-[4/3] overflow-hidden rounded-xl border border-[#e2e8f0] shadow-xl">
          <img src="https://images.unsplash.com/photo-1515879218367-8466d910aaa4?auto=format&fit=crop&w=1200&q=80" alt="Engineering workspace with Ruby on Rails code on monitors" class="h-full w-full object-cover" />
        </div>
        <div class="glass-card absolute -bottom-6 -left-6 hidden max-w-xs rounded-xl border border-[#e2e8f0] p-5 shadow-xl md:block">
          <p class="re-label text-xs font-semibold tracking-wide text-[#9e0000]">HOTWIRE MASTERED</p>
          <p class="mt-2 text-sm text-slate-700">Delivering SPA-like experiences with zero complex JavaScript overhead.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-[#f7f9fb] py-20">
    <div class="re-shell">
      <div class="mb-10">
        <h2 class="re-heading text-4xl font-bold text-slate-900">Specialized Core Services</h2>
        <p class="mt-2 text-lg text-[#545f73]">Built on a decade of experience in the Rails ecosystem.</p>
      </div>

      <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
        <article class="md:col-span-2 re-card group flex flex-col gap-6 p-6 md:flex-row">
          <div class="flex-1 space-y-4">
            <h3 class="re-heading text-2xl font-semibold">Architecture &amp; Scalability</h3>
            <p class="text-[#545f73]">We design monoliths that scale. From database optimization to background processing with Sidekiq, we ensure your Rails app handles millions of requests with ease.</p>
            <ul class="space-y-2 text-sm text-slate-700">
              <li>Multi-tenant Design</li>
              <li>Redis &amp; Caching Layers</li>
            </ul>
          </div>
          <div class="min-h-[220px] flex-1 overflow-hidden rounded-lg border border-[#e2e8f0]">
            <img src="https://images.unsplash.com/photo-1558494949-ef010cbdcc31?auto=format&fit=crop&w=1200&q=80" alt="Server infrastructure" class="h-full w-full object-cover transition duration-500 group-hover:scale-105" />
          </div>
        </article>

        <article class="re-card flex flex-col justify-between p-6">
          <div class="space-y-3">
            <h3 class="re-heading text-2xl font-semibold">Hardened Security</h3>
            <p class="text-[#545f73]">Compliance and safety are baked into every line of code. We perform thorough audits and implement best-in-class authentication.</p>
          </div>
          <a href="#" class="mt-4 re-label text-sm font-semibold text-[#9e0000] hover:text-[#820000]">Learn more</a>
        </article>

        <article class="re-card flex flex-col justify-between p-6">
          <div class="space-y-3">
            <h3 class="re-heading text-2xl font-semibold">Performance</h3>
            <p class="text-[#545f73]">N+1 query elimination and front-end optimization. We make sure your Rails app is blazing fast for every user.</p>
          </div>
          <a href="#" class="mt-4 re-label text-sm font-semibold text-[#9e0000] hover:text-[#820000]">Learn more</a>
        </article>

        <article class="md:col-span-2 re-card group flex flex-col gap-6 p-6 md:flex-row-reverse">
          <div class="flex-1 space-y-4">
            <h3 class="re-heading text-2xl font-semibold">Technical Consulting</h3>
            <p class="text-[#545f73]">Need to modernize a legacy Rails app? Our experts provide the roadmap and execution for seamless upgrades and refactors.</p>
            <div class="flex flex-wrap gap-2">
              <span class="re-chip">Ruby 3.3</span>
              <span class="re-chip">Rails 8</span>
              <span class="re-chip">Turbo</span>
            </div>
          </div>
          <div class="min-h-[220px] flex-1 overflow-hidden rounded-lg border border-[#e2e8f0]">
            <img src="https://images.unsplash.com/photo-1552664730-d307ca884978?auto=format&fit=crop&w=1200&q=80" alt="Engineering consulting session" class="h-full w-full object-cover transition duration-500 group-hover:scale-105" />
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="py-20">
    <div class="re-shell">
      <div class="mb-10 flex flex-wrap items-end justify-between gap-3">
        <div>
          <h2 class="re-heading text-4xl font-bold text-slate-900">Featured Technical Insights</h2>
          <p class="mt-2 text-lg text-[#545f73]">Deep dives into the Ruby on Rails ecosystem.</p>
        </div>
        <%= link_to "View all posts", blog_path, class: "re-label text-sm font-semibold text-[#9e0000] hover:text-[#820000]" %>
      </div>

      <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
        <% if @featured_posts.any? %>
          <% @featured_posts.each do |post| %>
            <article class="group flex gap-4">
              <div class="h-44 w-44 shrink-0 overflow-hidden rounded-lg border border-[#e2e8f0]">
                <% if post.user&.avatar&.attached? %>
                  <%= image_tag post.user.avatar.variant(resize_to_fill: [176, 176]), class: "h-full w-full object-cover transition duration-500 group-hover:scale-105", alt: post.user.name.presence || post.user.email %>
                <% else %>
                  <img src="https://images.unsplash.com/photo-1461749280684-dccba630e2f6?auto=format&fit=crop&w=500&q=80" alt="Featured engineering article" class="h-full w-full object-cover transition duration-500 group-hover:scale-105" />
                <% end %>
              </div>
              <div class="space-y-2">
                <div class="flex flex-wrap gap-2">
                  <% post.tags.limit(2).each do |tag| %>
                    <span class="re-chip">#<%= tag.name %></span>
                  <% end %>
                </div>
                <h3 class="re-heading text-2xl font-semibold leading-tight text-slate-900 transition group-hover:text-[#9e0000]"><%= link_to post.title, post_path(post) %></h3>
                <p class="text-[#545f73]"><%= truncate(post.body.to_plain_text, length: 130) %></p>
                <p class="re-label text-xs text-slate-500"><%= post.user&.name.presence || post.user&.email %> • <%= l(post.created_at, format: :short) %></p>
              </div>
            </article>
          <% end %>
        <% else %>
          <article class="re-card p-6">
            <h3 class="re-heading text-2xl font-semibold">Understanding Warden in Rails</h3>
            <p class="mt-3 text-[#545f73]">Deep dive into authentication middleware and security strategy in modern Rails applications.</p>
          </article>
          <article class="re-card p-6">
            <h3 class="re-heading text-2xl font-semibold">Getting Started with Hotwire</h3>
            <p class="mt-3 text-[#545f73]">Build interactive experiences with Turbo and Stimulus while keeping your Rails architecture simple.</p>
          </article>
        <% end %>
      </div>
    </div>
  </section>

  <section class="bg-[#f1f5f9] py-20">
    <div class="re-shell text-center">
      <h2 class="re-heading text-4xl font-bold text-slate-900">The Minds Behind the Code</h2>
      <p class="mx-auto mt-2 max-w-2xl text-lg text-[#545f73]">Our team consists of senior developers, open-source contributors, and industry experts dedicated to the Rails community.</p>
      <div class="mt-10 flex flex-wrap justify-center gap-8">
        <% if @team_members.any? %>
          <% @team_members.each do |member| %>
            <div class="text-center">
              <div class="mx-auto mb-3 h-28 w-28 overflow-hidden rounded-full border-4 border-white shadow-lg">
                <% if member.avatar.attached? %>
                  <%= image_tag member.avatar.variant(resize_to_fill: [112, 112]), class: "h-full w-full object-cover", alt: member.name %>
                <% else %>
                  <img src="https://images.unsplash.com/photo-1560250097-0b93528c311a?auto=format&fit=crop&w=300&q=80" alt="Team member" class="h-full w-full object-cover" />
                <% end %>
              </div>
              <h4 class="re-heading text-xl font-semibold"><%= member.name.presence || member.email %></h4>
              <p class="re-label text-xs text-slate-500"><%= member.role.titleize %></p>
            </div>
          <% end %>
        <% else %>
          <div class="text-center">
            <div class="mx-auto mb-3 h-28 w-28 overflow-hidden rounded-full border-4 border-white shadow-lg">
              <img src="https://images.unsplash.com/photo-1560250097-0b93528c311a?auto=format&fit=crop&w=300&q=80" alt="Lead architect" class="h-full w-full object-cover" />
            </div>
            <h4 class="re-heading text-xl font-semibold">Rails Architect</h4>
            <p class="re-label text-xs text-slate-500">Lead Engineer</p>
          </div>
        <% end %>
      </div>
      <div class="mt-8">
        <%= btn_link_to "Join Our Engineering Team", "#", variant: :secondary %>
      </div>
    </div>
  </section>

  <section class="bg-[#191c1e] py-20 text-white">
    <div class="re-shell flex flex-col items-center justify-between gap-8 md:flex-row">
      <div class="max-w-2xl text-center md:text-left">
        <h2 class="re-heading text-5xl font-bold">Ready to build the future?</h2>
        <p class="mt-3 text-lg text-slate-300">Whether you are starting from scratch or scaling an existing app, our Ruby on Rails experts are here to help you achieve engineering excellence.</p>
      </div>
      <%= btn_link_to "Let's Chat", "#", variant: :primary, class: "px-8" %>
    </div>
  </section>

  <footer class="border-t border-[#e2e8f0] bg-white py-10">
    <div class="re-shell flex flex-col items-start justify-between gap-8 md:flex-row md:items-center">
      <div>
        <p class="re-heading text-2xl font-bold text-slate-900">Rails Engineering</p>
        <p class="mt-1 text-[#545f73]">The authoritative peer in Ruby on Rails development.</p>
      </div>
      <nav class="flex flex-wrap gap-4 re-label text-xs text-slate-500">
        <a href="#" class="hover:text-[#9e0000]">Architecture</a>
        <a href="#" class="hover:text-[#9e0000]">Security</a>
        <a href="#" class="hover:text-[#9e0000]">Careers</a>
        <a href="#" class="hover:text-[#9e0000]">Privacy Policy</a>
        <a href="#" class="hover:text-[#9e0000]">RSS Feed</a>
      </nav>
    </div>

    <div class="re-shell mt-8 flex flex-col items-center justify-between gap-4 border-t border-[#e2e8f0] pt-6 text-sm text-slate-500 md:flex-row">
      <p>© 2024 Rails Engineering Department. Built with Ruby on Rails and Hotwire.</p>
      <div class="flex gap-2">
        <a href="#" class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-[#e2e8f0] text-slate-500 hover:text-[#9e0000]">O</a>
        <a href="#" class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-[#e2e8f0] text-slate-500 hover:text-[#9e0000]">&gt;_</a>
      </div>
    </div>
  </footer>
</main>
