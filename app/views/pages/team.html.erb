<% content_for :title, t("pages.team.title") %>

<div class="mx-auto max-w-6xl px-4 py-8 sm:px-6 lg:px-8">
  <section class="max-w-3xl">
    <p class="re-page-kicker"><%= t("pages.team.kicker") %></p>
    <h1 class="re-heading mt-2 text-5xl font-bold leading-tight text-slate-900 sm:text-6xl"><%= t("pages.team.hero_title") %></h1>
    <p class="mt-4 text-lg leading-8 text-slate-600"><%= t("pages.team.hero_body") %></p>
  </section>

  <% if @featured_member.present? %>
    <% featured_posts = @recent_posts_by_member[@featured_member.id] || [] %>
    <section class="mt-10 rounded-2xl border border-[#e2e8f0] bg-white p-6 shadow-sm sm:p-8">
      <div class="grid gap-6 md:grid-cols-12">
        <div class="md:col-span-4">
          <% if @featured_member.avatar&.attached? %>
            <%= image_tag @featured_member.avatar.variant(resize_to_fill: [520, 520]), class: "aspect-square w-full rounded-xl object-cover grayscale transition hover:grayscale-0", alt: @featured_member.name, loading: "lazy" %>
          <% else %>
            <%= image_tag "default_avatar.svg", class: "aspect-square w-full rounded-xl object-cover", alt: @featured_member.name %>
          <% end %>
        </div>
        <div class="md:col-span-8">
          <p class="re-label text-xs uppercase tracking-[0.2em] text-[#9e0000]"><%= t("pages.team.featured.label") %></p>
          <h2 class="re-heading mt-2 text-4xl font-semibold text-slate-900"><%= @featured_member.name.presence || @featured_member.email %></h2>
          <p class="mt-1 text-sm uppercase tracking-wide text-slate-500"><%= t("pages.team.published_articles", count: (@featured_member.respond_to?(:published_posts_count) ? @featured_member.published_posts_count.to_i : 0)) %></p>
          <p class="mt-4 text-base leading-7 text-slate-600"><%= t("pages.team.featured.body") %></p>

          <% if featured_posts.any? %>
            <div class="mt-6 rounded-xl border border-slate-200 bg-slate-50 p-4">
              <p class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-500"><%= t("pages.team.featured.latest_writing") %></p>
              <div class="mt-3 space-y-2">
                <% featured_posts.first(2).each do |post| %>
                  <%= link_to post_path(post), class: "block text-sm font-medium text-slate-800 transition hover:text-[#9e0000]" do %>
                    <%= post.title %>
                  <% end %>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </section>
  <% end %>

  <section class="mt-8 grid grid-cols-1 gap-6 md:grid-cols-2 xl:grid-cols-3">
    <% @team_members.each do |member| %>
      <% recent_posts = @recent_posts_by_member[member.id] || [] %>
      <article class="rounded-2xl border border-[#e2e8f0] bg-white p-6 transition hover:shadow-md">
        <div class="flex items-start gap-4">
          <% if member.avatar&.attached? %>
            <%= image_tag member.avatar.variant(resize_to_fill: [80, 80]), class: "h-16 w-16 rounded-full object-cover border border-slate-200", alt: member.name, width: 64, height: 64, loading: "lazy" %>
          <% else %>
            <%= image_tag "default_avatar.svg", class: "h-16 w-16 rounded-full object-cover border border-slate-200", alt: member.name, width: 64, height: 64 %>
          <% end %>
          <div>
            <h3 class="re-heading text-2xl font-semibold text-slate-900"><%= member.name.presence || member.email %></h3>
            <p class="text-xs uppercase tracking-wide text-slate-500"><%= t("pages.team.published_posts", count: (member.respond_to?(:published_posts_count) ? member.published_posts_count.to_i : 0)) %></p>
          </div>
        </div>

        <% if recent_posts.any? %>
          <div class="mt-5 border-t border-slate-200 pt-4">
            <p class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-500"><%= t("pages.team.recent_posts") %></p>
            <div class="mt-3 space-y-2">
              <% recent_posts.first(2).each do |post| %>
                <%= link_to post_path(post), class: "block text-sm text-slate-700 transition hover:text-[#9e0000]" do %>
                  <%= post.title %>
                <% end %>
              <% end %>
            </div>
          </div>
        <% end %>

        <div class="mt-5">
          <%= link_to user_path(member), class: "text-sm font-semibold text-[#9e0000] hover:text-[#820000]" do %>
            <%= t("pages.team.view_profile") %>
          <% end %>
        </div>
      </article>
    <% end %>
  </section>
</div>
