<div class="mt-4 flex flex-wrap items-center text-sm">
  <% if controller_name == 'sessions' %>
    <%= link_to "Sign up", new_user_registration_path, class: "text-indigo-600 hover:text-indigo-500 mr-4 mb-2" %>
  <% end %>

  <% if devise_mapping.recoverable? && controller_name != 'passwords' %>
    <%= link_to "Forgot your password?", new_user_password_path, class: "text-sm text-gray-600 hover:text-gray-900 mr-4 mb-2" %>
  <% end %>

  <% if devise_mapping.confirmable? && controller_name != 'confirmations' %>
    <%= link_to "Didn't receive confirmation instructions?", new_user_confirmation_path, class: "text-sm text-gray-600 hover:text-gray-900 mr-4 mb-2" %>
  <% end %>

  <% if controller_name == 'registrations' %>
    <%= link_to "Sign in", new_user_session_path, class: "text-sm text-gray-700 hover:text-gray-900 mb-2" %>
  <% end %>
</div>
