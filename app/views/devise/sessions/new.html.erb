<%# Devise: Login page styled with Tailwind %>
<% resource ||= User.new %>
<% resource_name ||= :user %>
<% devise_mapping ||= Devise.mappings[:user] %>

<div class="min-h-[calc(100vh-11rem)] bg-[#f1f5f9] px-4 py-10 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-xl">
    <section class="rounded-xl border border-[#e2e8f0] bg-white p-6 shadow-sm sm:p-8">
      <div class="mb-7 flex flex-col items-center text-center">
        <div class="mb-4 flex h-14 w-14 items-center justify-center rounded-lg bg-[#9e0000] text-white">
          <span class="text-2xl font-bold">R</span>
        </div>
        <h1 class="re-heading text-3xl font-bold text-slate-900"><%= t("auth.sessions.title") %></h1>
        <p class="mt-2 text-sm text-slate-500"><%= t("auth.sessions.subtitle") %></p>
      </div>

      <%= render 'shared/flash' %>
      <%= devise_error_messages! %>

      <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
        <div class="space-y-4">
          <div>
            <%= f.label :email, class: "mb-2 block text-xs font-semibold uppercase tracking-wide text-slate-600" %>
            <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: t("auth.email_placeholder", default: "you@example.com"), class: "block h-12 w-full rounded-md border border-[#e2e8f0] bg-white px-4 text-sm text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-[#9e0000]" %>
          </div>

          <div>
            <div class="mb-2 flex items-center justify-between">
              <%= f.label :password, class: "block text-xs font-semibold uppercase tracking-wide text-slate-600" %>
              <%= link_to t("auth.sessions.forgot_password"), new_password_path(resource_name), class: "text-xs font-medium text-[#9e0000] hover:text-[#820000]" %>
            </div>
            <%= f.password_field :password, autocomplete: "current-password", placeholder: t("auth.sessions.password_placeholder", default: "Enter your password"), class: "block h-12 w-full rounded-md border border-[#e2e8f0] bg-white px-4 text-sm text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-[#9e0000]" %>
          </div>

          <label class="flex items-center text-sm text-slate-600">
            <%= f.check_box :remember_me, class: "h-4 w-4 rounded border-slate-300 text-[#9e0000] focus:ring-[#9e0000]" %>
            <span class="ml-2"><%= t("auth.sessions.remember_me") %></span>
          </label>

          <%= f.button type: "submit", class: "mt-2 inline-flex h-12 w-full items-center justify-center gap-2 rounded-md bg-[#9e0000] px-4 text-base font-semibold text-white transition hover:bg-[#820000]" do %>
            <%= t("auth.sessions.submit") %>
            <span aria-hidden="true">→</span>
          <% end %>
        </div>
      <% end %>

      <div class="mt-6 border-t border-slate-200 pt-4 text-center text-sm text-slate-600">
        <%= t("auth.sessions.no_account") %>
        <%= link_to t("auth.sessions.create_one"), new_registration_path(resource_name), class: "font-medium text-[#9e0000] hover:text-[#820000]" %>
      </div>
    </section>
  </div>
</div>
