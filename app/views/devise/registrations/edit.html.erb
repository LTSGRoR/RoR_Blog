<% resource ||= current_user %>
<% resource_name ||= :user %>
<% devise_mapping ||= Devise.mappings[:user] %>

<div class="bg-[radial-gradient(circle_at_top,rgba(224,231,255,0.55),transparent_38%),linear-gradient(to_bottom,#f8fafc,#f8fafc)] py-10 sm:py-12">
  <div class="max-w-5xl mx-auto space-y-6 px-4 sm:px-6 lg:px-8">
    <section class="overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-sm">
      <div class="h-1.5 bg-gradient-to-r from-indigo-600 via-sky-500 to-indigo-500"></div>

      <div class="border-b border-slate-100 bg-[linear-gradient(180deg,rgba(248,250,252,0.92),rgba(255,255,255,1))] p-6 sm:px-8">
        <div class="flex flex-col gap-5 md:flex-row md:items-center md:justify-between">
          <div class="min-w-0">
            <p class="text-xs font-semibold uppercase tracking-[0.2em] text-indigo-600"><%= t("auth.registrations.edit.sidebar_label") %></p>
            <h1 class="mt-2 text-3xl font-semibold tracking-tight text-slate-900"><%= t("auth.registrations.edit.title") %></h1>
            <p class="mt-2 max-w-2xl text-sm leading-6 text-slate-600"><%= t("auth.registrations.edit.subtitle") %></p>
          </div>
        </div>
      </div>

      <div class="p-6 sm:px-8">
        <div class="rounded-2xl border border-slate-200 bg-slate-50/80 p-4 sm:p-5">
          <div class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
            <div class="flex min-w-0 items-center gap-4">
              <% if resource.avatar.attached? %>
                <%= image_tag resource.avatar.variant(resize_to_fill: [56, 56]), class: "h-14 w-14 rounded-full border-2 border-white object-cover shadow-sm", alt: resource.name.presence || resource.email %>
              <% end %>

              <div class="min-w-0">
                <p class="truncate text-base font-semibold text-slate-900"><%= resource.name.presence || resource.email %></p>
                <p class="truncate text-sm text-slate-500"><%= resource.email %></p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
      <%= render "devise/shared/error_messages", resource: resource %>

      <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put, multipart: true }) do |f| %>
        <div class="space-y-8">
          <section class="rounded-2xl border border-slate-200 bg-slate-50/80 p-6">
            <div class="flex flex-wrap items-start justify-between gap-3">
              <div>
                <h2 class="text-xl font-semibold text-slate-800"><%= t("auth.registrations.edit.profile_title") %></h2>
                <p class="mt-1 text-sm text-slate-500"><%= t("auth.registrations.edit.profile_subtitle") %></p>
              </div>
              <span class="inline-flex items-center rounded-full bg-white px-3 py-1 text-xs font-medium text-slate-500 ring-1 ring-slate-200"><%= t("auth.registrations.edit.public_badge") %></span>
            </div>

            <div class="mt-5 grid gap-5 sm:grid-cols-2">
              <div class="sm:col-span-2">
                <%= f.label :name, class: "block text-xs font-medium text-slate-600" %>
                <%= f.text_field :name, autocomplete: "name", placeholder: "Your full name", class: "mt-1 block w-full rounded-lg border border-slate-200 bg-white px-4 py-3 placeholder-slate-400 shadow-sm focus:border-indigo-300 focus:outline-none focus:ring-2 focus:ring-indigo-500 transition" %>
              </div>

              <div class="sm:col-span-2">
                <%= f.label :email, class: "block text-xs font-medium text-slate-600" %>
                <%= f.email_field :email, autocomplete: "email", placeholder: "you@department.com", class: "mt-1 block w-full rounded-lg border border-slate-200 bg-white px-4 py-3 placeholder-slate-400 shadow-sm focus:border-indigo-300 focus:outline-none focus:ring-2 focus:ring-indigo-500 transition" %>
                <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
                  <div class="mt-3 rounded-xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-900">
                    <p class="font-medium"><%= t("auth.registrations.edit.pending_email_title") %></p>
                    <p class="mt-1 text-amber-800"><%= t("auth.registrations.edit.pending_email_body", email: resource.unconfirmed_email) %></p>
                  </div>
                <% end %>
              </div>

              <div class="sm:col-span-2">
                <%= f.label :avatar, class: "block text-xs font-medium text-slate-600" %>
                <div class="mt-3 rounded-2xl border border-dashed border-slate-300 bg-white p-4 shadow-sm"
                     data-controller="avatar-preview">
                  <div class="flex flex-col gap-4 sm:flex-row sm:items-center">
                    <% if resource.avatar.attached? %>
                      <%= image_tag resource.avatar.variant(resize_to_fill: [88, 88]), data: { "avatar-preview-target": "preview" }, class: "h-[88px] w-[88px] rounded-full border border-slate-300 object-cover shadow-sm", alt: resource.name.presence || resource.email %>
                    <% else %>
                      <img data-avatar-preview-target="preview" class="hidden h-[88px] w-[88px] rounded-full border border-slate-300 object-cover shadow-sm" alt="">
                      <div data-avatar-preview-target="placeholder" class="flex h-[88px] w-[88px] items-center justify-center rounded-full border border-dashed border-slate-300 bg-slate-50 text-center text-xs text-slate-400"><%= simple_format(t("auth.registrations.edit.upload_avatar"), {}, wrapper_tag: "span") %></div>
                    <% end %>
                    <div class="flex-1">
                      <p class="text-sm font-medium text-slate-700"><%= t("auth.registrations.edit.avatar_title") %></p>
                      <p class="mt-1 text-sm text-slate-500"><%= t("auth.registrations.edit.avatar_hint") %></p>
                      <%= f.file_field :avatar, accept: "image/*", data: { "avatar-preview-target": "input", action: "change->avatar-preview#change" }, class: "mt-3 block w-full text-sm text-slate-600 file:mr-4 file:rounded-md file:border-0 file:bg-indigo-50 file:px-4 file:py-2 file:text-sm file:font-medium file:text-indigo-700 hover:file:bg-indigo-100" %>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </section>

          <section class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm ring-1 ring-slate-100">
            <h2 class="text-xl font-semibold text-slate-800"><%= t("auth.registrations.edit.security_title") %></h2>
            <p class="mt-1 text-sm text-slate-500"><%= t("auth.registrations.edit.security_subtitle") %></p>

            <div class="mt-5 grid gap-5 sm:grid-cols-2">
              <div>
                <%= f.label :password, t("auth.passwords.edit.new_password_label"), class: "block text-xs font-medium text-slate-600" %>
                <%= f.password_field :password, autocomplete: "new-password", placeholder: "Choose a new password", class: "mt-1 block w-full rounded-lg border border-slate-200 bg-white px-4 py-3 placeholder-slate-400 shadow-sm focus:border-indigo-300 focus:outline-none focus:ring-2 focus:ring-indigo-500 transition" %>
              </div>

              <div>
                <%= f.label :password_confirmation, class: "block text-xs font-medium text-slate-600" %>
                <%= f.password_field :password_confirmation, autocomplete: "new-password", placeholder: "Confirm your new password", class: "mt-1 block w-full rounded-lg border border-slate-200 bg-white px-4 py-3 placeholder-slate-400 shadow-sm focus:border-indigo-300 focus:outline-none focus:ring-2 focus:ring-indigo-500 transition" %>
              </div>

              <div class="sm:col-span-2">
                <%= f.label :current_password, class: "block text-xs font-medium text-slate-600" %>
                <%= f.password_field :current_password, autocomplete: "current-password", placeholder: "Enter your current password to save changes", class: "mt-1 block w-full rounded-lg border border-slate-200 bg-white px-4 py-3 placeholder-slate-400 shadow-sm focus:border-indigo-300 focus:outline-none focus:ring-2 focus:ring-indigo-500 transition" %>
                <p class="mt-2 text-xs text-slate-500"><%= t("auth.registrations.edit.current_password_hint") %></p>
                <p class="mt-1 text-xs text-slate-400"><%= t("auth.registrations.edit.current_password_security_only") %></p>
              </div>
            </div>
          </section>

          <div class="flex flex-wrap items-center justify-between gap-3 rounded-2xl border border-slate-200 bg-slate-50 px-4 py-4">
            <div class="flex flex-wrap gap-3">
              <%= btn_link_to t("auth.registrations.edit.back_home"), root_path, variant: :ghost %>
              <%= btn_link_to t("auth.registrations.edit.public_profile"), user_path(resource), variant: :secondary %>
            </div>

            <%= btn_submit f, t("auth.registrations.edit.save_changes"), variant: :primary %>
          </div>
        </div>
      <% end %>
    </section>
  </div>
</div>