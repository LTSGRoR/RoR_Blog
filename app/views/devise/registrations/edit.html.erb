<% resource ||= current_user %>
<% resource_name ||= :user %>
<% devise_mapping ||= Devise.mappings[:user] %>

<div class="bg-[radial-gradient(circle_at_top,rgba(255,0,0,0.08),transparent_34%),linear-gradient(180deg,#fff7f7_0%,#f8fafc_42%,#f8fafc_100%)] py-10 sm:py-12">
  <div class="mx-auto max-w-6xl space-y-6 px-4 sm:px-6 lg:px-8">
    <section class="overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-sm">
      <div class="h-1.5 bg-gradient-to-r from-[#9e0000] via-[#cc0000] to-[#820000]"></div>

      <div class="border-b border-slate-100 bg-[linear-gradient(180deg,rgba(248,250,252,0.92),rgba(255,255,255,1))] p-6 sm:px-8">
        <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
          <div class="min-w-0 max-w-3xl">
            <p class="text-xs font-semibold uppercase tracking-[0.2em] text-[#9e0000]"><%= t("auth.registrations.edit.sidebar_label") %></p>
            <h1 class="mt-2 text-3xl font-semibold tracking-tight text-slate-900"><%= t("auth.registrations.edit.title") %></h1>
            <p class="mt-2 text-sm leading-6 text-slate-600"><%= t("auth.registrations.edit.subtitle") %></p>
            <p class="mt-3 text-xs font-medium uppercase tracking-[0.18em] text-slate-400"><%= t("auth.registrations.edit.current_password_note") %></p>
          </div>

          <div class="flex flex-wrap gap-3">
            <%= btn_link_to t("auth.registrations.edit.public_profile"), user_path(resource), variant: :secondary %>
            <%= btn_link_to t("auth.registrations.edit.back_home"), root_path, variant: :ghost %>
          </div>
        </div>
      </div>

      <div class="grid gap-6 p-6 sm:px-8 lg:grid-cols-[minmax(0,320px)_minmax(0,1fr)] lg:items-start">
        <aside class="space-y-4 lg:sticky lg:top-24">
          <div class="rounded-3xl border border-slate-200 bg-slate-50/80 p-5 shadow-sm">
            <div class="flex items-center gap-4">
              <div class="flex h-16 w-16 items-center justify-center overflow-hidden rounded-2xl border border-white bg-white shadow-sm ring-1 ring-slate-200">
                <% if resource.avatar.attached? %>
                  <%= image_tag resource.avatar.variant(resize_to_fill: [80, 80]), class: "h-full w-full object-cover", alt: resource.name.presence || resource.email %>
                <% else %>
                  <span class="text-xl font-semibold text-slate-400"><%= (resource.name.presence || resource.email).to_s.first.upcase %></span>
                <% end %>
              </div>

              <div class="min-w-0">
                <p class="truncate text-lg font-semibold text-slate-900"><%= resource.name.presence || resource.email %></p>
                <p class="truncate text-sm text-slate-500"><%= resource.email %></p>
              </div>
            </div>

            <div class="mt-4 flex flex-wrap gap-2">
              <span class="inline-flex items-center rounded-full bg-white px-3 py-1 text-xs font-medium text-slate-600 ring-1 ring-slate-200"><%= t("auth.registrations.edit.public_badge") %></span>
              <% if resource.pending_reconfirmation? %>
                <span class="inline-flex items-center rounded-full bg-amber-50 px-3 py-1 text-xs font-medium text-amber-800 ring-1 ring-amber-200"><%= t("auth.registrations.edit.pending_email_title") %></span>
              <% end %>
            </div>
          </div>

          <div class="rounded-3xl border border-slate-200 bg-white p-5 shadow-sm">
            <p class="text-xs font-semibold uppercase tracking-[0.18em] text-[#9e0000]"><%= t("auth.registrations.edit.quick_links") %></p>
            <div class="mt-4 space-y-3">
              <div class="rounded-2xl bg-slate-50 px-4 py-3 ring-1 ring-slate-200">
                <p class="text-xs uppercase tracking-wide text-slate-400"><%= t("users.profile.member_since", date: l(resource.created_at, format: :short)) %></p>
              </div>
              <div class="rounded-2xl bg-slate-50 px-4 py-3 ring-1 ring-slate-200">
                <p class="text-sm font-medium text-slate-700"><%= t("auth.registrations.edit.current_password_security_only") %></p>
              </div>
            </div>
          </div>
        </aside>

        <section class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
          <%= render "devise/shared/error_messages", resource: resource %>

          <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put, multipart: true }) do |f| %>
            <div class="space-y-8">
              <section class="rounded-2xl border border-slate-200 bg-slate-50/80 p-6">
                <div class="flex flex-wrap items-start justify-between gap-3">
                  <div>
                    <h2 class="text-xl font-semibold text-slate-800"><%= t("auth.registrations.edit.profile_title") %></h2>
                    <p class="mt-1 text-sm text-slate-500"><%= t("auth.registrations.edit.profile_subtitle") %></p>
                  </div>
                  <span class="inline-flex items-center rounded-full bg-white px-3 py-1 text-xs font-medium text-slate-500 ring-1 ring-slate-200"><%= t("auth.registrations.edit.public_badge") %></span>
                </div>

                <div class="mt-5 grid gap-5 sm:grid-cols-2">
                  <div class="sm:col-span-2">
                    <%= f.label :name, class: "block text-xs font-medium text-slate-600" %>
                    <%= f.text_field :name, autocomplete: "name", placeholder: "Your full name", class: "mt-1 block w-full rounded-xl border border-slate-200 bg-white px-4 py-3 placeholder-slate-400 shadow-sm focus:border-[#9e0000] focus:outline-none focus:ring-2 focus:ring-[#9e0000]/20 transition" %>
                  </div>

                  <div class="sm:col-span-2">
                    <%= f.label :email, class: "block text-xs font-medium text-slate-600" %>
                    <p class="mt-1 block w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-slate-500 shadow-sm"><%= resource.email %></p>
                  </div>

                  <div class="sm:col-span-2">
                    <%= f.label :avatar, class: "block text-xs font-medium text-slate-600" %>
                    <div class="mt-3 rounded-2xl border border-dashed border-slate-300 bg-white p-4 shadow-sm"
                         data-controller="avatar-preview">
                      <div class="flex flex-col gap-4 sm:flex-row sm:items-center">
                        <% if resource.avatar.attached? %>
                          <%= image_tag resource.avatar.variant(resize_to_fill: [88, 88]), data: { "avatar-preview-target": "preview" }, class: "h-[88px] w-[88px] rounded-full border border-slate-300 object-cover shadow-sm", alt: resource.name.presence || resource.email %>
                        <% else %>
                          <img data-avatar-preview-target="preview" class="hidden h-[88px] w-[88px] rounded-full border border-slate-300 object-cover shadow-sm" alt="">
                          <div data-avatar-preview-target="placeholder" class="flex h-[88px] w-[88px] items-center justify-center rounded-full border border-dashed border-slate-300 bg-slate-50 text-center text-xs text-slate-400"><%= simple_format(t("auth.registrations.edit.upload_avatar"), {}, wrapper_tag: "span") %></div>
                        <% end %>
                        <div class="flex-1">
                          <p class="text-sm font-medium text-slate-700"><%= t("auth.registrations.edit.avatar_title") %></p>
                          <p class="mt-1 text-sm text-slate-500"><%= t("auth.registrations.edit.avatar_hint") %></p>
                          <%= f.file_field :avatar, accept: "image/*", data: { "avatar-preview-target": "input", action: "change->avatar-preview#change" }, class: "mt-3 block w-full text-sm text-slate-600 file:mr-4 file:rounded-md file:border-0 file:bg-red-50 file:px-4 file:py-2 file:text-sm file:font-medium file:text-[#9e0000] hover:file:bg-red-100" %>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </section>

              <section class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm ring-1 ring-slate-100">
                <h2 class="text-xl font-semibold text-slate-800"><%= t("auth.registrations.edit.security_title") %></h2>
                <p class="mt-1 text-sm text-slate-500"><%= t("auth.registrations.edit.security_subtitle") %></p>

                <div class="mt-5 grid gap-5 sm:grid-cols-2">
                  <div>
                    <%= f.label :password, t("auth.passwords.edit.new_password_label"), class: "block text-xs font-medium text-slate-600" %>
                    <%= f.password_field :password, autocomplete: "new-password", placeholder: "Choose a new password", class: "mt-1 block w-full rounded-xl border border-slate-200 bg-white px-4 py-3 placeholder-slate-400 shadow-sm focus:border-[#9e0000] focus:outline-none focus:ring-2 focus:ring-[#9e0000]/20 transition" %>
                  </div>

                  <div>
                    <%= f.label :password_confirmation, class: "block text-xs font-medium text-slate-600" %>
                    <%= f.password_field :password_confirmation, autocomplete: "new-password", placeholder: "Confirm your new password", class: "mt-1 block w-full rounded-xl border border-slate-200 bg-white px-4 py-3 placeholder-slate-400 shadow-sm focus:border-[#9e0000] focus:outline-none focus:ring-2 focus:ring-[#9e0000]/20 transition" %>
                  </div>

                  <div class="sm:col-span-2">
                    <%= f.label :current_password, class: "block text-xs font-medium text-slate-600" %>
                    <%= f.password_field :current_password, autocomplete: "current-password", placeholder: "Enter your current password to save changes", class: "mt-1 block w-full rounded-xl border border-slate-200 bg-white px-4 py-3 placeholder-slate-400 shadow-sm focus:border-[#9e0000] focus:outline-none focus:ring-2 focus:ring-[#9e0000]/20 transition" %>
                    <p class="mt-2 text-xs text-slate-500"><%= t("auth.registrations.edit.current_password_hint") %></p>
                    <p class="mt-1 text-xs text-slate-400"><%= t("auth.registrations.edit.current_password_security_only") %></p>
                  </div>
                </div>
              </section>

              <div class="flex flex-wrap items-center justify-between gap-3 rounded-2xl border border-slate-200 bg-slate-50 px-4 py-4">
                <div class="flex flex-wrap gap-3">
                  <%= btn_link_to t("auth.registrations.edit.public_profile"), user_path(resource), variant: :secondary %>
                  <%= btn_link_to t("auth.registrations.edit.back_home"), root_path, variant: :ghost %>
                </div>

                <%= btn_submit f, t("auth.registrations.edit.save_changes"), variant: :primary %>
              </div>
            </div>
          <% end %>
        </section>
      </div>
    </section>
  </div>
</div>