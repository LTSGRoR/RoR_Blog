<%# Devise: Registration (sign up) page styled with Tailwind %>
<% resource ||= User.new %>
<% resource_name ||= :user %>
<% devise_mapping ||= Devise.mappings[:user] %>

<div class="min-h-[calc(100vh-11rem)] bg-[#f1f5f9] px-4 py-10 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-xl">
    <section class="rounded-xl border border-[#e2e8f0] bg-white p-6 shadow-sm sm:p-8">
      <div class="mb-7 flex flex-col items-center text-center">
        <div class="mb-4 flex h-14 w-14 items-center justify-center rounded-lg bg-[#9e0000] text-white">
          <span class="text-2xl font-bold">R</span>
        </div>
        <h1 class="re-heading text-3xl font-bold text-slate-900"><%= t("auth.registrations.title") %></h1>
        <p class="mt-2 text-sm text-slate-500"><%= t("auth.registrations.subtitle") %></p>
      </div>

      <%= render 'shared/flash' %>
      <%= devise_error_messages! %>

      <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
        <div class="space-y-4">
          <div>
            <%= f.label :name, class: "mb-2 block text-xs font-semibold uppercase tracking-wide text-slate-600" %>
            <%= f.text_field :name, autocomplete: "name", placeholder: t("auth.registrations.name_placeholder"), class: "block h-12 w-full rounded-md border border-[#e2e8f0] bg-white px-4 text-sm text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-[#9e0000]" %>
          </div>

          <div>
            <%= f.label :email, class: "mb-2 block text-xs font-semibold uppercase tracking-wide text-slate-600" %>
            <%= f.email_field :email, autocomplete: "email", placeholder: t("auth.email_placeholder", default: "you@example.com"), class: "block h-12 w-full rounded-md border border-[#e2e8f0] bg-white px-4 text-sm text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-[#9e0000]" %>
          </div>

          <div>
            <%= f.label :password, class: "mb-2 block text-xs font-semibold uppercase tracking-wide text-slate-600" %>
            <%= f.password_field :password, autocomplete: "new-password", placeholder: t("auth.registrations.password_placeholder"), class: "block h-12 w-full rounded-md border border-[#e2e8f0] bg-white px-4 text-sm text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-[#9e0000]" %>
          </div>

          <div>
            <%= f.label :password_confirmation, class: "mb-2 block text-xs font-semibold uppercase tracking-wide text-slate-600" %>
            <%= f.password_field :password_confirmation, autocomplete: "new-password", placeholder: t("auth.registrations.password_confirmation_placeholder"), class: "block h-12 w-full rounded-md border border-[#e2e8f0] bg-white px-4 text-sm text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-[#9e0000]" %>
          </div>

          <%= f.submit t("auth.registrations.submit"), class: "mt-2 inline-flex h-12 w-full items-center justify-center rounded-md bg-[#9e0000] px-4 text-base font-semibold text-white transition hover:bg-[#820000]" %>
        </div>
      <% end %>

      <div class="mt-6 border-t border-slate-200 pt-4 text-center text-sm text-slate-600">
        <%= t("auth.registrations.have_account") %>
        <%= link_to t("auth.links.sign_in"), new_session_path(resource_name), class: "font-medium text-[#9e0000] hover:text-[#820000]" %>
      </div>
    </section>
  </div>
</div>
