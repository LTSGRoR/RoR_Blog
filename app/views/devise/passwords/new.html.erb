<% resource ||= User.new %>
<% resource_name ||= :user %>
<% devise_mapping ||= Devise.mappings[:user] %>

<div class="min-h-screen flex items-center justify-center bg-gradient-to-br from-slate-50 to-slate-100 py-12 px-4 sm:px-6 lg:px-8">
  <div class="max-w-4xl w-full overflow-hidden rounded-2xl bg-white shadow-2xl grid grid-cols-1 md:grid-cols-2">
    <div class="hidden md:flex flex-col justify-between bg-gradient-to-br from-indigo-600 to-purple-600 px-8 py-10 text-white">
      <div>
        <p class="text-sm uppercase tracking-[0.18em] text-indigo-100"><%= t("auth.passwords.new.sidebar_label") %></p>
        <h1 class="mt-4 text-3xl font-bold"><%= t("auth.passwords.new.title") %></h1>
        <p class="mt-3 text-sm leading-6 text-indigo-50"><%= t("auth.passwords.new.sidebar_body") %></p>
      </div>

      <div class="rounded-2xl bg-white/10 p-5">
        <p class="text-sm font-semibold"><%= t("auth.passwords.new.steps_title") %></p>
        <ul class="mt-3 space-y-2 text-sm text-indigo-50">
          <li>1. <%= t("auth.passwords.new.step_1") %></li>
          <li>2. <%= t("auth.passwords.new.step_2") %></li>
          <li>3. <%= t("auth.passwords.new.step_3") %></li>
        </ul>
      </div>
    </div>

    <div class="p-4 sm:p-8">
      <div class="mx-auto max-w-md">
        <h2 class="text-2xl font-semibold text-slate-800"><%= t("auth.passwords.new.form_title") %></h2>
        <p class="mt-2 text-sm text-slate-500"><%= t("auth.passwords.new.form_subtitle") %></p>

        <div class="mt-6">
          <%= render "devise/shared/error_messages", resource: resource %>

          <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post }) do |f| %>
            <div class="space-y-4">
              <div>
                <%= f.label :email, class: "block text-xs font-medium text-slate-600" %>
                <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: "you@department.com", class: "mt-1 block w-full rounded-lg border border-slate-200 bg-white px-4 py-3 placeholder-slate-400 shadow-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 transition" %>
              </div>

              <div class="flex flex-wrap items-center justify-between gap-3 pt-2">
                <%= btn_link_to t("auth.passwords.shared.back_to_sign_in"), new_session_path(resource_name), variant: :ghost %>
                <%= btn_submit f, t("auth.passwords.new.submit"), variant: :primary %>
              </div>
            </div>
          <% end %>

          <div class="mt-6 border-t border-slate-100 pt-5">
            <%= render "devise/shared/links" %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>