<section class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8" data-controller="review-modal" data-action="keydown@window->review-modal#closeOnEscape">
  <%= turbo_stream_from "admin_posts" %>

  <div class="rounded-3xl border border-slate-200/70 bg-gradient-to-br from-white via-slate-50 to-slate-100 p-6 shadow-sm sm:p-8">
    <div class="flex flex-col items-start gap-4 sm:flex-row sm:items-start sm:justify-between">
      <div class="min-w-0">
        <h1 class="text-3xl font-bold tracking-tight text-slate-900"><%= t("admin.posts.index.title") %></h1>
        <p class="mt-2 max-w-2xl text-sm text-slate-600"><%= t("admin.posts.index.subtitle") %></p>
      </div>
    </div>

    <div class="mt-6 grid grid-cols-1 gap-3 sm:grid-cols-2 xl:grid-cols-4">
      <div class="rounded-xl border border-sky-200 bg-sky-50 p-3 shadow-sm">
        <p class="text-xs font-medium uppercase tracking-wide text-sky-700"><%= t("admin.posts.index.stats.pending_posts") %></p>
        <p class="mt-1 text-2xl font-semibold text-sky-800"><%= @pending_post_count %></p>
      </div>
      <div class="rounded-xl border border-amber-200 bg-amber-50 p-3 shadow-sm">
        <p class="text-xs font-medium uppercase tracking-wide text-amber-700"><%= t("admin.posts.index.stats.pending_revisions") %></p>
        <p class="mt-1 text-2xl font-semibold text-amber-800"><%= @pending_count %></p>
      </div>
      <div class="rounded-xl border border-indigo-200 bg-indigo-50 p-3 shadow-sm">
        <p class="text-xs font-medium uppercase tracking-wide text-indigo-700"><%= t("admin.posts.index.stats.open") %></p>
        <p class="mt-1 text-2xl font-semibold text-indigo-800"><%= @draft_count %></p>
      </div>
      <div class="rounded-xl border border-emerald-200 bg-emerald-50 p-3 shadow-sm">
        <p class="text-xs font-medium uppercase tracking-wide text-emerald-700"><%= t("admin.posts.index.stats.reviewed_today") %></p>
        <p class="mt-1 text-2xl font-semibold text-emerald-800"><%= @reviewed_today_count %></p>
      </div>
    </div>

    <div class="mt-5 flex flex-wrap items-center gap-2">
      <% { "posts" => t("admin.posts.index.scopes.posts"), "revisions" => t("admin.posts.index.scopes.revisions") }.each do |value, label| %>
        <%= link_to label, admin_posts_path(scope: value, q: @query), class: "rounded-full border px-3 py-1.5 text-xs font-semibold transition #{value == @scope ? 'border-slate-900 bg-slate-900 text-white' : 'border-slate-200 bg-white text-slate-600 hover:border-slate-300'}" %>
      <% end %>
    </div>

    <% if @scope == "posts" || @scope == "revisions" %>
    <div class="mt-4 flex flex-wrap items-center gap-2">
      <% if @scope == "posts" %>
        <% {
          "all_posts" => t("admin.posts.index.filters.all_posts"),
          "awaiting_review" => t("admin.posts.index.filters.awaiting_review"),
          "rejected" => t("admin.posts.index.filters.rejected"),
          "ai_needs_admin_review" => t("admin.posts.index.filters.ai_needs_admin_review"),
          "ai_auto_approved" => t("admin.posts.index.filters.ai_auto_approved"),
          "ai_failed" => t("admin.posts.index.filters.ai_failed"),
          "ai_in_progress" => t("admin.posts.index.filters.ai_in_progress"),
          "ai_pending" => t("admin.posts.index.filters.ai_pending")
        }.each do |value, label| %>
          <%= link_to label, admin_posts_path(scope: @scope, filter: value, q: @query), class: "rounded-full border px-3 py-1.5 text-xs font-semibold transition #{value == @filter ? 'border-indigo-300 bg-indigo-100 text-indigo-800' : 'border-slate-200 bg-white text-slate-600 hover:border-slate-300'}" %>
        <% end %>
      <% elsif @scope == "revisions" %>
        <% { "pending" => t("admin.posts.index.filters.pending"), "open" => t("admin.posts.index.filters.open"), "reviewed" => t("admin.posts.index.filters.reviewed") }.each do |value, label| %>
          <%= link_to label, admin_posts_path(scope: @scope, filter: value, q: @query), class: "rounded-full border px-3 py-1.5 text-xs font-semibold transition #{value == @filter ? 'border-indigo-300 bg-indigo-100 text-indigo-800' : 'border-slate-200 bg-white text-slate-600 hover:border-slate-300'}" %>
        <% end %>
      <% end %>
    </div>
    <% end %>

    <%= form_with url: admin_posts_path, method: :get, local: true, class: "mt-4 flex flex-col gap-2 sm:flex-row sm:flex-wrap sm:items-center" do |f| %>
      <%= f.hidden_field :scope, value: @scope %>
      <%= f.hidden_field :filter, value: @filter %>
      <%= f.search_field :q, value: @query, placeholder: t("admin.posts.index.search_placeholder"), class: "w-full min-w-0 rounded-lg border border-slate-300 px-3 py-2 text-sm text-slate-700 focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500 sm:max-w-md sm:flex-1" %>
      <%= f.submit t("admin.posts.index.search"), class: "w-full rounded-lg bg-slate-900 px-3 py-2 text-sm font-semibold text-white hover:bg-slate-800 sm:w-auto" %>
    <% end %>
  </div>

  <% if %w[all posts].include?(@scope) %>
  <section class="mt-6 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
    <div class="border-b border-slate-200 px-4 py-4 sm:px-6">
      <h2 class="text-lg font-semibold text-slate-900"><%= t("admin.posts.index.pending_posts.title") %></h2>
      <p class="mt-1 text-sm text-slate-600"><%= t("admin.posts.index.pending_posts.subtitle") %></p>
    </div>

    <div class="max-h-[50vh] overflow-auto overscroll-x-contain">
      <table class="min-w-[1080px] w-full divide-y divide-slate-200 table-auto">
        <thead class="sticky top-0 z-10 bg-slate-50/95 backdrop-blur">
          <tr>
            <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500"><%= t("admin.posts.index.pending_posts.columns.post") %></th>
            <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500"><%= t("admin.posts.index.pending_posts.columns.author") %></th>
            <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500"><%= t("admin.posts.index.pending_posts.columns.status") %></th>
            <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500"><%= t("admin.posts.index.pending_posts.columns.ai_review") %></th>
            <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500"><%= t("admin.posts.index.pending_posts.columns.submitted") %></th>
            <th class="px-2 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500"><%= t("admin.posts.index.pending_posts.columns.feedback") %></th>
            <th class="px-2 py-3 text-right text-xs font-semibold uppercase tracking-wide text-slate-500"><%= t("admin.posts.index.pending_posts.columns.actions") %></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 bg-white">
          <% @pending_posts.each_with_index do |post, i| %>
            <tr class="<%= i.even? ? "bg-white" : "bg-slate-50/40" %> transition hover:bg-sky-50/40">
              <td class="min-w-[240px] px-4 py-4 align-top">
                <p class="text-sm font-semibold text-slate-900 break-words"><%= link_to post.title, post_path(post), class: "hover:text-indigo-600" %></p>
                <% if post.tags.any? %>
                  <div class="mt-2 flex flex-wrap gap-1.5">
                    <% post.tags.each do |tag| %>
                      <span class="rounded-full bg-slate-100 px-2 py-0.5 text-[11px] font-medium text-slate-600"><%= tag.name %></span>
                    <% end %>
                  </div>
                <% end %>
              </td>
              <td class="min-w-[180px] px-4 py-4 align-top text-sm text-slate-700">
                <p><%= post.user&.name.presence || post.user&.email %></p>
                <p class="text-xs text-slate-500"><%= post.user&.email %></p>
              </td>
              <%= render "post_status_cell", post: post %>
              <%= render "post_ai_review_cell", post: post %>
              <%= render "post_submitted_cell", post: post %>
              <td class="min-w-[100px] px-2 py-4 align-top text-sm text-slate-600">
                <% if post.unverify_reason.present? || post.author_feedback_reply.present? %>
                  <div class="flex flex-wrap items-center gap-1.5">
                    <% if post.unverify_reason.present? %>
                      <span class="inline-flex whitespace-nowrap rounded-full bg-amber-100 px-2 py-0.5 text-[11px] font-semibold text-amber-800"><%= t("admin.posts.index.pending_posts.admin_feedback") %></span>
                    <% end %>
                    <% if post.author_feedback_reply.present? %>
                      <span class="inline-flex whitespace-nowrap rounded-full bg-sky-100 px-2 py-0.5 text-[11px] font-semibold text-sky-800"><%= t("admin.posts.index.pending_posts.author_replied") %></span>
                    <% end %>
                  </div>
                  <% if post.author_replied_at.present? %>
                    <p class="mt-1 text-[11px] text-slate-500"><%= t("posts.show.feedback.updated_at", time: l(post.author_replied_at, format: :short)) %></p>
                  <% end %>
                <% else %>
                  <span class="text-xs text-slate-500"><%= t("admin.posts.index.pending_posts.no_feedback") %></span>
                <% end %>
              </td>
              <td class="min-w-[90px] px-4 py-4 text-right align-top">
                <button
                  type="button"
                  class="group inline-flex items-center gap-1.5 whitespace-nowrap rounded-lg border border-indigo-200 bg-indigo-50 px-3 py-1.5 text-xs font-semibold leading-none text-indigo-700 shadow-sm transition hover:-translate-y-0.5 hover:border-indigo-300 hover:bg-indigo-100 hover:text-indigo-800 hover:shadow focus:outline-none focus:ring-2 focus:ring-indigo-400 focus:ring-offset-1"
                  data-action="review-modal#open"
                  data-review-modal-id-param="post-review-<%= post.id %>">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 shrink-0 text-indigo-500 transition group-hover:text-indigo-700" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                    <path d="M2.5 5.75A2.25 2.25 0 014.75 3.5h10.5a2.25 2.25 0 012.25 2.25v6.5a2.25 2.25 0 01-2.25 2.25h-4.1l-2.8 2.24a.75.75 0 01-1.22-.586V14.5h-2.38A2.25 2.25 0 012.5 12.25v-6.5z" />
                  </svg>
                  <span class="inline-flex items-center leading-none"><%= t("admin.posts.index.review") %></span>
                </button>

                <div
                  class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-900/50 p-4"
                  data-review-modal-target="modal"
                  data-modal-id="post-review-<%= post.id %>"
                  data-action="click->review-modal#backdropClose">
                  <div class="w-full max-w-md overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-2xl text-center" role="dialog" aria-modal="true" aria-labelledby="post-review-modal-title-<%= post.id %>">
                    <div class=" border-b border-slate-200 bg-slate-50 px-5 py-4">
                      <div>
                        <h3 id="post-review-modal-title-<%= post.id %>" class="text-base font-semibold text-slate-900"><%= t("admin.posts.index.review") %></h3>
                        <p class="mt-1 text-xs text-slate-500"><%= post.title %></p>
                      </div>
                    </div>

                    <div class="max-h-[70vh] space-y-3 overflow-y-auto p-5">

                      <%= render "post_ai_assessment_section", post: post %>

                      <%# Conversation thread (if any) %>
                      <% if post.unverify_reason.present? || post.author_feedback_reply.present? %>
                        <div class="space-y-2 rounded-md border border-slate-200 bg-slate-50 p-2.5">
                          <p class="text-[11px] font-semibold uppercase tracking-wide text-slate-600"><%= t("admin.posts.index.pending_posts.conversation") %></p>
                          <% if post.unverify_reason.present? %>
                            <div class="rounded-md border border-amber-200 bg-amber-50 px-2 py-1.5">
                              <p class="text-[11px] font-semibold uppercase tracking-wide text-amber-700"><%= t("admin.posts.index.pending_posts.admin_feedback") %></p>
                              <p class="mt-1 whitespace-pre-wrap text-xs text-amber-900"><%= post.unverify_reason %></p>
                            </div>
                          <% end %>
                          <% if post.author_feedback_reply.present? %>
                            <div class="rounded-md border border-sky-200 bg-sky-50 px-2 py-1.5">
                              <p class="text-[11px] font-semibold uppercase tracking-wide text-sky-700"><%= t("posts.show.feedback.author_reply") %></p>
                              <p class="mt-1 whitespace-pre-wrap text-xs text-sky-900"><%= post.author_feedback_reply %></p>
                              <% if post.author_replied_at.present? %>
                                <p class="mt-1 text-[11px] text-sky-700"><%= t("posts.show.feedback.updated_at", time: l(post.author_replied_at, format: :short)) %></p>
                              <% end %>
                            </div>
                          <% end %>
                        </div>
                      <% end %>

                      <% if post.verified? %>
                        <%# Verified post: only unverify action %>
                        <details class="group rounded-lg border border-slate-200">
                          <summary class="flex cursor-pointer list-none items-center justify-between px-4 py-2.5 text-sm font-semibold text-rose-600 hover:bg-rose-50">
                            <%= t("admin.posts.index.unverify") %>
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-slate-400 transition group-open:rotate-180" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd"/></svg>
                          </summary>
                          <div class="border-t border-slate-200 p-3">
                            <%= form_with url: unverify_post_path(post), method: :post, class: "space-y-2" do %>
                              <%= text_area_tag "post[unverify_reason]", post.unverify_reason, placeholder: t("admin.posts.index.reject_note_placeholder"), required: true, rows: 3, class: "w-full rounded-md border border-slate-300 px-2 py-1.5 text-xs text-slate-700 focus:border-rose-400 focus:outline-none focus:ring-1 focus:ring-rose-400" %>
                              <%= button_tag type: :submit, class: "group inline-flex w-full items-center justify-center gap-1.5 rounded-lg border border-rose-200 bg-rose-50 px-4 py-2 text-sm font-semibold text-rose-700 shadow-sm transition hover:-translate-y-0.5 hover:border-rose-300 hover:bg-rose-100 hover:text-rose-800 hover:shadow focus:outline-none focus:ring-2 focus:ring-rose-300 focus:ring-offset-1" do %>
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0 text-rose-500 transition group-hover:text-rose-700" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M9.707 3.293a1 1 0 00-1.414 0L3.586 8H6a1 1 0 110 2H2a1 1 0 01-1-1V5a1 1 0 112 0v2.414l4.293-4.293a1 1 0 011.414 0l8 8a1 1 0 01-1.414 1.414L9 6.414l-2.293 2.293a1 1 0 11-1.414-1.414l4.414-4.414z" clip-rule="evenodd" /></svg>
                                <span><%= t("admin.posts.index.unverify") %></span>
                              <% end %>
                            <% end %>
                          </div>
                        </details>
                      <% else %>
                        <%# Unverified post: Approve (primary) then Reject (collapsed) %>
                        <%= button_to verify_post_path(post), method: :post, class: "group inline-flex w-full items-center justify-center gap-1.5 rounded-lg border border-emerald-200 bg-emerald-50 px-4 py-2.5 text-sm font-semibold text-emerald-700 shadow-sm transition hover:-translate-y-0.5 hover:border-emerald-300 hover:bg-emerald-100 hover:text-emerald-800 hover:shadow focus:outline-none focus:ring-2 focus:ring-emerald-300 focus:ring-offset-1", data: { turbo_confirm: t("admin.posts.index.confirm_approve") }, form: { class: "w-full" } do %>
                          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0 text-emerald-500 transition group-hover:text-emerald-700" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-7.25 7.25a1 1 0 01-1.414 0l-3.25-3.25a1 1 0 111.414-1.414l2.543 2.543 6.543-6.543a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
                          <span><%= t("admin.posts.index.approve") %></span>
                        <% end %>

                        <details class="group rounded-lg border border-rose-200">
                          <summary class="flex cursor-pointer list-none items-center justify-between px-4 py-2.5 text-sm font-semibold text-rose-600 hover:bg-rose-50">
                            <%= t("admin.posts.index.reject") %>
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-rose-400 transition group-open:rotate-180" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd"/></svg>
                          </summary>
                          <div class="border-t border-rose-100 p-3">
                            <%= form_with url: unverify_post_path(post), method: :post, class: "space-y-2" do %>
                              <%= text_area_tag "post[unverify_reason]", post.unverify_reason, placeholder: t("admin.posts.index.reject_note_placeholder"), required: true, rows: 3, class: "w-full rounded-md border border-slate-300 px-2 py-1.5 text-xs text-slate-700 focus:border-rose-400 focus:outline-none focus:ring-1 focus:ring-rose-400" %>
                              <%= button_tag type: :submit, class: "group inline-flex w-full items-center justify-center gap-1.5 rounded-lg border border-rose-200 bg-rose-50 px-4 py-2 text-sm font-semibold text-rose-700 shadow-sm transition hover:-translate-y-0.5 hover:border-rose-300 hover:bg-rose-100 hover:text-rose-800 hover:shadow focus:outline-none focus:ring-2 focus:ring-rose-300 focus:ring-offset-1" do %>
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0 text-rose-500 transition group-hover:text-rose-700" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" /></svg>
                                <span><%= t("admin.posts.index.reject") %></span>
                              <% end %>
                            <% end %>
                          </div>
                        </details>
                      <% end %>

                      <%# Delete — always available, de-emphasised %>
                      <div class="border-t border-slate-100 pt-1">
                        <%= button_to post_path(post), method: :delete, class: "group inline-flex w-full items-center justify-center gap-1.5 rounded-lg border border-rose-200 bg-white px-4 py-2 text-xs font-semibold text-rose-600 shadow-sm transition hover:-translate-y-0.5 hover:border-rose-300 hover:bg-rose-50 hover:text-rose-700 hover:shadow focus:outline-none focus:ring-2 focus:ring-rose-300 focus:ring-offset-1", data: { turbo_confirm: t("posts.actions.confirm_delete") }, form: { class: "w-full" } do %>
                          <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 shrink-0 text-rose-500 transition group-hover:text-rose-700" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M6 4.75A1.75 1.75 0 017.75 3h4.5A1.75 1.75 0 0114 4.75V5h2.25a.75.75 0 010 1.5h-.56l-.63 8.17A2 2 0 0113.06 16H6.94a2 2 0 01-1.99-1.83L4.31 6.5h-.56a.75.75 0 010-1.5H6v-.25zM7.5 5h5v-.25a.25.25 0 00-.25-.25h-4.5a.25.25 0 00-.25.25V5zm.75 3a.75.75 0 00-1.5 0v4a.75.75 0 001.5 0V8zm4 0a.75.75 0 00-1.5 0v4a.75.75 0 001.5 0V8z" clip-rule="evenodd" /></svg>
                          <span><%= t("posts.actions.delete") %></span>
                        <% end %>
                      </div>

                    </div>
                  </div>
                </div>
              </td>
            </tr>
          <% end %>

          <% if @pending_posts.empty? %>
            <tr>
              <td colspan="7" class="px-4 py-8 text-center text-sm text-slate-500"><%= t("admin.posts.index.pending_posts.empty") %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>

  <div class="mt-6">
    <%= paginate @pending_posts, param_name: :posts_page %>
  </div>
  <% end %>

  <% if %w[all revisions].include?(@scope) %>
  <div class="mt-6 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
    <div class="border-b border-slate-200 px-4 py-4 sm:px-6">
      <h2 class="text-lg font-semibold text-slate-900"><%= t("admin.posts.index.pending_revisions.title") %></h2>
      <p class="mt-1 text-sm text-slate-600"><%= t("admin.posts.index.pending_revisions.subtitle") %></p>
    </div>

    <div class="max-h-[70vh] overflow-auto overscroll-x-contain">
      <table class="min-w-[860px] w-full divide-y divide-slate-200 table-auto">
        <thead class="sticky top-0 z-10 bg-slate-50/95 backdrop-blur">
          <tr>
            <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500"><%= t("admin.posts.index.columns.post") %></th>
            <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500"><%= t("admin.posts.index.columns.author") %></th>
            <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500"><%= t("admin.posts.index.columns.status") %></th>
            <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500"><%= t("admin.posts.index.columns.ai_review") %></th>
            <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500"><%= t("admin.posts.index.columns.submitted") %></th>
            <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wide text-slate-500"><%= t("admin.posts.index.columns.actions") %></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 bg-white">
          <% @revisions.each_with_index do |revision, i| %>
            <tr class="<%= i.even? ? "bg-white" : "bg-slate-50/40" %> transition hover:bg-indigo-50/40">
              <td class="min-w-[240px] px-4 py-4 align-top">
                <p class="text-sm font-semibold text-slate-900 break-words"><%= link_to revision.title, admin_post_revision_path(revision), class: "hover:text-indigo-600" %></p>
              </td>
              <td class="min-w-[180px] px-4 py-4 align-top text-sm text-slate-700">
                <p><%= revision.author.name.presence || revision.author.email %></p>
                <p class="text-xs text-slate-500"><%= revision.author.email %></p>
              </td>
              <td class="min-w-[120px] px-4 py-4 align-top text-sm">
                <span class="inline-flex whitespace-nowrap rounded-full px-2.5 py-1 text-xs font-semibold <%= revision.pending_review? ? 'bg-amber-100 text-amber-700' : (revision.draft? ? 'bg-indigo-100 text-indigo-700' : (revision.approved? ? 'bg-emerald-100 text-emerald-700' : 'bg-rose-100 text-rose-700')) %>">
                  <%= t("admin.posts.statuses.#{revision.moderation_status}") %>
                </span>
              </td>
              <td class="min-w-[220px] px-4 py-4 align-top text-sm">
                <% ai_reason = ai_review_reason_for(revision) %>
                <% ai_color = case revision.ai_review_status
                when "auto_approved" then "bg-emerald-100 text-emerald-700"
                when "needs_admin_review" then "bg-amber-100 text-amber-700"
                when "failed" then "bg-rose-100 text-rose-700"
                when "in_progress" then "bg-sky-100 text-sky-700"
                else "bg-slate-100 text-slate-700"
                end %>
                <span class="inline-flex whitespace-nowrap rounded-full px-2.5 py-1 text-xs font-semibold <%= ai_color %>"><%= t("admin.posts.index.ai_statuses.#{revision.ai_review_status}") %></span>

                <% if ai_reason.present? %>
                  <p class="mt-2 max-w-[22rem] text-xs leading-5 text-slate-600" title="<%= ai_reason %>">
                    <span class="font-semibold text-slate-700"><%= t("admin.posts.index.ai_reason") %>:</span>
                    <%= truncate(ai_reason, length: 100) %>
                  </p>
                <% end %>

                <% if revision.ai_confidence.present? || revision.ai_risk_score.present? %>
                  <div class="mt-2 flex flex-wrap items-center gap-1.5">
                    <% if revision.ai_confidence.present? %>
                      <span class="inline-flex whitespace-nowrap rounded-full border border-emerald-200 bg-emerald-50 px-2 py-0.5 text-[11px] font-medium text-emerald-700">
                        <%= t("admin.posts.index.ai_confidence", value: ai_review_percentage(revision.ai_confidence)) %>
                      </span>
                    <% end %>
                    <% if revision.ai_risk_score.present? %>
                      <span class="inline-flex whitespace-nowrap rounded-full border border-amber-200 bg-amber-50 px-2 py-0.5 text-[11px] font-medium text-amber-700">
                        <%= t("admin.posts.index.ai_risk", value: ai_review_percentage(revision.ai_risk_score)) %>
                      </span>
                    <% end %>
                  </div>
                <% end %>
              </td>
              <td class="min-w-[150px] px-4 py-4 align-top text-sm text-slate-600 whitespace-nowrap">
                <%= revision.submitted_at.present? ? l(revision.submitted_at, format: :short) : "-" %>
              </td>
              <td class="min-w-[220px] px-4 py-4 text-right align-top">
                <div class="grid grid-cols-2 gap-2">
                  <%= link_to(revision.pending_review? ? t("admin.posts.index.review") : t("admin.posts.index.open_draft"), admin_post_revision_path(revision), class: "group inline-flex w-full items-center justify-center gap-1.5 whitespace-nowrap rounded-lg border border-slate-200 bg-white px-3 py-1.5 text-xs font-semibold text-slate-700 shadow-sm transition hover:-translate-y-0.5 hover:border-slate-300 hover:bg-slate-50 hover:text-slate-900 hover:shadow focus:outline-none focus:ring-2 focus:ring-slate-300 focus:ring-offset-1") %>
                  <%= btn_button_to t("posts.actions.delete"), admin_post_revision_path(revision), method: :delete, variant: :danger, class: "w-full justify-center px-3 py-1.5 text-xs", data: { turbo_confirm: t("admin.posts.index.confirm_delete_revision") }, form: { class: "w-full" } %>
                </div>
              </td>
            </tr>
          <% end %>

          <% if @revisions.empty? %>
            <tr>
              <td colspan="6" class="px-4 py-8 text-center text-sm text-slate-500"><%= t("admin.posts.index.empty") %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <div class="mt-6">
    <%= paginate @revisions, param_name: :revisions_page %>
  </div>
  <% end %>
</section>