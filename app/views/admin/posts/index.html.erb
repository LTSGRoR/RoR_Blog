<section class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
  <div class="rounded-3xl border border-slate-200/70 bg-gradient-to-br from-white via-slate-50 to-slate-100 p-6 shadow-sm sm:p-8">
    <div class="flex flex-wrap items-start justify-between gap-4">
      <div>
        <h1 class="text-3xl font-bold tracking-tight text-slate-900"><%= t("admin.posts.index.title") %></h1>
        <p class="mt-2 max-w-2xl text-sm text-slate-600"><%= t("admin.posts.index.subtitle") %></p>
      </div>
    </div>

    <div class="mt-6 grid grid-cols-1 gap-3 sm:grid-cols-3">
      <div class="rounded-xl border border-amber-200 bg-amber-50 p-3 shadow-sm">
        <p class="text-xs font-medium uppercase tracking-wide text-amber-700"><%= t("admin.posts.index.stats.pending") %></p>
        <p class="mt-1 text-2xl font-semibold text-amber-800"><%= @pending_count %></p>
      </div>
      <div class="rounded-xl border border-indigo-200 bg-indigo-50 p-3 shadow-sm">
        <p class="text-xs font-medium uppercase tracking-wide text-indigo-700"><%= t("admin.posts.index.stats.open") %></p>
        <p class="mt-1 text-2xl font-semibold text-indigo-800"><%= @draft_count %></p>
      </div>
      <div class="rounded-xl border border-emerald-200 bg-emerald-50 p-3 shadow-sm">
        <p class="text-xs font-medium uppercase tracking-wide text-emerald-700"><%= t("admin.posts.index.stats.reviewed_today") %></p>
        <p class="mt-1 text-2xl font-semibold text-emerald-800"><%= @reviewed_today_count %></p>
      </div>
    </div>

    <div class="mt-5 flex flex-wrap items-center gap-2">
      <% { "pending" => t("admin.posts.index.filters.pending"), "open" => t("admin.posts.index.filters.open"), "reviewed" => t("admin.posts.index.filters.reviewed") }.each do |value, label| %>
        <%= link_to label, admin_posts_path(filter: value, q: @query), class: "rounded-full border px-3 py-1.5 text-xs font-semibold transition #{value == @filter ? 'border-indigo-300 bg-indigo-100 text-indigo-800' : 'border-slate-200 bg-white text-slate-600 hover:border-slate-300'}" %>
      <% end %>
    </div>

    <%= form_with url: admin_posts_path, method: :get, local: true, class: "mt-4 flex flex-wrap items-center gap-2" do |f| %>
      <%= f.hidden_field :filter, value: @filter %>
      <%= f.search_field :q, value: @query, placeholder: t("admin.posts.index.search_placeholder"), class: "w-full max-w-md rounded-lg border border-slate-300 px-3 py-2 text-sm text-slate-700 focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500" %>
      <%= f.submit t("admin.posts.index.search"), class: "rounded-lg bg-slate-900 px-3 py-2 text-sm font-semibold text-white hover:bg-slate-800" %>
    <% end %>
  </div>

  <div class="mt-6 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
    <div class="max-h-[70vh] overflow-auto">
      <table class="w-full divide-y divide-slate-200">
        <thead class="sticky top-0 z-10 bg-slate-50/95 backdrop-blur">
          <tr>
            <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500"><%= t("admin.posts.index.columns.post") %></th>
            <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500"><%= t("admin.posts.index.columns.author") %></th>
            <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500"><%= t("admin.posts.index.columns.status") %></th>
            <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500"><%= t("admin.posts.index.columns.submitted") %></th>
            <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wide text-slate-500"><%= t("admin.posts.index.columns.actions") %></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 bg-white">
          <% @revisions.each do |revision| %>
            <tr class="transition hover:bg-indigo-50/40">
              <td class="px-4 py-4 align-top">
                <p class="text-sm font-semibold text-slate-900"><%= revision.title %></p>
                <p class="mt-1 text-xs text-slate-500"><%= link_to t("admin.posts.index.open_live_post"), post_path(revision.post), class: "text-indigo-600 hover:text-indigo-500" %></p>
              </td>
              <td class="px-4 py-4 align-top text-sm text-slate-700">
                <p><%= revision.author.name.presence || revision.author.email %></p>
                <p class="text-xs text-slate-500"><%= revision.author.email %></p>
              </td>
              <td class="px-4 py-4 align-top text-sm">
                <span class="rounded-full px-2.5 py-1 text-xs font-semibold <%= revision.pending_review? ? 'bg-amber-100 text-amber-700' : (revision.draft? ? 'bg-indigo-100 text-indigo-700' : (revision.approved? ? 'bg-emerald-100 text-emerald-700' : 'bg-rose-100 text-rose-700')) %>">
                  <%= t("admin.posts.statuses.#{revision.moderation_status}") %>
                </span>
              </td>
              <td class="px-4 py-4 align-top text-sm text-slate-600">
                <%= revision.submitted_at.present? ? l(revision.submitted_at, format: :short) : "-" %>
              </td>
              <td class="px-4 py-4 text-right align-top">
                <% if revision.pending_review? %>
                  <div class="flex flex-wrap justify-end gap-2">
                    <%= form_with url: approve_admin_post_revision_path(revision), method: :post, class: "inline-flex items-center gap-2" do %>
                      <%= text_field_tag "post_revision[review_note]", nil, placeholder: t("admin.posts.index.approve_note_placeholder"), class: "w-48 rounded-md border border-slate-300 px-2 py-1.5 text-xs text-slate-700" %>
                      <%= button_tag t("admin.posts.index.approve"), type: :submit, class: "rounded-md border border-emerald-600 bg-emerald-600 px-3 py-1.5 text-xs font-semibold text-white hover:bg-emerald-700" %>
                    <% end %>

                    <%= form_with url: reject_admin_post_revision_path(revision), method: :post, class: "inline-flex items-center gap-2" do %>
                      <%= text_field_tag "post_revision[review_note]", nil, placeholder: t("admin.posts.index.reject_note_placeholder"), required: true, class: "w-48 rounded-md border border-slate-300 px-2 py-1.5 text-xs text-slate-700" %>
                      <%= button_tag t("admin.posts.index.reject"), type: :submit, class: "rounded-md border border-rose-600 bg-rose-600 px-3 py-1.5 text-xs font-semibold text-white hover:bg-rose-700" %>
                    <% end %>
                  </div>
                <% else %>
                  <span class="text-xs text-slate-500"><%= revision.review_note.presence || t("admin.posts.index.no_action") %></span>
                <% end %>
              </td>
            </tr>
          <% end %>

          <% if @revisions.empty? %>
            <tr>
              <td colspan="5" class="px-4 py-8 text-center text-sm text-slate-500"><%= t("admin.posts.index.empty") %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <div class="mt-6">
    <%= paginate @revisions %>
  </div>
</section>