<section class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8" data-controller="review-modal" data-action="keydown@window->review-modal#closeOnEscape">
  <%= turbo_stream_from "admin_posts" %>

  <div class="overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-sm">
    <div class="h-1.5 bg-gradient-to-r from-[#9e0000] via-[#cc0000] to-[#820000]"></div>
    <div class="bg-[radial-gradient(circle_at_top_left,rgba(255,0,0,0.08),transparent_34%),linear-gradient(180deg,#fff8f8_0%,#f8fafc_68%,#f8fafc_100%)] p-6 sm:p-8">
      <div class="flex flex-col items-start gap-4 sm:flex-row sm:items-start sm:justify-between">
        <div class="min-w-0">
          <h1 class="text-3xl font-bold tracking-tight text-slate-900"><%= t("admin.posts.index.title") %></h1>
          <p class="mt-2 max-w-2xl text-sm text-slate-600"><%= t("admin.posts.index.subtitle") %></p>
        </div>
      </div>

      <div class="mt-6 grid grid-cols-1 gap-3 sm:grid-cols-2 xl:grid-cols-3">
        <% admin_post_stats(
          new_post_count: @new_post_count,
          awaiting_review_count: @awaiting_review_count,
          pending_count: @pending_count,
          draft_count: @draft_count,
          reviewed_today_count: @reviewed_today_count,
          verified_today_count: @verified_today_count
        ).each do |stat| %>
          <%= render "stat_card", **stat %>
        <% end %>
      </div>

      <div class="mt-4">
        <div class="mt-2 flex flex-wrap gap-2">
          <% @pending_revisions_by_reviewer.each do |r| %>
            <div class="rounded-full border px-3 py-1.5 text-xs font-semibold bg-white">
              <%= r[:reviewer] %>: <span class="font-bold"><%= r[:count] %></span>
            </div>
          <% end %>
        </div>
      </div>

      <div class="mt-5 flex flex-wrap items-center gap-2">
        <% admin_scope_options.each do |value, label| %>
          <%= link_to label, admin_posts_path(scope: value, q: @query), class: admin_scope_chip_classes(value == @scope) %>
        <% end %>
      </div>

      <% if @scope == "posts" || @scope == "revisions" %>
      <div class="mt-4 flex flex-wrap items-center gap-2">
        <% admin_filter_options(@scope).each do |value, label| %>
          <%= link_to label, admin_posts_path(scope: @scope, filter: value, q: @query), class: admin_filter_chip_classes(value == @filter) %>
        <% end %>
      </div>
      <% end %>

      <%= form_with url: admin_posts_path, method: :get, local: true, class: "mt-4 flex flex-col gap-2 sm:flex-row sm:flex-wrap sm:items-center" do |f| %>
        <%= f.hidden_field :scope, value: @scope %>
        <%= f.hidden_field :filter, value: @filter %>
        <%= f.search_field :q, value: @query, placeholder: t("admin.posts.index.search_placeholder"), class: "h-10 w-full min-w-0 rounded-xl border border-slate-300 bg-white px-3 text-xs text-slate-700 focus:border-[#9e0000] focus:outline-none focus:ring-1 focus:ring-[#9e0000] sm:w-80" %>
        <%= f.submit t("admin.posts.index.search"), class: "inline-flex h-10 items-center justify-center rounded-lg bg-slate-900 px-4 text-xs font-semibold text-white hover:bg-slate-800" %>
      <% end %>
    </div>
  </div>

  <% if %w[all posts].include?(@scope) %>
  <section class="mt-6 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
    <div class="border-b border-slate-200 px-4 py-4 sm:px-6">
      <h2 class="text-lg font-semibold text-slate-900"><%= t("admin.posts.index.pending_posts.title") %></h2>
      <p class="mt-1 text-sm text-slate-600"><%= t("admin.posts.index.pending_posts.subtitle") %></p>
    </div>

    <div class="max-h-[50vh] overflow-auto overscroll-x-contain">
      <table class="min-w-[1080px] w-full divide-y divide-slate-200 table-auto">
        <thead class="sticky top-0 z-10 bg-slate-50/95 backdrop-blur">
          <tr>
            <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500"><%= t("admin.posts.index.pending_posts.columns.post") %></th>
            <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500"><%= t("admin.posts.index.pending_posts.columns.author") %></th>
            <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500"><%= t("admin.posts.index.pending_posts.columns.status") %></th>
            <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500"><%= t("admin.posts.index.pending_posts.columns.ai_review") %></th>
            <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500"><%= t("admin.posts.index.pending_posts.columns.submitted") %></th>
            <th class="px-2 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500"><%= t("admin.posts.index.pending_posts.columns.feedback") %></th>
            <th class="px-2 py-3 text-right text-xs font-semibold uppercase tracking-wide text-slate-500"><%= t("admin.posts.index.pending_posts.columns.actions") %></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 bg-white">
          <% @pending_posts.each_with_index do |post, i| %>
            <tr class="<%= i.even? ? "bg-white" : "bg-slate-50/40" %> transition hover:bg-red-50/40">
              <td class="min-w-[240px] px-4 py-4 align-top">
                <p class="text-sm font-semibold text-slate-900 break-words"><%= link_to post.title, post_path(post), class: "hover:text-[#9e0000]" %></p>
                <% if post.tags.any? %>
                  <div class="mt-2 flex flex-wrap gap-1.5">
                    <% post.tags.each do |tag| %>
                      <span class="rounded-full bg-slate-100 px-2 py-0.5 text-[11px] font-medium text-slate-600"><%= tag.name %></span>
                    <% end %>
                  </div>
                <% end %>
              </td>
              <td class="min-w-[180px] px-4 py-4 align-top text-sm text-slate-700">
                <p><%= post.user&.name.presence || post.user&.email %></p>
                <p class="text-xs text-slate-500"><%= post.user&.email %></p>
              </td>
              <%= render "post_status_cell", post: post %>
              <%= render "post_ai_review_cell", post: post %>
              <%= render "post_submitted_cell", post: post %>
              <td class="min-w-[100px] px-2 py-4 align-top text-sm text-slate-600">
                <% if post.unverify_reason.present? || post.author_feedback_reply.present? %>
                  <div class="flex flex-wrap items-center gap-1.5">
                    <% if post.unverify_reason.present? %>
                      <span class="inline-flex whitespace-nowrap rounded-full bg-amber-100 px-2 py-0.5 text-[11px] font-semibold text-amber-800"><%= t("admin.posts.index.pending_posts.admin_feedback") %></span>
                    <% end %>
                    <% if post.author_feedback_reply.present? %>
                      <span class="inline-flex whitespace-nowrap rounded-full bg-sky-100 px-2 py-0.5 text-[11px] font-semibold text-sky-800"><%= t("admin.posts.index.pending_posts.author_replied") %></span>
                    <% end %>
                  </div>
                  <% if post.author_replied_at.present? %>
                    <p class="mt-1 text-[11px] text-slate-500"><%= t("posts.show.feedback.updated_at_html", time: localized_time_tag(post.author_replied_at)) %></p>
                  <% end %>
                <% else %>
                  <span class="text-xs text-slate-500"><%= t("admin.posts.index.pending_posts.no_feedback") %></span>
                <% end %>
              </td>
              <td class="min-w-[90px] px-4 py-4 text-right align-top">
                <button
                  type="button"
                  class="<%= ui_action_button_classes(tone: :primary_red, size: :xs) %>"
                  data-action="review-modal#open"
                  data-review-modal-id-param="post-review-<%= post.id %>">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 shrink-0 text-[#9e0000] transition group-hover:text-[#820000]" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                    <path d="M2.5 5.75A2.25 2.25 0 014.75 3.5h10.5a2.25 2.25 0 012.25 2.25v6.5a2.25 2.25 0 01-2.25 2.25h-4.1l-2.8 2.24a.75.75 0 01-1.22-.586V14.5h-2.38A2.25 2.25 0 012.5 12.25v-6.5z" />
                  </svg>
                  <span class="inline-flex items-center leading-none"><%= t("admin.posts.index.review") %></span>
                </button>
                <%= render "post_review_modal", post: post %>
              </td>
            </tr>
          <% end %>

          <% if @pending_posts.empty? %>
            <tr>
              <td colspan="7" class="px-4 py-8 text-center text-sm text-slate-500"><%= t("admin.posts.index.pending_posts.empty") %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>

  <div class="mt-6">
    <%= paginate @pending_posts, param_name: :posts_page %>
  </div>
  <% end %>

  <% if %w[all revisions].include?(@scope) %>
  <div class="mt-6 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
    <div class="border-b border-slate-200 px-4 py-4 sm:px-6">
      <h2 class="text-lg font-semibold text-slate-900"><%= t("admin.posts.index.pending_revisions.title") %></h2>
      <p class="mt-1 text-sm text-slate-600"><%= t("admin.posts.index.pending_revisions.subtitle") %></p>
    </div>

    <div class="max-h-[70vh] overflow-auto overscroll-x-contain">
      <table class="min-w-[860px] w-full divide-y divide-slate-200 table-auto">
        <thead class="sticky top-0 z-10 bg-slate-50/95 backdrop-blur">
          <tr>
            <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500"><%= t("admin.posts.index.columns.post") %></th>
            <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500"><%= t("admin.posts.index.columns.author") %></th>
            <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500"><%= t("admin.posts.index.columns.status") %></th>
            <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500"><%= t("admin.posts.index.columns.ai_review") %></th>
            <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500"><%= t("admin.posts.index.columns.submitted") %></th>
            <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wide text-slate-500"><%= t("admin.posts.index.columns.actions") %></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 bg-white">
          <% @revisions.each_with_index do |revision, i| %>
            <tr class="<%= i.even? ? "bg-white" : "bg-slate-50/40" %> transition hover:bg-red-50/40">
              <td class="min-w-[240px] px-4 py-4 align-top">
                <p class="text-sm font-semibold text-slate-900 break-words"><%= link_to revision.title, admin_post_revision_path(revision), class: "hover:text-[#9e0000]" %></p>
              </td>
              <td class="min-w-[180px] px-4 py-4 align-top text-sm text-slate-700">
                <p><%= revision.author.name.presence || revision.author.email %></p>
                <p class="text-xs text-slate-500"><%= revision.author.email %></p>
              </td>
              <td class="min-w-[120px] px-4 py-4 align-top text-sm">
                <span class="inline-flex whitespace-nowrap rounded-full px-2.5 py-1 text-xs font-semibold <%= revision.pending_review? ? 'bg-amber-100 text-amber-700' : (revision.draft? ? 'bg-indigo-100 text-indigo-700' : (revision.approved? ? 'bg-emerald-100 text-emerald-700' : 'bg-rose-100 text-rose-700')) %>">
                  <%= t("admin.posts.statuses.#{revision.moderation_status}") %>
                </span>
              </td>
              <td class="min-w-[220px] px-4 py-4 align-top text-sm">
                <% ai_reason = ai_review_reason_for(revision) %>
                <% ai_color = case revision.ai_review_status
                when "auto_approved" then "bg-emerald-100 text-emerald-700"
                when "needs_admin_review" then "bg-amber-100 text-amber-700"
                when "failed" then "bg-rose-100 text-rose-700"
                when "in_progress" then "bg-sky-100 text-sky-700"
                else "bg-slate-100 text-slate-700"
                end %>
                <span class="inline-flex whitespace-nowrap rounded-full px-2.5 py-1 text-xs font-semibold <%= ai_color %>"><%= t("admin.posts.index.ai_statuses.#{revision.ai_review_status}") %></span>

                <% if ai_reason.present? %>
                  <p class="mt-2 max-w-[22rem] text-xs leading-5 text-slate-600" title="<%= ai_reason %>">
                    <span class="font-semibold text-slate-700"><%= t("admin.posts.index.ai_reason") %>:</span>
                    <%= truncate(ai_reason, length: 100) %>
                  </p>
                <% end %>

                <% if revision.ai_confidence.present? || revision.ai_risk_score.present? %>
                  <div class="mt-2 flex flex-wrap items-center gap-1.5">
                    <% if revision.ai_confidence.present? %>
                      <span class="inline-flex whitespace-nowrap rounded-full border border-emerald-200 bg-emerald-50 px-2 py-0.5 text-[11px] font-medium text-emerald-700">
                        <%= t("admin.posts.index.ai_confidence", value: ai_review_percentage(revision.ai_confidence)) %>
                      </span>
                    <% end %>
                    <% if revision.ai_risk_score.present? %>
                      <span class="inline-flex whitespace-nowrap rounded-full border border-amber-200 bg-amber-50 px-2 py-0.5 text-[11px] font-medium text-amber-700">
                        <%= t("admin.posts.index.ai_risk", value: ai_review_percentage(revision.ai_risk_score)) %>
                      </span>
                    <% end %>
                  </div>
                <% end %>
              </td>
              <td class="min-w-[150px] px-4 py-4 align-top text-sm text-slate-600 whitespace-nowrap">
                <%= localized_time_tag(revision.updated_at) %>
              </td>
              <td class="min-w-[220px] px-4 py-4 text-right align-top">
                <div class="grid grid-cols-2 gap-2">
                  <%= link_to(revision.pending_review? ? t("admin.posts.index.review") : t("admin.posts.index.open_draft"), admin_post_revision_path(revision), class: ui_action_button_classes(tone: :primary_red, full_width: true, size: :xs)) %>
                  <%= btn_button_to t("posts.actions.delete"), admin_post_revision_path(revision), method: :delete, variant: :danger, class: "w-full justify-center px-3 py-1.5 text-xs", data: { turbo_confirm: t("admin.posts.index.confirm_delete_revision") }, form: { class: "w-full" } %>
                </div>
              </td>
            </tr>
          <% end %>

          <% if @revisions.empty? %>
            <tr>
              <td colspan="6" class="px-4 py-8 text-center text-sm text-slate-500"><%= t("admin.posts.index.empty") %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <div class="mt-6">
    <%= paginate @revisions, param_name: :revisions_page %>
  </div>
  <% end %>
</section>