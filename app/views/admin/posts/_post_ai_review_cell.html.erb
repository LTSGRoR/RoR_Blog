<% ai_reason = ai_review_reason_for(post) %>
<% ai_color = case post.ai_review_status
when "auto_approved" then "bg-emerald-100 text-emerald-700"
when "needs_admin_review" then "bg-amber-100 text-amber-700"
when "failed" then "bg-rose-100 text-rose-700"
when "in_progress" then "bg-sky-100 text-sky-700"
else "bg-slate-100 text-slate-700"
end %>

<td id="<%= dom_id(post, :admin_ai_review) %>" class="min-w-[220px] px-4 py-4 align-top text-sm">
  <span class="inline-flex whitespace-nowrap rounded-full px-2.5 py-1 text-xs font-semibold <%= ai_color %>"><%= t("shared.posts.index.ai_statuses.#{post.ai_review_status}") %></span>

  <% if post.published? && !post.verified? && post.ai_review_failed? %>
    <div class="mt-2">
      <%= btn_button_to t("shared.posts.index.rerun_ai_review"),
                        rerun_ai_review_admin_post_path(post, locale: I18n.locale),
                        variant: :secondary,
                        method: :post,
                        form: { class: "inline-block" },
                        class: "h-8 px-3 text-xs" %>
    </div>
  <% end %>

  <% if ai_reason.present? %>
    <p class="mt-2 max-w-[22rem] text-xs leading-5 text-slate-600" title="<%= ai_reason %>">
      <span class="font-semibold text-slate-700"><%= t("shared.posts.index.ai_reason") %>:</span>
      <%= truncate(ai_reason, length: 120) %>
    </p>
  <% end %>

  <% if post.ai_confidence.present? || post.ai_risk_score.present? %>
    <div class="mt-2 flex flex-wrap items-center gap-1.5">
      <% if post.ai_confidence.present? %>
        <span class="inline-flex whitespace-nowrap rounded-full border border-emerald-200 bg-emerald-50 px-2 py-0.5 text-[11px] font-medium text-emerald-700">
          <%= t("shared.posts.index.ai_confidence", value: ai_review_percentage(post.ai_confidence)) %>
        </span>
      <% end %>
      <% if post.ai_risk_score.present? %>
        <span class="inline-flex whitespace-nowrap rounded-full border border-amber-200 bg-amber-50 px-2 py-0.5 text-[11px] font-medium text-amber-700">
          <%= t("shared.posts.index.ai_risk", value: ai_review_percentage(post.ai_risk_score)) %>
        </span>
      <% end %>
    </div>
  <% end %>

</td>
