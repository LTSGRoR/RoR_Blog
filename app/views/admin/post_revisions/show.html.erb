<section class="mx-auto max-w-6xl px-4 py-8 sm:px-6 lg:px-8">
  <div class="flex flex-wrap items-center justify-between gap-3">
    <div>
      <h1 class="text-3xl font-bold tracking-tight text-slate-900"><%= @revision.title %></h1>
      <p class="mt-2 text-sm text-slate-600"><%= t("admin.posts.show.subtitle", author: (@revision.author.name.presence || @revision.author.email)) %></p>
    </div>
    <%= btn_link_to t("admin.posts.show.back_to_queue"), admin_posts_path(scope: "revisions"), variant: :ghost %>
  </div>

  <div class="mt-6 grid gap-6 lg:grid-cols-[minmax(0,2fr)_minmax(320px,1fr)]">
    <article class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
      <div class="flex flex-wrap items-center gap-2">
        <span class="inline-flex whitespace-nowrap rounded-full bg-indigo-100 px-2.5 py-1 text-xs font-semibold text-indigo-700"><%= t("admin.posts.show.draft_badge") %></span>
        <span class="inline-flex whitespace-nowrap rounded-full px-2.5 py-1 text-xs font-semibold <%= @revision.pending_review? ? 'bg-amber-100 text-amber-700' : (@revision.draft? ? 'bg-slate-100 text-slate-700' : (@revision.approved? ? 'bg-emerald-100 text-emerald-700' : 'bg-rose-100 text-rose-700')) %>"><%= t("admin.posts.statuses.#{@revision.moderation_status}") %></span>
      </div>

      <% if @revision.tags.any? %>
        <div class="mt-4 flex flex-wrap gap-2">
          <% @revision.tags.each do |tag| %>
            <span class="rounded-full bg-slate-100 px-2.5 py-1 text-xs font-medium text-slate-700"><%= tag.name %></span>
          <% end %>
        </div>
      <% end %>

      <div class="prose prose-slate mt-6 max-w-none text-slate-800" data-controller="syntax-highlight">
        <%= @revision.body %>
      </div>
    </article>

    <aside class="space-y-6">
      <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
        <h2 class="text-lg font-semibold text-slate-900"><%= t("admin.posts.show.live_post_title") %></h2>
        <p class="mt-2 text-sm text-slate-600"><%= @revision.post.title %></p>
        <div class="mt-4">
          <%= btn_link_to t("admin.posts.index.open_live_post"), post_path(@revision.post), variant: :secondary %>
        </div>
      </section>

      <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
        <h2 class="text-lg font-semibold text-slate-900"><%= t("admin.posts.show.review_actions") %></h2>
        <div class="mt-4 space-y-3">
          <% if @revision.pending_review? %>
            <%= form_with url: approve_admin_post_revision_path(@revision), method: :post, class: "space-y-2" do %>
              <%= text_field_tag "post_revision[review_note]", nil, placeholder: t("admin.posts.index.approve_note_placeholder"), class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm text-slate-700" %>
              <%= button_tag t("admin.posts.index.approve"), type: :submit, data: { turbo_confirm: t("admin.posts.index.confirm_approve") }, class: "w-full rounded-md border border-emerald-600 bg-emerald-600 px-3 py-2 text-sm font-semibold text-white hover:bg-emerald-700" %>
            <% end %>

            <%= form_with url: reject_admin_post_revision_path(@revision), method: :post, class: "space-y-2" do %>
              <%= text_area_tag "post_revision[review_note]", nil, placeholder: t("admin.posts.index.reject_note_placeholder"), required: true, rows: 4, class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm text-slate-700" %>
              <%= button_tag t("admin.posts.index.reject"), type: :submit, class: "w-full rounded-md border border-rose-600 bg-rose-600 px-3 py-2 text-sm font-semibold text-white hover:bg-rose-700" %>
            <% end %>
          <% elsif @revision.draft? %>
            <p class="rounded-lg border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-600"><%= t("admin.posts.show.draft_notice") %></p>
          <% else %>
            <p class="rounded-lg border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-600"><%= t("admin.posts.show.review_complete") %></p>
          <% end %>

          <%= btn_button_to t("posts.actions.delete"), admin_post_revision_path(@revision), method: :delete, variant: :danger, class: "w-full", data: { turbo_confirm: t("admin.posts.index.confirm_delete_revision") }, form: { class: "w-full" } %>
        </div>
      </section>
    </aside>
  </div>
</section>