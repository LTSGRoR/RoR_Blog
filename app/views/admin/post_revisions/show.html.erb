<section class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
  <div class="mb-6 flex flex-wrap items-center justify-between gap-3">
    <div>
      <p class="re-page-kicker"><%= t("admin.posts.show.section_kicker") %></p>
      <h1 class="text-3xl font-bold tracking-tight text-slate-900"><%= @revision.title %></h1>
      <p class="mt-2 text-sm text-slate-600"><%= t("admin.posts.show.subtitle", author: (@revision.author.name.presence || @revision.author.email)) %></p>
    </div>
    <%= btn_link_to t("admin.posts.show.back_to_queue"), admin_posts_path(scope: "revisions"), variant: :ghost %>
  </div>

  <div class="grid gap-6 lg:grid-cols-12">
    <div class="space-y-6 lg:col-span-8">
      <article class="rounded-2xl border border-[#e2e8f0] bg-white p-6 shadow-sm">
        <div class="flex flex-wrap items-center gap-2">
          <span class="inline-flex whitespace-nowrap rounded-full bg-[#fff1f2] px-2.5 py-1 text-xs font-semibold text-[#9e0000]"><%= t("admin.posts.show.draft_badge") %></span>
          <span class="inline-flex whitespace-nowrap rounded-full px-2.5 py-1 text-xs font-semibold <%= @revision.pending_review? ? 'bg-amber-100 text-amber-700' : (@revision.draft? ? 'bg-slate-100 text-slate-700' : (@revision.approved? ? 'bg-emerald-100 text-emerald-700' : 'bg-rose-100 text-rose-700')) %>"><%= t("admin.posts.statuses.#{@revision.moderation_status}") %></span>
        </div>

        <% if @revision.tags.any? %>
          <div class="mt-4 flex flex-wrap gap-2">
            <% @revision.tags.each do |tag| %>
              <span class="rounded-full bg-slate-100 px-2.5 py-1 text-xs font-medium text-slate-700">#<%= tag.name %></span>
            <% end %>
          </div>
        <% end %>

        <div class="mt-6 border-t border-slate-200 pt-6">
          <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-600"><%= t("admin.posts.show.content_preview") %></h2>
          <div class="prose prose-slate mt-4 max-w-none text-slate-800" data-controller="syntax-highlight">
            <%= @revision.body %>
          </div>
        </div>
      </article>
    </div>

    <aside class="space-y-6 lg:col-span-4">
      <section class="rounded-2xl border border-[#e2e8f0] bg-white p-5 shadow-sm">
        <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-600"><%= t("admin.posts.show.metadata") %></h2>
        <dl class="mt-4 space-y-3 text-sm">
          <div>
            <dt class="text-slate-500"><%= t("admin.posts.show.author_label") %></dt>
            <dd class="font-medium text-slate-800"><%= @revision.author.name.presence || @revision.author.email %></dd>
          </div>
          <div>
            <dt class="text-slate-500"><%= t("admin.posts.show.submitted_label") %></dt>
            <dd class="font-medium text-slate-800"><%= @revision.submitted_at.present? ? l(@revision.submitted_at, format: :short) : "-" %></dd>
          </div>
          <div>
            <dt class="text-slate-500"><%= t("admin.posts.show.updated_label") %></dt>
            <dd class="font-medium text-slate-800"><%= l(@revision.updated_at, format: :short) %></dd>
          </div>
          <% if @revision.reviewed_at.present? %>
            <div>
              <dt class="text-slate-500"><%= t("admin.posts.show.reviewed_label") %></dt>
              <dd class="font-medium text-slate-800"><%= l(@revision.reviewed_at, format: :short) %></dd>
            </div>
          <% end %>
          <% if @revision.reviewer.present? %>
            <div>
              <dt class="text-slate-500"><%= t("admin.posts.show.reviewer_label") %></dt>
              <dd class="font-medium text-slate-800"><%= @revision.reviewer.name.presence || @revision.reviewer.email %></dd>
            </div>
          <% end %>
        </dl>
      </section>

      <section class="rounded-2xl border border-[#e2e8f0] bg-white p-5 shadow-sm">
        <h2 class="text-lg font-semibold text-slate-900"><%= t("admin.posts.show.live_post_title") %></h2>
        <p class="mt-2 text-sm text-slate-600"><%= @revision.post.title %></p>
        <div class="mt-4">
          <%= link_to post_path(@revision.post), class: "group inline-flex items-center gap-1.5 rounded-lg border border-[#fecaca] bg-[#fff1f2] px-3 py-1.5 text-xs font-semibold text-[#9e0000] shadow-sm transition hover:-translate-y-0.5 hover:border-[#fda4af] hover:bg-[#ffe4e6] hover:text-[#820000] hover:shadow focus:outline-none focus:ring-2 focus:ring-[#fda4af] focus:ring-offset-1" do %>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 shrink-0 text-[#9e0000] transition group-hover:text-[#820000]" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M10 3.5c-4.5 0-7.75 3.44-8.85 5.02a1.75 1.75 0 000 1.96C2.25 12.06 5.5 15.5 10 15.5s7.75-3.44 8.85-5.02a1.75 1.75 0 000-1.96C17.75 6.94 14.5 3.5 10 3.5zm0 9.5A4.75 4.75 0 1110 3.5a4.75 4.75 0 010 9.5zm0-2.5a2.25 2.25 0 100-4.5 2.25 2.25 0 000 4.5z" /></svg>
            <span><%= t("admin.posts.index.open_live_post") %></span>
          <% end %>
        </div>
      </section>

      <section class="rounded-2xl border border-[#e2e8f0] bg-white p-5 shadow-sm">
        <h2 class="text-lg font-semibold text-slate-900"><%= t("admin.posts.show.review_actions") %></h2>
        <div class="mt-4 space-y-3">
          <% if @revision.pending_review? %>
            <%= form_with url: approve_admin_post_revision_path(@revision), method: :post, class: "space-y-2" do %>
              <%= text_field_tag "post_revision[review_note]", nil, placeholder: t("admin.posts.index.approve_note_placeholder"), class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm text-slate-700 focus:border-[#9e0000] focus:outline-none focus:ring-1 focus:ring-[#9e0000]" %>
              <%= button_tag type: :submit, data: { turbo_confirm: t("admin.posts.index.confirm_approve") }, class: "group inline-flex w-full items-center justify-center gap-1.5 rounded-lg border border-emerald-200 bg-emerald-50 px-3 py-2 text-sm font-semibold text-emerald-700 shadow-sm transition hover:-translate-y-0.5 hover:border-emerald-300 hover:bg-emerald-100 hover:text-emerald-800 hover:shadow focus:outline-none focus:ring-2 focus:ring-emerald-300 focus:ring-offset-1" do %>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0 text-emerald-500 transition group-hover:text-emerald-700" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-7.25 7.25a1 1 0 01-1.414 0l-3.25-3.25a1 1 0 111.414-1.414l2.543 2.543 6.543-6.543a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
                <span><%= t("admin.posts.index.approve") %></span>
              <% end %>
            <% end %>

            <%= form_with url: reject_admin_post_revision_path(@revision), method: :post, class: "space-y-2" do %>
              <%= text_area_tag "post_revision[review_note]", nil, placeholder: t("admin.posts.index.reject_note_placeholder"), required: true, rows: 4, class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm text-slate-700 focus:border-[#9e0000] focus:outline-none focus:ring-1 focus:ring-[#9e0000]" %>
              <%= button_tag type: :submit, class: "group inline-flex w-full items-center justify-center gap-1.5 rounded-lg border border-rose-200 bg-rose-50 px-3 py-2 text-sm font-semibold text-rose-700 shadow-sm transition hover:-translate-y-0.5 hover:border-rose-300 hover:bg-rose-100 hover:text-rose-800 hover:shadow focus:outline-none focus:ring-2 focus:ring-rose-300 focus:ring-offset-1" do %>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0 text-rose-500 transition group-hover:text-rose-700" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" /></svg>
                <span><%= t("admin.posts.index.reject") %></span>
              <% end %>
            <% end %>
          <% elsif @revision.draft? %>
            <p class="rounded-lg border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-600"><%= t("admin.posts.show.draft_notice") %></p>
          <% else %>
            <p class="rounded-lg border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-600"><%= t("admin.posts.show.review_complete") %></p>
          <% end %>

          <%= button_to admin_post_revision_path(@revision), method: :delete, class: "group inline-flex w-full items-center justify-center gap-1.5 rounded-lg border border-rose-200 bg-white px-4 py-2 text-sm font-semibold text-rose-600 shadow-sm transition hover:-translate-y-0.5 hover:border-rose-300 hover:bg-rose-50 hover:text-rose-700 hover:shadow focus:outline-none focus:ring-2 focus:ring-rose-300 focus:ring-offset-1", data: { turbo_confirm: t("admin.posts.index.confirm_delete_revision") }, form: { class: "w-full" } do %>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0 text-rose-500 transition group-hover:text-rose-700" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M6 4.75A1.75 1.75 0 017.75 3h4.5A1.75 1.75 0 0114 4.75V5h2.25a.75.75 0 010 1.5h-.56l-.63 8.17A2 2 0 0113.06 16H6.94a2 2 0 01-1.99-1.83L4.31 6.5h-.56a.75.75 0 010-1.5H6v-.25zM7.5 5h5v-.25a.25.25 0 00-.25-.25h-4.5a.25.25 0 00-.25.25V5zm.75 3a.75.75 0 00-1.5 0v4a.75.75 0 001.5 0V8zm4 0a.75.75 0 00-1.5 0v4a.75.75 0 001.5 0V8z" clip-rule="evenodd" /></svg>
            <span><%= t("posts.actions.delete") %></span>
          <% end %>
        </div>
      </section>
    </aside>
  </div>
</section>