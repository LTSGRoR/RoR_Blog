<section class="mx-auto max-w-5xl px-4 py-8 sm:px-6 lg:px-8">
  <div class="rounded-3xl border border-slate-200/70 bg-gradient-to-br from-white via-slate-50 to-slate-100 p-6 shadow-sm sm:p-8">
    <h1 class="text-3xl font-bold tracking-tight text-slate-900"><%= t("admin.moderation_settings.edit.title") %></h1>
    <p class="mt-2 max-w-3xl text-sm text-slate-600"><%= t("admin.moderation_settings.edit.subtitle") %></p>

    <%= form_with model: @setting, url: admin_moderation_setting_path, method: :patch, class: "mt-6 space-y-6" do |f| %>
      <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
        <div>
          <%= f.label :provider, t("admin.moderation_settings.fields.provider"), class: "mb-1 block text-sm font-semibold text-slate-700" %>
          <%= f.text_field :provider, class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-sm text-slate-700" %>
        </div>
        <div>
          <%= f.label :ai_model, t("admin.moderation_settings.fields.ai_model"), class: "mb-1 block text-sm font-semibold text-slate-700" %>
          <%= f.text_field :ai_model, class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-sm text-slate-700" %>
        </div>
        <div>
          <%= f.label :auto_approve_threshold, t("admin.moderation_settings.fields.auto_approve_threshold"), class: "mb-1 block text-sm font-semibold text-slate-700" %>
          <%= f.number_field :auto_approve_threshold, min: 0, max: 1, step: 0.01, class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-sm text-slate-700" %>
        </div>
        <div>
          <%= f.label :request_timeout_seconds, t("admin.moderation_settings.fields.request_timeout_seconds"), class: "mb-1 block text-sm font-semibold text-slate-700" %>
          <%= f.number_field :request_timeout_seconds, min: 1, class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-sm text-slate-700" %>
        </div>
        <div>
          <%= f.label :max_retries, t("admin.moderation_settings.fields.max_retries"), class: "mb-1 block text-sm font-semibold text-slate-700" %>
          <%= f.number_field :max_retries, min: 1, class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-sm text-slate-700" %>
        </div>
        <div class="flex items-center gap-2 pt-7">
          <%= f.check_box :auto_review_enabled, class: "rounded border-slate-300 text-indigo-600" %>
          <%= f.label :auto_review_enabled, t("admin.moderation_settings.fields.auto_review_enabled"), class: "text-sm font-semibold text-slate-700" %>
        </div>
      </div>

      <div>
        <%= f.label :new_post_instruction, t("admin.moderation_settings.fields.new_post_instruction"), class: "mb-1 block text-sm font-semibold text-slate-700" %>
        <%= f.text_area :new_post_instruction, rows: 8, class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-sm text-slate-700" %>
      </div>

      <div>
        <%= f.label :revision_instruction, t("admin.moderation_settings.fields.revision_instruction"), class: "mb-1 block text-sm font-semibold text-slate-700" %>
        <%= f.text_area :revision_instruction, rows: 8, class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-sm text-slate-700" %>
      </div>

      <div class="flex justify-end">
        <%= f.submit t("admin.moderation_settings.edit.save"), class: "rounded-lg bg-slate-900 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-800" %>
      </div>
    <% end %>
  </div>
</section>
