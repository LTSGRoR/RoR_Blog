<section class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
  <%= render layout: "header", locals: { title: "#{t('admin.tags.manage')} ##{@tag_label}" } do %>
    <p class="mt-4 text-sm font-medium text-slate-700"><%= t("admin.tags.usage", posts: @posts_count, revisions: @revisions_count) %></p>
  <% end %>
  <% if @tag.errors.any? %>
    <div role="alert" class="mt-6 rounded-2xl border border-red-200 bg-red-50 p-4 text-sm text-red-800"><%= @tag.errors.full_messages.to_sentence %></div>
  <% end %>
  <div class="mt-6 grid gap-6 lg:grid-cols-2">
    <section class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
      <h2 class="text-lg font-semibold text-slate-900"><%= t("admin.tags.rename") %></h2>
      <%= form_with model: @tag, url: admin_tag_path(@tag), method: :patch, class: "mt-4 space-y-3" do |f| %>
        <%= f.label :name, t("admin.tags.name"), class: "block text-sm font-medium text-slate-700" %>
        <%= f.text_field :name, required: true, class: "w-full rounded-xl border border-slate-300 px-3 py-2 text-sm focus:border-[#9e0000] focus:outline-none focus:ring-1 focus:ring-[#9e0000]" %>
        <%= f.submit t("admin.tags.rename"), class: "rounded-lg bg-slate-900 px-4 py-2 text-xs font-semibold text-white hover:bg-slate-800" %>
      <% end %>
    </section>
    <section class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
      <h2 class="text-lg font-semibold text-slate-900"><%= t("admin.tags.merge") %></h2>
      <p class="mt-2 text-sm text-slate-600"><%= t("admin.tags.merge_help") %></p>
      <%= form_with url: merge_admin_tag_path(@tag), method: :post, class: "mt-4 space-y-3", data: { controller: "tag-merge", "tag-merge-url-value": search_admin_tags_path(exclude_id: @tag.id), "tag-merge-empty-value": t("admin.tags.empty"), "tag-merge-error-value": t("admin.tags.search_error"), action: "click@window->tag-merge#closeOutside" } do |f| %>
        <%= f.label :target_name, t("admin.tags.target"), class: "block text-sm font-medium text-slate-700" %>
        <div class="relative">
          <%= f.text_field :target_name, value: params[:target_name], required: true, autocomplete: "off", placeholder: t("admin.tags.search_placeholder"), data: { "tag-merge-target": "input", action: "input->tag-merge#search focus->tag-merge#search keydown.esc->tag-merge#clear" }, aria: { describedby: "merge-search-help" }, class: "w-full rounded-xl border border-slate-300 px-3 py-2 text-sm focus:border-[#9e0000] focus:outline-none focus:ring-1 focus:ring-[#9e0000]" %>
          <div data-tag-merge-target="results" style="max-height: 202px" class="absolute left-0 right-0 top-full z-20 mt-1 overflow-y-auto rounded-xl border border-slate-200 bg-white shadow-lg empty:hidden"></div>
        </div>
        <p id="merge-search-help" class="text-xs text-slate-500"><%= t("admin.tags.search_help") %></p>
        <%= f.submit t("admin.tags.merge"), data: { turbo_confirm: t("admin.tags.merge_confirm", name: @tag_label) }, class: "rounded-lg bg-slate-900 px-4 py-2 text-xs font-semibold text-white hover:bg-slate-800" %>
      <% end %>
    </section>
  </div>
  <section class="mt-6 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
    <h2 class="text-lg font-semibold text-slate-900"><%= t("admin.tags.affected") %></h2>
    <div class="mt-4 grid gap-6 lg:grid-cols-2">
      <div><h3 class="text-sm font-semibold text-slate-700"><%= t("admin.tags.posts") %></h3>
        <% @posts.each do |post| %><p class="mt-2 text-sm"><%= link_to post.title, post_path(post), class: "text-slate-700 hover:text-[#9e0000]" %></p><% end %>
        <%= paginate @posts, param_name: :posts_page %>
      </div>
      <div><h3 class="text-sm font-semibold text-slate-700"><%= t("admin.tags.revisions") %></h3>
        <% @revisions.each do |revision| %><p class="mt-2 text-sm"><%= link_to revision.title, admin_post_revision_path(revision), class: "text-slate-700 hover:text-[#9e0000]" %></p><% end %>
        <%= paginate @revisions, param_name: :revisions_page %>
      </div>
    </div>
  </section>
  <section class="mt-6 rounded-2xl border border-red-200 bg-white p-6 shadow-sm">
    <h2 class="text-lg font-semibold text-slate-900"><%= t("admin.tags.delete") %></h2>
    <p class="mt-2 text-sm text-slate-600"><%= t("admin.tags.delete_help") %></p>
    <%= button_to t("admin.tags.delete"), admin_tag_path(@tag), method: :delete, form: { class: "mt-4", data: { turbo_confirm: t("admin.tags.delete_confirm", name: @tag_label, posts: @posts_count, revisions: @revisions_count) } }, class: "rounded-lg bg-[#9e0000] px-4 py-2 text-xs font-semibold text-white hover:bg-[#820000]" %>
  </section>
</section>
