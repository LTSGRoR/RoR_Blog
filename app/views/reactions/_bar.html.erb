<%= turbo_frame_tag dom_id(reactable, :reactions) do %>
  <% compact = local_assigns.fetch(:compact, false) %>
  <% warden_available = request&.env&.key?("warden") %>
  <% signed_in_viewer = warden_available && user_signed_in? %>
  <% render_reaction_buttons = warden_available ? signed_in_viewer : true %>
  <% viewer_id = signed_in_viewer ? current_user.id : nil %>
  <div class="<%= compact ? 'mt-3' : 'mt-8' %> flex flex-wrap items-center gap-2">
    <% Reaction.emoji_types.each_key do |key| %>
      <% emoji = Reaction::EMOJI_MAP[key] %>
      <% total = reactable.reactions.where(emoji_type: key).count %>
      <% reacted = viewer_id.present? && reactable.reactions.exists?(user_id: viewer_id, emoji_type: key) %>

      <% if render_reaction_buttons %>
        <%= button_to reactions_path,
                      params: {
                        reactable_type: reactable.class.name,
                        reactable_id: reactable.id,
                        reaction: { emoji_type: key }
                      },
                      method: :post,
                      form: { class: "inline-block" },
                      class: "inline-flex items-center gap-2 rounded-full border px-3 py-2 text-sm transition #{reacted ? 'border-indigo-500 bg-indigo-50 text-indigo-700' : 'border-slate-300 bg-white text-slate-700 hover:bg-slate-50'}" do %>
          <span><%= emoji %></span>
          <span><%= total %></span>
        <% end %>
      <% else %>
        <span class="inline-flex items-center gap-2 rounded-full border border-slate-200 bg-slate-50 px-3 py-2 text-sm text-slate-600">
          <span><%= emoji %></span>
          <span><%= total %></span>
        </span>
      <% end %>
    <% end %>
  </div>
<% end %>
