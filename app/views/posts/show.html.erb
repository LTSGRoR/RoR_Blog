<% content_for :title, @post.title %>
<% content_for :og_title, @post.title %>
<% if @post.body.present? %>
  <% content_for :og_description, truncate(@post.body.to_plain_text, length: 160) %>
  <% content_for :meta_description, truncate(@post.body.to_plain_text, length: 160) %>
<% end %>
<% content_for :og_type, "article" %>
<% content_for :head do %>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": "<%= j @post.title %>",
    "author": {
      "@type": "Person",
      "name": "<%= j(@post.user&.name.presence || @post.user&.email) %>"
    },
    "datePublished": "<%= @post.created_at.iso8601 %>",
    "dateModified": "<%= @post.updated_at.iso8601 %>"
  }
  </script>
<% end %>

<div class="max-w-6xl mx-auto py-10">
  <%= turbo_stream_from @post %>

  <article class="mx-auto max-w-4xl re-card bg-white px-6 py-8 sm:px-10">
    <header class="mb-8 text-center">
      <% if @post.tags.any? %>
        <div class="mb-4 flex flex-wrap justify-center gap-2">
          <% @post.tags.limit(3).each do |tag| %>
            <span class="re-chip">#<%= tag.name %></span>
          <% end %>
        </div>
      <% end %>

      <h1 class="re-heading text-4xl font-extrabold leading-tight text-slate-900 sm:text-5xl"><%= @post.title %></h1>

      <div class="mt-5 flex flex-wrap items-center justify-center gap-x-3 gap-y-2 text-sm text-slate-500">
        <% if @post.user.present? %>
          <%= link_to user_path(@post.user), class: "flex items-center gap-2 font-medium text-slate-700 transition hover:text-[#9e0000]" do %>
            <% if @post.user.avatar.attached? %>
              <%= image_tag @post.user.avatar.variant(resize_to_fill: [44, 44]), class: "h-11 w-11 rounded-full border border-slate-200 object-cover", alt: @post.user.name.presence || @post.user.email, width: 44, height: 44 %>
            <% else %>
              <div class="flex h-11 w-11 items-center justify-center rounded-full bg-red-100 text-sm font-bold text-[#9e0000]"><%= (@post.user.name.presence || @post.user.email).to_s.first(1).upcase %></div>
            <% end %>
            <span class="re-label text-sm text-slate-700"><%= @post.user.name.presence || @post.user.email %></span>
          <% end %>
        <% else %>
          <span><%= t("common.unknown") %></span>
        <% end %>
        <span class="text-slate-300">•</span>
        <span class="re-label text-xs text-slate-500"><%= l(@post.created_at, format: :short) %></span>
        <span class="text-slate-300">•</span>
        <span class="re-label text-xs text-slate-500"><%= pluralize((@post.body.to_plain_text.split.size / 220.0).ceil, "min") %> read</span>
      </div>
      <div class="mt-6 overflow-hidden rounded-xl border border-[#e2e8f0] shadow-sm">
        <img src="https://images.unsplash.com/photo-1518770660439-4636190af475?auto=format&fit=crop&w=1600&q=80" alt="Technical article hero" class="h-[420px] w-full object-cover" />
      </div>
    </header>

    <div class="prose prose-slate max-w-none text-lg leading-8 text-slate-800" data-controller="syntax-highlight">
      <%= @post.body %>
    </div>

    <% if @active_revision.present? %>
      <section class="mt-8 rounded-lg border border-indigo-200 bg-indigo-50 p-4">
        <h2 class="re-label text-xs font-semibold uppercase tracking-wide text-indigo-800"><%= t("post_revisions.status_panel.title") %></h2>
        <p class="mt-2 text-sm text-indigo-900">
          <%= t("post_revisions.status_panel.current_status", status: t("admin.posts.statuses.#{@active_revision.moderation_status}")) %>
        </p>
        <% if @active_revision.submitted_at.present? %>
          <p class="mt-1 text-xs text-indigo-700"><%= t("post_revisions.status_panel.submitted_at", time: l(@active_revision.submitted_at, format: :short)) %></p>
        <% end %>
        <% if @active_revision.review_note.present? %>
          <div class="mt-3 rounded-md border border-indigo-200 bg-white px-3 py-2 text-sm text-slate-700"><%= @active_revision.review_note %></div>
        <% end %>
        <% if current_user == @post.user %>
          <div class="mt-3">
            <% label = @active_revision.pending_review? ? t("post_revisions.status_panel.view_revision") : t("post_revisions.status_panel.open_editor") %>
            <%= btn_link_to label, edit_post_revision_path(@post), variant: :secondary %>
          </div>
        <% end %>
      </section>
    <% elsif @rejected_revision.present? %>
      <section class="mt-8 rounded-xl border border-amber-200 bg-amber-50/80 p-5">
        <div class="flex flex-wrap items-start justify-between gap-3">
          <div>
            <h2 class="text-sm font-semibold uppercase tracking-wide text-amber-800"><%= t("post_revisions.status_panel.rejected_title") %></h2>
            <p class="mt-2 text-sm text-amber-950"><%= t("post_revisions.status_panel.rejected_detail") %></p>
          </div>
          <% if @rejected_revision.reviewed_at.present? %>
            <p class="text-xs font-medium text-amber-700"><%= t("post_revisions.status_panel.reviewed_at", time: l(@rejected_revision.reviewed_at, format: :short)) %></p>
          <% end %>
        </div>

        <% if @rejected_revision.review_note.present? %>
          <div class="mt-4 rounded-lg border border-amber-200 bg-white px-4 py-3">
            <p class="text-xs font-semibold uppercase tracking-wide text-amber-700"><%= t("post_revisions.status_panel.review_note_label") %></p>
            <p class="mt-2 whitespace-pre-wrap text-sm leading-6 text-slate-700"><%= @rejected_revision.review_note %></p>
          </div>
        <% end %>

        <% if current_user == @post.user %>
          <div class="mt-4">
            <%= btn_link_to t("post_revisions.status_panel.start_new_revision"), new_post_revision_path(@post), variant: :secondary %>
          </div>
        <% end %>
      </section>
    <% end %>

    <section class="mt-10 flex items-center justify-between border-y border-[#e2e8f0] py-4">
      <span class="re-label text-xs text-slate-500">Share this article</span>
      <div class="flex items-center gap-2">
        <button type="button" class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-[#e2e8f0] text-slate-500 hover:text-[#9e0000]">↗</button>
        <button type="button" class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-[#e2e8f0] text-slate-500 hover:text-[#9e0000]">⛓</button>
      </div>
    </section>

    <section class="mt-8 rounded-xl border border-[#e2e8f0] bg-[#f1f5f9] p-5 sm:p-6">
      <div class="flex flex-col items-center gap-4 text-center sm:flex-row sm:items-start sm:text-left">
        <% if @post.user&.avatar&.attached? %>
          <%= image_tag @post.user.avatar.variant(resize_to_fill: [96, 96]), class: "h-24 w-24 rounded-full border-4 border-white object-cover shadow-sm", alt: @post.user.name.presence || @post.user.email, width: 96, height: 96 %>
        <% else %>
          <img src="https://images.unsplash.com/photo-1560250097-0b93528c311a?auto=format&fit=crop&w=300&q=80" alt="Author" class="h-24 w-24 rounded-full border-4 border-white object-cover shadow-sm" />
        <% end %>
        <div>
          <h3 class="re-heading text-2xl font-semibold text-slate-900"><%= @post.user&.name.presence || @post.user&.email || t("common.unknown") %></h3>
          <p class="mt-1 text-sm text-slate-500">Principal Engineer @ Rails Engineering</p>
          <p class="mt-3 text-slate-700">Passionate about systems architecture, security, and the Ruby ecosystem.</p>
        </div>
      </div>
    </section>

    <% if @post.interactions_enabled? %>
      <section class="mt-8 rounded-lg border border-slate-200 bg-slate-50 p-4">
        <p class="re-label text-xs font-semibold uppercase tracking-wide text-slate-600"><%= t("posts.show.reactions") %></p>
        <div class="mt-3">
          <%= render "reactions/bar", reactable: @post %>
        </div>
      </section>

      <section class="mt-8 border-t border-slate-200 pt-6">
        <h2 class="re-heading text-2xl font-semibold text-slate-900"><%= t("posts.show.comments") %></h2>

        <%= turbo_frame_tag dom_id(@post, :comments_section), class: "mt-4 block" do %>
          <%= turbo_frame_tag dom_id(@post, :comments), class: "block space-y-4" do %>
            <%= render @comments %>
          <% end %>

          <% if @has_more_comments %>
            <div class="mt-5">
              <%= link_to "Load more comments",
                    post_path(@post, comments_visible: @comments_visible + @comments_increment),
                    data: { turbo_frame: dom_id(@post, :comments_section) },
                    class: "inline-flex items-center rounded-md border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50" %>
            </div>
          <% end %>
        <% end %>

        <% if user_signed_in? %>
          <%= render "comments/form", post: @post, comment: @comment %>
        <% else %>
          <p class="mt-6 text-sm text-slate-600">
            <%= link_to t("nav.sign_in"), new_user_session_path, class: "font-medium text-[#9e0000] hover:text-[#820000]" %>
            <%= t("posts.show.join_conversation") %>
          </p>
        <% end %>
      </section>
    <% end %>

    <footer class="mt-8 border-t border-slate-200 pt-5">
      <%= render "post_actions", post: @post, show_back: true %>
    </footer>
  </article>

  <% if @related_posts.any? %>
    <section class="mx-auto mt-14 max-w-6xl">
      <h2 class="re-heading mb-6 text-3xl font-bold text-slate-900">Recommended Reading</h2>
      <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
        <% @related_posts.each do |related_post| %>
          <article class="group re-card overflow-hidden p-4">
            <div class="mb-3 aspect-video overflow-hidden rounded-lg border border-[#e2e8f0]">
              <img src="https://images.unsplash.com/photo-1517694712202-14dd9538aa97?auto=format&fit=crop&w=800&q=80" alt="Recommended article" class="h-full w-full object-cover transition duration-300 group-hover:scale-105" />
            </div>
            <p class="re-label text-[10px] font-semibold uppercase tracking-wider text-[#9e0000]"><%= related_post.tags.first&.name || "Rails" %></p>
            <h3 class="re-heading mt-2 text-xl font-semibold leading-snug text-slate-900 transition group-hover:text-[#9e0000]"><%= link_to related_post.title, post_path(related_post) %></h3>
            <p class="mt-2 text-sm text-slate-600"><%= truncate(related_post.body.to_plain_text, length: 110) %></p>
          </article>
        <% end %>
      </div>
    </section>
  <% end %>
</div>
