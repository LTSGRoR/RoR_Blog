<section class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
  <div class="rounded-3xl border border-slate-200/70 bg-gradient-to-br from-white via-slate-50 to-slate-100 p-6 shadow-sm sm:p-8">
    <div class="flex flex-wrap items-start justify-between gap-4">
      <div>
        <h1 class="text-3xl font-bold tracking-tight text-slate-900"><%= t("posts.mine.title") %></h1>
        <p class="mt-2 max-w-2xl text-sm text-slate-600"><%= t("posts.mine.subtitle") %></p>
      </div>
      <%= btn_link_to t("posts.index.new_post"), new_post_path, variant: :primary %>
    </div>

    <div class="mt-6 grid grid-cols-1 gap-3 sm:grid-cols-3">
      <div class="rounded-xl border border-slate-200 bg-white p-3 shadow-sm">
        <p class="text-xs font-medium uppercase tracking-wide text-slate-500"><%= t("posts.mine.stats.drafts") %></p>
        <p class="mt-1 text-2xl font-semibold text-slate-900"><%= @draft_posts_count %></p>
      </div>
      <div class="rounded-xl border border-amber-200 bg-amber-50 p-3 shadow-sm">
        <p class="text-xs font-medium uppercase tracking-wide text-amber-700"><%= t("posts.mine.stats.needs_review") %></p>
        <p class="mt-1 text-2xl font-semibold text-amber-800"><%= @needs_review_posts_count %></p>
      </div>
      <div class="rounded-xl border border-emerald-200 bg-emerald-50 p-3 shadow-sm">
        <p class="text-xs font-medium uppercase tracking-wide text-emerald-700"><%= t("posts.mine.stats.published") %></p>
        <p class="mt-1 text-2xl font-semibold text-emerald-800"><%= @published_posts_count %></p>
      </div>
    </div>

    <%= form_with url: mine_posts_path, method: :get, local: true, class: "mt-4 flex flex-wrap items-center gap-2" do |f| %>
      <%= f.search_field :q, value: @query, placeholder: t("posts.mine.search_placeholder"), class: "w-full max-w-md rounded-lg border border-slate-300 px-3 py-2 text-sm text-slate-700 focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500" %>
      <%= f.submit t("posts.mine.search"), class: "rounded-lg bg-slate-900 px-3 py-2 text-sm font-semibold text-white hover:bg-slate-800" %>
    <% end %>
  </div>

  <section class="mt-6 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
    <div class="border-b border-slate-200 px-4 py-4 sm:px-6">
      <h2 class="text-lg font-semibold text-slate-900"><%= t("posts.mine.list.title") %></h2>
      <p class="mt-1 text-sm text-slate-600"><%= t("posts.mine.list.subtitle") %></p>
    </div>

    <div class="overflow-auto">
      <table class="w-full divide-y divide-slate-200">
        <thead class="bg-slate-50/95">
          <tr>
            <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500"><%= t("posts.mine.columns.post") %></th>
            <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500"><%= t("posts.mine.columns.visibility") %></th>
            <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500"><%= t("posts.mine.columns.revision") %></th>
            <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500"><%= t("posts.mine.columns.updated") %></th>
            <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wide text-slate-500"><%= t("posts.mine.columns.actions") %></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 bg-white">
          <% @posts.each_with_index do |post, i| %>
            <% revision = post.active_revision %>
            <tr class="<%= i.even? ? "bg-white" : "bg-slate-50/40" %>">
              <td class="px-4 py-4 align-top">
                <p class="text-sm font-semibold text-slate-900"><%= link_to post.title, post_path(post), class: "hover:text-indigo-600" %></p>
                <% if post.tags.any? %>
                  <div class="mt-2 flex flex-wrap gap-1.5">
                    <% post.tags.each do |tag| %>
                      <span class="rounded-full bg-slate-100 px-2 py-0.5 text-[11px] font-medium text-slate-600"><%= tag.name %></span>
                    <% end %>
                  </div>
                <% end %>
              </td>
              <td class="px-4 py-4 align-top text-sm">
                <% if post.draft? %>
                  <span class="rounded-full bg-slate-100 px-2.5 py-1 text-xs font-semibold text-slate-700"><%= t("posts.mine.badges.draft") %></span>
                <% elsif post.verified? %>
                  <span class="rounded-full bg-emerald-100 px-2.5 py-1 text-xs font-semibold text-emerald-700"><%= t("posts.mine.badges.published") %></span>
                <% else %>
                  <span class="rounded-full bg-amber-100 px-2.5 py-1 text-xs font-semibold text-amber-700"><%= t("posts.mine.badges.awaiting_review") %></span>
                <% end %>
                <% if post.unverify_reason.present? %>
                  <div class="mt-3 max-w-xs rounded-md border border-amber-200 bg-amber-50 px-3 py-2">
                    <p class="text-[11px] font-semibold uppercase tracking-wide text-amber-700"><%= t("posts.show.feedback.title") %></p>
                    <p class="mt-1 whitespace-pre-wrap text-xs text-amber-950"><%= post.unverify_reason %></p>
                  </div>
                <% end %>
                <% if post.author_feedback_reply.present? %>
                  <div class="mt-3 max-w-xs rounded-md border border-sky-200 bg-sky-50 px-3 py-2">
                    <p class="text-[11px] font-semibold uppercase tracking-wide text-sky-700"><%= t("posts.show.feedback.author_reply") %></p>
                    <p class="mt-1 whitespace-pre-wrap text-xs text-sky-900"><%= post.author_feedback_reply %></p>
                    <% if post.author_replied_at.present? %>
                      <p class="mt-1 text-[11px] text-sky-700"><%= t("posts.show.feedback.updated_at", time: l(post.author_replied_at, format: :short)) %></p>
                    <% end %>
                  </div>
                <% elsif post.unverify_reason.present? %>
                  <%= form_with url: reply_feedback_post_path(post), method: :post, class: "mt-3 max-w-xs space-y-2" do %>
                    <div>
                      <%= label_tag "post_author_feedback_reply_#{post.id}", t("posts.show.feedback.reply_label"), class: "mb-1 block text-xs font-medium text-slate-700" %>
                      <%= text_area_tag "post[author_feedback_reply]", nil, id: "post_author_feedback_reply_#{post.id}", rows: 3, placeholder: t("posts.show.feedback.reply_placeholder"), required: true, class: "w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-xs text-slate-800 focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500" %>
                    </div>
                    <%= button_tag t("posts.show.feedback.send_reply"), type: "submit", class: "inline-flex items-center rounded-md border border-sky-600 bg-sky-600 px-3 py-1.5 text-xs font-semibold text-white hover:bg-sky-700" %>
                  <% end %>
                <% end %>
              </td>
              <td class="px-4 py-4 align-top text-sm">
                <% if revision.present? %>
                  <% revision_classes = revision.pending_review? ? "bg-amber-100 text-amber-700" : (revision.draft? ? "bg-indigo-100 text-indigo-700" : (revision.approved? ? "bg-emerald-100 text-emerald-700" : "bg-rose-100 text-rose-700")) %>
                  <span class="rounded-full px-2.5 py-1 text-xs font-semibold <%= revision_classes %>"><%= t("post_revisions.form.statuses.#{revision.moderation_status}") %></span>
                <% else %>
                  <span class="text-xs text-slate-500"><%= t("posts.mine.no_revision") %></span>
                <% end %>
              </td>
              <td class="px-4 py-4 align-top text-sm text-slate-600"><%= l(post.updated_at, format: :short) %></td>
              <td class="px-4 py-4 align-top text-right">
                <div class="flex flex-wrap justify-end gap-2">
                  <%= btn_link_to t("posts.mine.actions.view"), post_path(post), variant: :ghost %>
                  <% if post.draft? %>
                    <%= btn_link_to t("posts.actions.edit"), edit_post_path(post), variant: :secondary %>
                  <% elsif post.verified? %>
                    <%= btn_link_to t("posts.actions.edit_revision"), (revision.present? ? edit_post_revision_path(post) : new_post_revision_path(post)), variant: :secondary %>
                  <% else %>
                    <%= btn_link_to t("posts.actions.edit"), edit_post_path(post), variant: :secondary %>
                  <% end %>
                  <% if policy(post).destroy? %>
                    <%= btn_link_to t("posts.actions.delete"), post_path(post), method: :delete, variant: :danger, data: { confirm: t("posts.actions.confirm_delete") } %>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>

          <% if @posts.empty? %>
            <tr>
              <td colspan="5" class="px-4 py-8 text-center text-sm text-slate-500"><%= @query.present? ? t("posts.mine.no_results", query: @query) : t("posts.mine.empty") %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>

  <div class="mt-6">
    <%= paginate @posts %>
  </div>
</section>