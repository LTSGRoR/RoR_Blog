<% content_for :title, t("posts.mine.title") %>

<section class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8" data-controller="review-modal" data-action="keydown@window->review-modal#closeOnEscape">
  <%= turbo_stream_from "posts_mine_user_#{current_user.id}" %>

  <div class="overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-sm">
    <div class="h-1.5 bg-gradient-to-r from-[#9e0000] via-[#cc0000] to-[#820000]"></div>
    <div class="bg-[radial-gradient(circle_at_top_left,rgba(255,0,0,0.08),transparent_34%),linear-gradient(180deg,#fff8f8_0%,#f8fafc_68%,#f8fafc_100%)] p-6 sm:p-8">
    <div class="flex flex-col items-start gap-4 sm:flex-row sm:items-start sm:justify-between">
      <div class="min-w-0">
        <h1 class="text-3xl font-bold tracking-tight text-slate-900"><%= t("posts.mine.title") %></h1>
        <p class="mt-2 max-w-2xl text-sm text-slate-600"><%= t("posts.mine.subtitle") %></p>
      </div>
      <%= btn_link_to t("posts.index.new_post"), new_post_path, variant: :primary %>
    </div>

    <div class="mt-6 grid grid-cols-1 gap-3 sm:grid-cols-3">
      <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm ring-1 ring-slate-100">
        <p class="text-xs font-medium uppercase tracking-[0.18em] text-slate-500"><%= t("posts.mine.stats.drafts") %></p>
        <p class="mt-2 text-2xl font-semibold text-slate-900"><%= @draft_posts_count %></p>
      </div>
      <div class="rounded-2xl border border-amber-200 bg-amber-50 p-4 shadow-sm ring-1 ring-amber-100">
        <p class="text-xs font-medium uppercase tracking-[0.18em] text-amber-700"><%= t("posts.mine.stats.needs_review") %></p>
        <p class="mt-2 text-2xl font-semibold text-amber-800"><%= @needs_review_posts_count %></p>
      </div>
      <div class="rounded-2xl border border-emerald-200 bg-emerald-50 p-4 shadow-sm ring-1 ring-emerald-100">
        <p class="text-xs font-medium uppercase tracking-[0.18em] text-emerald-700"><%= t("posts.mine.stats.published") %></p>
        <p class="mt-2 text-2xl font-semibold text-emerald-800"><%= @published_posts_count %></p>
      </div>
    </div>

    <%= form_with url: mine_posts_path, method: :get, local: true, class: "mt-4 flex flex-col gap-2 sm:flex-row sm:flex-wrap sm:items-center" do |f| %>
      <%= f.hidden_field :filter, value: @filter %>
      <%= f.search_field :q, value: @query, placeholder: t("posts.mine.search_placeholder"), class: "h-10 w-full min-w-0 rounded-xl border border-slate-300 bg-white px-3 text-xs text-slate-700 focus:border-[#9e0000] focus:outline-none focus:ring-1 focus:ring-[#9e0000] sm:w-80" %>
      <%= f.submit t("posts.mine.search"), class: "h-10 inline-flex items-center justify-center rounded-xl bg-slate-900 px-3 text-xs font-semibold text-white hover:bg-slate-800" %>
    <% end %>

    <div class="mt-3 flex flex-wrap items-center gap-2">
      <% { "all" => t("posts.mine.filters.all"), "draft" => t("posts.mine.filters.draft"), "awaiting" => t("posts.mine.filters.awaiting"), "published" => t("posts.mine.filters.published") }.each do |value, label| %>
        <%= link_to label, mine_posts_path(filter: value, q: @query), class: "rounded-full border px-3 py-1.5 text-xs font-semibold transition #{value == @filter ? 'border-[#9e0000] bg-[#9e0000] text-white shadow-sm' : 'border-slate-200 bg-white text-slate-600 hover:border-red-200 hover:text-[#9e0000]'}" %>
      <% end %>
    </div>
    </div>
  </div>

  <section class="mt-6 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
    <div class="border-b border-slate-200 px-4 py-4 sm:px-6">
      <div class="flex flex-wrap items-start justify-between gap-3">
        <div>
          <h2 class="text-lg font-semibold text-slate-900"><%= t("posts.mine.list.title") %></h2>
          <p class="mt-1 text-sm text-slate-600"><%= t("posts.mine.list.subtitle") %></p>
        </div>
        <%= btn_link_to t("posts.index.new_post"), new_post_path, variant: :primary, class: "h-9 px-3 text-xs" %>
      </div>
    </div>

    <div class="max-h-[60vh] overflow-auto overscroll-x-contain">
      <table class="min-w-[960px] w-full divide-y divide-slate-200 table-auto">
        <thead class="sticky top-0 z-10 bg-slate-50/95 backdrop-blur">
          <tr>
            <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500"><%= t("posts.mine.columns.post") %></th>
            <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500"><%= t("posts.mine.columns.visibility") %></th>
            <th class="px-2 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500"><%= t("posts.mine.columns.feedback") %></th>
            <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500"><%= t("posts.mine.columns.revision") %></th>
            <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500"><%= t("posts.mine.columns.updated") %></th>
            <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wide text-slate-500"><%= t("posts.mine.columns.actions") %></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 bg-white">
          <% @posts.each_with_index do |post, i| %>
            <% revision = post.active_revision %>
            <% has_feedback_modal = post.unverify_reason.present? || post.author_feedback_reply.present? %>
            <% can_delete_post = policy(post).destroy? %>
            <% action_layout = "grid grid-cols-2 gap-2" %>
            <% view_action_class = ui_action_button_classes(tone: :neutral, full_width: true, size: :xs) %>
            <% edit_action_class = ui_action_button_classes(tone: :approve, full_width: true, size: :xs) %>
            <% delete_action_class = ui_action_button_classes(tone: :reject, full_width: true, size: :xs) %>
            <tr class="<%= i.even? ? "bg-white" : "bg-slate-50/40" %> transition hover:bg-red-50/40">
              <td class="min-w-[100px] px-4 py-4 align-top">
                <p class="text-sm font-semibold text-slate-900 break-words"><%= link_to post.title, post_path(post), class: "hover:text-[#9e0000]" %></p>
                <% if post.tags.any? %>
                  <div class="mt-2 flex flex-wrap gap-1.5">
                    <% post.tags.each do |tag| %>
                      <span class="rounded-full bg-slate-100 px-2 py-0.5 text-[11px] font-medium text-slate-600"><%= tag.name %></span>
                    <% end %>
                  </div>
                <% end %>
              </td>
              <%= render "mine_visibility_cell", post: post %>
              <td class="min-w-[120px] px-2 py-4 align-top text-sm">
                <% if post.unverify_reason.present? || post.author_feedback_reply.present? %>
                  <div class="flex flex-wrap items-center gap-1.5">
                    <% if post.unverify_reason.present? %>
                      <span class="inline-flex whitespace-nowrap rounded-full bg-amber-100 px-2 py-0.5 text-[11px] font-semibold text-amber-800"><%= t("posts.mine.feedback.admin_feedback") %></span>
                    <% end %>
                    <% if post.author_feedback_reply.present? %>
                      <span class="inline-flex whitespace-nowrap rounded-full bg-sky-100 px-2 py-0.5 text-[11px] font-semibold text-sky-800"><%= t("posts.mine.feedback.author_replied") %></span>
                    <% end %>
                  </div>
                  <% if post.author_replied_at.present? %>
                    <p class="mt-1 text-[11px] text-slate-500"><%= t("posts.show.feedback.updated_at_html", time: localized_time_tag(post.author_replied_at)) %></p>
                  <% end %>
                <% else %>
                  <span class="text-xs text-slate-500"><%= t("posts.mine.feedback.none") %></span>
                <% end %>
              </td>
              <td class="min-w-[140px] px-4 py-4 align-top text-sm">
                <% if revision.present? %>
                  <% revision_classes = revision.pending_review? ? "bg-amber-100 text-amber-700" : (revision.draft? ? "bg-indigo-100 text-indigo-700" : (revision.approved? ? "bg-emerald-100 text-emerald-700" : "bg-rose-100 text-rose-700")) %>
                  <span class="inline-flex whitespace-nowrap rounded-full px-2.5 py-1 text-xs font-semibold <%= revision_classes %>"><%= t("post_revisions.form.statuses.#{revision.moderation_status}") %></span>
                <% else %>
                  <span class="text-xs text-slate-500"><%= t("posts.mine.no_revision") %></span>
                <% end %>
              </td>
              <%= render "mine_updated_cell", post: post %>
              <td class="min-w-[230px] px-4 py-4 align-top text-right">
                <div class="<%= action_layout %>">
                  <% if has_feedback_modal %>
                    <button
                      type="button"
                      class="<%= ui_action_button_classes(tone: :primary_red, full_width: true, size: :xs) %>"
                      data-action="review-modal#open"
                      data-review-modal-id-param="post-feedback-<%= post.id %>">
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 shrink-0 text-red-500 transition group-hover:text-red-700" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                        <path d="M2.5 5.75A2.25 2.25 0 014.75 3.5h10.5a2.25 2.25 0 012.25 2.25v6.5a2.25 2.25 0 01-2.25 2.25h-4.1l-2.8 2.24a.75.75 0 01-1.22-.586V14.5h-2.38A2.25 2.25 0 012.5 12.25v-6.5z" />
                      </svg>
                      <span class="inline-flex items-center leading-none"><%= t("posts.mine.actions.review") %></span>
                    </button>
                  <% end %>
                  <%= link_to post_path(post), class: view_action_class do %>
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 shrink-0 text-slate-500 transition group-hover:text-slate-700" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                      <path d="M10 3.5c-4.5 0-7.75 3.44-8.85 5.02a1.75 1.75 0 000 1.96C2.25 12.06 5.5 15.5 10 15.5s7.75-3.44 8.85-5.02a1.75 1.75 0 000-1.96C17.75 6.94 14.5 3.5 10 3.5zm0 9.5A4.75 4.75 0 1110 3.5a4.75 4.75 0 010 9.5zm0-2.5a2.25 2.25 0 100-4.5 2.25 2.25 0 000 4.5z" />
                    </svg>
                    <span class="inline-flex items-center leading-none"><%= t("posts.mine.actions.view") %></span>
                  <% end %>
                  <% if post.draft? %>
                    <%= link_to edit_post_path(post), class: edit_action_class do %>
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 shrink-0 text-emerald-500 transition group-hover:text-emerald-700" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                        <path d="M4 13.5V16h2.5l7.37-7.37-2.5-2.5L4 13.5zm10.71-6.79a1 1 0 000-1.42l-1.5-1.5a1 1 0 00-1.42 0l-1.17 1.17 2.5 2.5 1.59-1.59z" />
                      </svg>
                      <span class="inline-flex items-center leading-none"><%= t("posts.actions.edit") %></span>
                    <% end %>
                  <% elsif post.verified? %>
                    <%= link_to (revision.present? ? edit_post_revision_path(post) : new_post_revision_path(post)), class: edit_action_class do %>
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 shrink-0 text-emerald-500 transition group-hover:text-emerald-700" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                        <path d="M4 13.5V16h2.5l7.37-7.37-2.5-2.5L4 13.5zm10.71-6.79a1 1 0 000-1.42l-1.5-1.5a1 1 0 00-1.42 0l-1.17 1.17 2.5 2.5 1.59-1.59z" />
                      </svg>
                      <span class="inline-flex items-center leading-none"><%= t("posts.actions.edit_revision") %></span>
                    <% end %>
                  <% else %>
                    <%= link_to edit_post_path(post), class: edit_action_class do %>
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 shrink-0 text-emerald-500 transition group-hover:text-emerald-700" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                        <path d="M4 13.5V16h2.5l7.37-7.37-2.5-2.5L4 13.5zm10.71-6.79a1 1 0 000-1.42l-1.5-1.5a1 1 0 00-1.42 0l-1.17 1.17 2.5 2.5 1.59-1.59z" />
                      </svg>
                      <span class="inline-flex items-center leading-none"><%= t("posts.actions.edit") %></span>
                    <% end %>
                  <% end %>
                  <% if can_delete_post %>
                    <%= link_to post_path(post), class: delete_action_class, data: { turbo_method: :delete, turbo_confirm: t("posts.actions.confirm_delete") } do %>
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 shrink-0 text-rose-500 transition group-hover:text-rose-700" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                        <path fill-rule="evenodd" d="M6 4.75A1.75 1.75 0 017.75 3h4.5A1.75 1.75 0 0114 4.75V5h2.25a.75.75 0 010 1.5h-.56l-.63 8.17A2 2 0 0113.06 16H6.94a2 2 0 01-1.99-1.83L4.31 6.5h-.56a.75.75 0 010-1.5H6v-.25zM7.5 5h5v-.25a.25.25 0 00-.25-.25h-4.5a.25.25 0 00-.25.25V5zm.75 3a.75.75 0 00-1.5 0v4a.75.75 0 001.5 0V8zm4 0a.75.75 0 00-1.5 0v4a.75.75 0 001.5 0V8z" clip-rule="evenodd" />
                      </svg>
                      <span class="inline-flex items-center leading-none"><%= t("posts.actions.delete") %></span>
                    <% end %>
                  <% end %>
                </div>

                <% if has_feedback_modal %>
                  <div
                    class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-900/50 p-4"
                    data-review-modal-target="modal"
                    data-modal-id="post-feedback-<%= post.id %>"
                    data-action="click->review-modal#backdropClose">
                    <div class="w-full max-w-md overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-2xl text-left" role="dialog" aria-modal="true" aria-labelledby="post-feedback-modal-title-<%= post.id %>">
                      <div class="border-b border-slate-200 bg-slate-50 px-5 py-4">
                        <div>
                          <h3 id="post-feedback-modal-title-<%= post.id %>" class="text-base font-semibold text-slate-900"><%= t("posts.mine.actions.review") %></h3>
                          <p class="mt-1 text-xs text-slate-500"><%= post.title %></p>
                        </div>
                      </div>

                      <div class="max-h-[70vh] space-y-3 overflow-y-auto p-5">
                        <div class="space-y-2 rounded-md border border-slate-200 bg-slate-50 p-2.5">
                          <p class="text-[11px] font-semibold uppercase tracking-wide text-slate-600"><%= t("posts.mine.feedback.conversation") %></p>
                          <% if post.unverify_reason.present? %>
                            <div class="rounded-md border border-amber-200 bg-amber-50 px-3 py-2">
                              <p class="text-[11px] font-semibold uppercase tracking-wide text-amber-700"><%= t("posts.mine.feedback.admin_feedback") %></p>
                              <p class="mt-1 whitespace-pre-wrap text-xs text-amber-950"><%= post.unverify_reason %></p>
                            </div>
                          <% end %>
                          <% if post.author_feedback_reply.present? %>
                            <div class="rounded-md border border-sky-200 bg-sky-50 px-3 py-2">
                              <p class="text-[11px] font-semibold uppercase tracking-wide text-sky-700"><%= t("posts.show.feedback.author_reply") %></p>
                              <p class="mt-1 whitespace-pre-wrap text-xs text-sky-900"><%= post.author_feedback_reply %></p>
                              <% if post.author_replied_at.present? %>
                                <p class="mt-1 text-[11px] text-sky-700"><%= t("posts.show.feedback.updated_at_html", time: localized_time_tag(post.author_replied_at)) %></p>
                              <% end %>
                            </div>
                          <% end %>
                        </div>

                        <% if post.unverify_reason.present? && post.author_feedback_reply.blank? %>
                          <div class="space-y-2 rounded-lg border border-slate-200 p-3">
                            <%= form_with url: reply_feedback_post_path(post), method: :post, class: "space-y-2" do %>
                              <div>
                                <%= label_tag "post_author_feedback_reply_#{post.id}", t("posts.show.feedback.reply_label"), class: "mb-1 block text-xs font-medium text-slate-700" %>
                                <%= text_area_tag "post[author_feedback_reply]", nil, id: "post_author_feedback_reply_#{post.id}", rows: 3, placeholder: t("posts.show.feedback.reply_placeholder"), required: true, class: "w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-xs text-slate-800 focus:border-[#9e0000] focus:outline-none focus:ring-1 focus:ring-[#9e0000]" %>
                              </div>
                              <%= button_tag t("posts.show.feedback.send_reply"), type: :submit, class: ui_action_button_classes(tone: :primary_red, size: :xs) %>
                            <% end %>
                          </div>
                        <% end %>
                      </div>
                    </div>
                  </div>
                <% end %>
              </td>
            </tr>
          <% end %>

          <% if @posts.empty? %>
            <tr>
              <td colspan="6" class="px-4 py-8 text-center text-sm text-slate-500"><%= @query.present? ? t("posts.mine.no_results", query: @query) : t("posts.mine.empty") %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>

  <div class="mt-6">
    <%= paginate @posts %>
  </div>
</section>