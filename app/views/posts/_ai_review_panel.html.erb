<% reason = ai_review_reason_for(post) %>
<% ai_color = case post.ai_review_status
when "auto_approved" then "bg-emerald-100 text-emerald-700 border-emerald-200"
when "needs_admin_review" then "bg-amber-100 text-amber-700 border-amber-200"
when "failed" then "bg-rose-100 text-rose-700 border-rose-200"
when "in_progress" then "bg-sky-100 text-sky-700 border-sky-200"
else "bg-slate-100 text-slate-700 border-slate-200"
end %>

<section id="<%= dom_id(post, :ai_review_panel) %>" class="mt-5 rounded-lg border border-slate-200 bg-slate-50 p-4">
  <div class="flex flex-wrap items-center gap-2">
    <p class="text-xs font-semibold uppercase tracking-wide text-slate-600"><%= t("posts.show.ai_review.title") %></p>
    <span class="inline-flex whitespace-nowrap rounded-full border px-2.5 py-1 text-xs font-semibold <%= ai_color %>">
      <%= t("admin.posts.index.ai_statuses.#{post.ai_review_status}") %>
    </span>
  </div>

  <% if reason.present? %>
    <p class="mt-2 text-sm text-slate-700"><%= reason %></p>
  <% else %>
    <p class="mt-2 text-sm text-slate-500"><%= t("posts.show.ai_review.waiting") %></p>
  <% end %>

  <% if post.ai_confidence.present? || post.ai_risk_score.present? %>
    <div class="mt-2 flex flex-wrap gap-1.5">
      <% if post.ai_confidence.present? %>
        <span class="inline-flex whitespace-nowrap rounded-full border border-emerald-200 bg-emerald-50 px-2 py-0.5 text-[11px] font-medium text-emerald-700">
          <%= t("admin.posts.index.ai_confidence", value: ai_review_percentage(post.ai_confidence)) %>
        </span>
      <% end %>
      <% if post.ai_risk_score.present? %>
        <span class="inline-flex whitespace-nowrap rounded-full border border-amber-200 bg-amber-50 px-2 py-0.5 text-[11px] font-medium text-amber-700">
          <%= t("admin.posts.index.ai_risk", value: ai_review_percentage(post.ai_risk_score)) %>
        </span>
      <% end %>
    </div>
  <% end %>
</section>
