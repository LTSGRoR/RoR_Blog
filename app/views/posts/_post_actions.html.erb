<% show_read_more = local_assigns.fetch(:show_read_more, false) %>
<% show_back = local_assigns.fetch(:show_back, false) %>

<div class="flex flex-wrap items-center gap-3">
  <% if show_back %>
    <% back_fallback = user_signed_in? && current_user == post.user ? mine_posts_path : posts_path %>
    <% back_path = safe_back_path(
      back_fallback,
      blocked_patterns: [
        %r{/posts/\d+/edit\z},
        %r{/posts/\d+/revision/(?:new|edit)\z}
      ]
    ) %>
    <%= btn_link_to t("posts.actions.back_to_posts"), back_path, variant: :ghost %>
  <% end %>

  <% if show_read_more %>
    <%= btn_link_to t("posts.actions.read_more"), post_path(post), variant: :ghost %>
  <% end %>
</div>
