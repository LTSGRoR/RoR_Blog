<div class="max-w-4xl mx-auto py-10 px-4 sm:px-6 lg:px-8">
  <div class="flex items-center justify-between mb-8">
    <h1 class="text-3xl font-bold text-slate-800">All Posts</h1>
    <%= link_to 'New Post', new_post_path, class: 'inline-flex items-center px-4 py-2 bg-indigo-600 text-white rounded-md shadow hover:bg-indigo-700' %>
  </div>

  <div class="space-y-6">
    <% @posts.each do |post| %>
      <article class="bg-white shadow-sm rounded-lg p-6 flex items-start gap-4">
        <div class="flex-shrink-0">
          <% if post.user&.avatar&.attached? %>
            <%= image_tag post.user.avatar.variant(resize_to_fill: [48, 48]), class: "rounded-full w-12 h-12 object-cover border border-slate-300", alt: post.user.name %>
          <% else %>
            <%= image_tag "default_avatar.svg", class: "rounded-full w-12 h-12 object-cover border border-slate-300", alt: post.user&.name || 'Default avatar' %>
          <% end %>
        </div>
        <div class="flex-1 min-w-0 ml-4">
          <h2 class="text-xl font-semibold text-slate-800">
            <%= link_to post.title, post_path(post), class: 'hover:underline' %>
            <% if post.verified? %>
              <span class="ml-2 inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">Verified</span>
            <% else %>
              <span class="ml-2 inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">Unverified</span>
            <% end %>
          </h2>
          <div class="text-sm text-slate-500 mt-2">
            by <%= post.user&.name || 'Unknown' %> · <%= post.created_at.strftime('%b %d, %Y') %>
          </div>
            <div class="mt-4">
              <%= link_to 'Read more', post_path(post), class: 'text-indigo-600 hover:text-indigo-800' %>

              <% if user_signed_in? && post.user == current_user %>
                <span class="ml-4">
                  <%= link_to 'Edit', edit_post_path(post), class: 'text-sm text-slate-600 hover:text-slate-800 mr-3' %>
                  <%= link_to 'Delete', post_path(post), method: :delete, data: { confirm: 'Are you sure?' }, class: 'text-sm text-red-600 hover:text-red-800' %>
                </span>
              <% end %>

              <% if current_user&.admin? %>
                <span class="ml-4">
                  <% if post.verified? %>
                    <%= link_to 'Unverify', unverify_post_path(post), method: :post, data: { confirm: 'Unverify this post?' }, class: 'text-sm text-amber-600 hover:text-amber-800 mr-3' %>
                  <% else %>
                    <%= link_to 'Verify', verify_post_path(post), method: :post, data: { confirm: 'Verify this post?' }, class: 'text-sm text-green-600 hover:text-green-800 mr-3' %>
                  <% end %>
                </span>
              <% end %>
            </div>
        </div>
      </article>
    <% end %>
  </div>
</div>
