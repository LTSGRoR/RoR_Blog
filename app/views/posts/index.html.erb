<div class="max-w-4xl mx-auto py-8 px-4 sm:px-6 lg:px-8">
  <div class="flex flex-wrap items-center justify-between gap-3 mb-6">
    <h1 class="text-3xl font-bold text-slate-800"><%= t("posts.index.title") %></h1>
    <%= btn_link_to t("posts.index.new_post"), new_post_path, variant: :primary %>
  </div>

  <%= render 'shared/search_form' %>

  <div id="posts-results">
    <div class="space-y-6">
      <% @posts.each do |post| %>
      <article class="bg-white border border-slate-200 shadow-sm rounded-lg p-6 flex items-start gap-4">
        <div class="flex-shrink-0">
          <% if post.user&.avatar&.attached? %>
            <%= image_tag post.user.avatar.variant(resize_to_fill: [48, 48]), class: "rounded-full w-12 h-12 object-cover border border-slate-300", alt: post.user.name %>
          <% else %>
            <%= image_tag "default_avatar.svg", class: "rounded-full w-12 h-12 object-cover border border-slate-300", alt: post.user&.name || t("common.default_avatar") %>
          <% end %>
        </div>
        <div class="flex-1 min-w-0">
          <h2 class="text-xl font-semibold text-slate-800">
            <%= link_to post.title, post_path(post), class: 'hover:underline' %>
            <% if post.verified? %>
              <span class="ml-2 inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800"><%= t("posts.status.verified") %></span>
            <% else %>
              <span class="ml-2 inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800"><%= t("posts.status.unverified") %></span>
            <% end %>
          </h2>
          <div class="text-sm text-slate-500 mt-2">
            <%= t("posts.show.by") %> <%= post.user&.name || t("common.unknown") %> · <%= l(post.created_at, format: :short) %>
          </div>
          <% if post.tags.any? %>
            <div class="mt-2 flex flex-wrap gap-2">
              <% post.tags.each do |tag| %>
                <%= render "tag_chip", tag: tag %>
              <% end %>
            </div>
          <% end %>
          <div class="mt-4">
            <%= render "post_actions", post: post, show_read_more: true %>
          </div>
        </div>
      </article>
      <% end %>
    </div>
    <div class="mt-8">
      <%= paginate @posts %>
    </div>

    <% if @posts.respond_to?(:total_count) %>
      <% result_count = @posts.total_count %>
    <% else %>
      <% result_count = @posts.size %>
    <% end %>

    <% if params[:q].present? && result_count.to_i == 0 %>
      <div class="mt-4 text-center text-sm text-slate-600"><%= t("posts.index.no_results", query: params[:q]) %></div>
    <% end %>

  </div>
</div>
