<%= form_with(model: post, local: true) do |f| %>
  <% if post.errors.any? %>
    <div class="mb-4 text-red-600"><%= post.errors.full_messages.to_sentence %></div>
  <% end %>

  <div class="mb-4">
    <%= f.label :title, class: "block text-sm font-medium" %>
    <%= f.text_field :title, class: "mt-1 block w-full rounded border px-3 py-2" %>
  </div>

  <div class="mb-4">
    <%= f.label :body, class: "block text-sm font-medium" %>
    <%= f.rich_text_area :body, class: "mt-1 block w-full rounded border px-3 py-2" %>
  </div>

  <div class="mb-4">
    <%= f.label :status, class: "block text-sm font-medium" %>
    <%= f.select :status, Post.statuses.keys.map { |s| [s.humanize, s] }, {}, class: "mt-1 block w-full rounded border px-3 py-2" %>
  </div>

  <div class="flex items-center space-x-2">
    <%= f.submit class: "px-4 py-2 bg-indigo-600 text-white rounded" %>
    <%= link_to "Cancel", (post.persisted? ? post_path(post) : posts_path), class: "text-sm text-slate-600" %>
  </div>
<% end %>
