<%= form_with(model: post, local: true, class: "space-y-6 max-w-3xl bg-white p-6 sm:p-8 shadow-sm rounded-lg border border-slate-200") do |f| %>
  
  <% if post.errors.any? %>
    <div class="p-4 mb-6 rounded-lg bg-red-50 border-l-4 border-red-500">
      <div class="flex">
        <div class="flex-shrink-0">
          <svg class="h-5 w-5 text-red-400" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
          </svg>
        </div>
        <div class="ml-3">
          <h3 class="text-sm font-medium text-red-800">
            <%= t("errors.messages.not_saved", count: post.errors.count, resource: post.model_name.human.downcase) %>
          </h3>
          <div class="mt-2 text-sm text-red-700">
            <ul class="list-disc pl-5 space-y-1">
              <% post.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <div>
    <%= f.label :title, class: "block text-sm font-semibold text-slate-700" %>
    <div class="mt-1">
      <%= f.text_field :title, 
          placeholder: t("posts.form.title_placeholder"),
          class: "block w-full rounded-md border-slate-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm px-4 py-3 border" %>
    </div>
  </div>

  <div>
    <%= f.label :body, class: "block text-sm font-semibold text-slate-700" %>
    <div class="mt-1 prose-trix">
      <%= f.rich_text_area :body, 
          class: "block w-full rounded-md border-slate-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm min-h-[300px] border px-2" %>
    </div>
  </div>

  <div class="w-full sm:w-1/3">
    <%= f.label :status, class: "block text-sm font-semibold text-slate-700" %>
    <div class="mt-1">
      <%= f.select :status, 
          Post.statuses.keys.map { |s| [t("activerecord.attributes.post.statuses.#{s}"), s] }, 
          {}, 
          class: "block w-full rounded-md border-slate-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm px-3 py-2 border" %>
    </div>
  </div>

  <div data-controller="tag-input" class="mt-4">
    <%= f.label :tags, class: "block text-sm font-semibold text-slate-700" %>
    <div class="mt-1 relative">
      <input data-tag-input-target="input"
             data-action="input->tag-input#search keydown->tag-input#handleKeydown"
             name="post[tag_list]"
             type="text"
             placeholder="<%= t('posts.form.tags_placeholder') %>"
             autocomplete="off"
             class="block w-full rounded-md border-slate-300 shadow-sm sm:text-sm px-4 py-3 border focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500" />
      <div data-tag-input-target="list" class="absolute z-20 mt-2 max-h-72 w-full overflow-y-auto overflow-hidden rounded-lg border border-slate-200 bg-white/95 shadow-[0_18px_45px_rgba(15,23,42,0.14)] backdrop-blur empty:hidden"></div>
    </div>
    <div data-tag-input-target="chips" class="mt-2 flex flex-wrap items-center gap-2">
      <input type="hidden" name="post[tag_ids][]" value="" data-empty-tag-ids="true" />
      <% post.tags.each do |tag| %>
        <span data-tag-id="<%= tag.id %>" class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-indigo-100 text-indigo-800 border border-indigo-200">
          <%= tag.name %>
          <button type="button" data-action="click->tag-input#remove" data-tag-id="<%= tag.id %>" class="pl-1 text-sm leading-none text-indigo-400 hover:text-indigo-700" aria-label="<%= t('posts.form.remove_tag') %>">&times;</button>
        </span>
        <input type="hidden" name="post[tag_ids][]" value="<%= tag.id %>" data-tag-id="<%= tag.id %>" />
      <% end %>
    </div>
  </div>

  <div class="flex flex-col-reverse gap-3 border-t border-slate-100 pt-4 sm:flex-row sm:items-center sm:justify-end">
    <% cancel_fallback = post.persisted? ? mine_posts_path : posts_path %>
    <%= link_to t("posts.form.cancel"), safe_back_path(cancel_fallback), 
        class: "w-full text-center text-sm font-medium text-slate-600 transition-colors hover:text-slate-800 sm:mr-4 sm:w-auto" %>
    
    <%= btn_submit f, variant: :primary, class: "w-full sm:w-auto" %>
  </div>

<% end %>
