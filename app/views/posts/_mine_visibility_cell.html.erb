<td id="<%= dom_id(post, :mine_visibility) %>" class="min-w-[120px] px-4 py-4 align-top text-sm">
  <% if post.draft? %>
    <span class="inline-flex whitespace-nowrap rounded-full bg-indigo-100 px-2.5 py-1 text-xs font-semibold text-indigo-700"><%= t("posts.mine.badges.draft") %></span>
  <% elsif post.verified? %>
    <span class="inline-flex whitespace-nowrap rounded-full bg-emerald-100 px-2.5 py-1 text-xs font-semibold text-emerald-700"><%= t("posts.mine.badges.published") %></span>
  <% elsif post.unverify_reason.present? %>
    <span class="inline-flex whitespace-nowrap rounded-full bg-rose-100 px-2.5 py-1 text-xs font-semibold text-rose-700"><%= t("posts.mine.badges.rejected") %></span>
  <% else %>
    <span class="inline-flex whitespace-nowrap rounded-full bg-amber-100 px-2.5 py-1 text-xs font-semibold text-amber-700"><%= t("posts.mine.badges.awaiting_review") %></span>
  <% end %>
</td>
