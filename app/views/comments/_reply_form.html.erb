<%# locals: (post:, parent_comment:, comment:, open: false) %>
<%= turbo_frame_tag dom_id(parent_comment, :reply_form) do %>
  <% if open %>
    <%= form_with model: [post, comment], class: "mt-2 space-y-2" do |f| %>
      <%= f.hidden_field :parent_id, value: parent_comment.id %>

      <% if comment.errors.any? %>
        <div class="rounded-md border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700">
          <%= comment.errors.full_messages.to_sentence %>
        </div>
      <% end %>

      <%= f.text_area :body, rows: 3, placeholder: "Write a reply…",
            class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500",
            required: true %>

      <div class="flex items-center gap-2">
        <%= f.submit "Post reply",
              class: "rounded-md bg-indigo-600 px-3 py-1.5 text-sm font-medium text-white hover:bg-indigo-500 cursor-pointer" %>
        <%= link_to "Cancel",
              reply_post_comment_path(post, parent_comment, cancel: true),
              data: { turbo_frame: dom_id(parent_comment, :reply_form) },
              class: "text-sm text-slate-500 hover:text-slate-700" %>
      </div>
    <% end %>
  <% else %>
    <% if user_signed_in? %>
      <%= link_to "Reply",
            reply_post_comment_path(post, parent_comment),
            data: { turbo_frame: dom_id(parent_comment, :reply_form) },
            class: "text-xs font-medium text-indigo-600 hover:text-indigo-500" %>
    <% end %>
  <% end %>
<% end %>
