<% replies_page = local_assigns.fetch(:replies_page, 1) %>
<% ordered_replies = comment.replies.order(created_at: :asc, id: :asc)
     .includes(:post, :parent, :reactions, user: { avatar_attachment: :blob })
     .offset((replies_page - 1) * Comment::REPLY_PAGE_SIZE).limit(Comment::REPLY_PAGE_SIZE + 1).to_a %>
<% has_more_replies = ordered_replies.size > Comment::REPLY_PAGE_SIZE %>
<% ordered_replies = ordered_replies.first(Comment::REPLY_PAGE_SIZE) %>
<%= turbo_frame_tag dom_id(comment, :replies) do %>
  <% if ordered_replies.any? %>
    <% if current_depth < visible_depth_limit %>
      <%= render "comments/replies",
            replies: ordered_replies,
            current_depth: current_depth + 1,
            visible_depth_limit: visible_depth_limit %>
      <% if has_more_replies %>
        <%= link_to "Next replies", replies_post_comment_path(comment.post, comment, replies_page: replies_page + 1), data: { turbo_frame: dom_id(comment, :replies) }, class: "text-xs font-medium text-indigo-600" %>
      <% end %>
      <% if replies_page > 1 %>
        <%= link_to "Previous replies", replies_post_comment_path(comment.post, comment, replies_page: replies_page - 1), data: { turbo_frame: dom_id(comment, :replies) }, class: "text-xs font-medium text-indigo-600" %>
      <% end %>
    <% else %>
      <div class="mt-4 pl-8 border-l-2 border-slate-100">
        <%= link_to "Load replies",
              replies_post_comment_path(
                comment.post,
                comment,
                depth: current_depth,
                visible_depth_limit: [ visible_depth_limit + 2, Comment::MAX_VISIBLE_REPLY_DEPTH ].min
              ),
              data: { turbo_frame: dom_id(comment, :replies) },
              class: "text-xs font-medium text-indigo-600 hover:text-indigo-500" %>
      </div>
    <% end %>
  <% end %>
<% end %>
