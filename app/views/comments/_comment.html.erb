<article id="<%= dom_id(comment) %>" class="rounded-lg border border-slate-200 bg-slate-50 p-4">
  <header class="mb-2 flex items-center justify-between gap-3">
    <p class="text-sm font-semibold text-slate-700"><%= comment.user.name.presence || comment.user.email %></p>
    <p class="text-xs text-slate-500"><%= l(comment.created_at, format: :short) %></p>
  </header>

  <p class="text-sm text-slate-800 whitespace-pre-wrap"><%= comment.body %></p>

  <%= render "reactions/bar", reactable: comment, compact: true %>
</article>
