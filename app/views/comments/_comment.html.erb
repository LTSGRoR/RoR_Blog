<% current_depth = local_assigns.fetch(:current_depth, 0) %>
<% visible_depth_limit = local_assigns.fetch(:visible_depth_limit, Comment::DEFAULT_VISIBLE_REPLY_DEPTH) %>

<article id="<%= dom_id(comment) %>" class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
  <% if comment.hidden_by_account_restriction? %>
    <p class="text-sm italic text-slate-500"><%= t("comments.account_hidden") %></p>
  <% else %>
  <header class="mb-3 flex items-center gap-3">
    <% initials = (comment.user.name.presence || comment.user.email).to_s.first(2).upcase %>
    <% if comment.user.avatar.attached? %>
      <%# Serve through the representation endpoint (like every other avatar in
          the app) so variant generation happens off the page-render path. %>
      <%= image_tag comment.user.avatar.variant(resize_to_fill: [32, 32]), class: "h-8 w-8 shrink-0 rounded-full border border-slate-200 object-cover", alt: initials, width: 32, height: 32, loading: "lazy" %>
    <% else %>
      <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-indigo-100 text-xs font-semibold text-indigo-700" aria-hidden="true"><%= initials %></div>
    <% end %>
    <div class="flex min-w-0 flex-1 flex-col items-start gap-0.5 sm:flex-row sm:items-baseline sm:justify-between sm:gap-2">
      <p class="min-w-0 truncate text-sm font-semibold text-slate-800"><%= comment.user.name.presence || comment.user.email %></p>
      <p class="shrink-0 text-xs text-slate-400"><%= localized_time_tag(comment.created_at) %></p>
    </div>
  </header>

  <p class="pl-11 text-sm leading-relaxed text-slate-700 whitespace-pre-wrap"><%= comment.body %></p>

  <div class="pl-11">
    <%= render "reactions/bar", reactable: comment, compact: true %>
  </div>

  <div class="pl-11 mt-2">
    <%= render "comments/reply_form", post: comment.post, parent_comment: comment, comment: Comment.new, open: false %>
  </div>
  <% end %>

  <%= render "comments/replies_frame",
        comment: comment,
        current_depth: current_depth,
        visible_depth_limit: visible_depth_limit %>
</article>
